# HumanityOS node identity — copy to /opt/Humanity/node.env and edit.
#
# provision-vps.sh sources this file if present. Every value here has a default
# baked into the script (the canonical united-humanity.us instance), so you only
# set what differs. This file is the ENTIRE surface a self-hoster changes to run
# their own federated node: their domain, their branding, our software.
#
#   cp scripts/node.env.example /opt/Humanity/node.env
#   nano /opt/Humanity/node.env
#   bash /opt/Humanity/scripts/provision-vps.sh

# The domain this node serves. Its chat subdomain defaults to chat.<domain>.
HUMANITY_DOMAIN=shop.example.com

# Where Let's Encrypt sends expiry warnings.
HUMANITY_CERT_MAIL=you@example.com

# Optional: override the chat subdomain if it is not chat.<domain>.
# HUMANITY_CHAT_DOMAIN=talk.example.com

# Optional: extra names on the TLS cert (space-separated). Each MUST already
# point to this box in DNS or certbot fails the whole order.
# HUMANITY_CERT_EXTRA=www.shop.example.com
