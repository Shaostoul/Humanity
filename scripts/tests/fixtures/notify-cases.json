    { "name": "quiet hours, a reply, mentions excepted", "mention": true, "candidate": { "kind": "reply" }, "synced": { "quiet_mentions": true, "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 1380 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
