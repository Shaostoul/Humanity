{
  "_comment": "THE notification rule's shared cases (docs/design/notifications.md, section 4). The desktop app (src/notifications/tests.rs) and the website (scripts/tests/notify-rules-web.test.js) both run every case and must give the same answer. A case is `base` with each of its four parts merged over (a part's keys replace the base's; `local.mutes` and `local.levels` are replaced whole, and a `mutes` without `people` has none); a case marked `mention` has `mention_room` merged into its candidate first. Times are Unix seconds, `minute` is minutes after local midnight, a mute of 0 lasts until unmuted. `levels` maps `<server>|<room>` to all, mentions or nothing (absent: mentions). `expect.list` is whether the notice goes in the in-app list.",
  "base": {
    "candidate": { "kind": "dm", "from_me": false, "server": "https://a.example", "room": null, "conversation": "dm:k1", "sender": "Ben", "room_name": "", "text": "hi", "from_friend": false },
    "synced": { "dm": true, "mentions": true, "tasks": true, "quiet_start": null, "quiet_end": null, "loaded": true, "quiet_friends": false, "quiet_mentions": false },
    "local": { "desktop": true, "show": "name", "sound": true, "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": {} }, "levels": {} },
    "moment": { "now": 1000000, "minute": 600, "focused": false, "on_screen": false, "last_notice": null }
  },
  "mention_room": { "kind": "mention", "room": "general", "conversation": "general", "room_name": "general", "text": "hey @me" },
  "cases": [
    { "name": "a DM from someone else, app behind: notice and sound", "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "my own DM (another of my devices): never", "candidate": { "from_me": true }, "expect": { "why": "own_message", "toast": false, "sound": false, "list": false } },
    { "name": "a kind the data file does not have", "candidate": { "kind": "nope" }, "expect": { "why": "unknown_kind", "toast": false, "sound": false, "list": false } },
    { "name": "the server's switches have not arrived yet", "synced": { "loaded": false }, "expect": { "why": "not_loaded", "toast": false, "sound": false, "list": false } },
    { "name": "DM switch off", "synced": { "dm": false }, "expect": { "why": "kind_off", "toast": false, "sound": false, "list": false } },
    { "name": "a mention with the mentions switch off", "mention": true, "synced": { "mentions": false }, "expect": { "why": "kind_off", "toast": false, "sound": false, "list": false } },
    { "name": "a mention with only the DM switch off still notifies", "mention": true, "synced": { "dm": false }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "everything muted for a while: a DM too", "local": { "mutes": { "everything": 1003600, "servers": {}, "rooms": {}, "people": {} } }, "expect": { "why": "all_muted", "toast": false, "sound": false, "list": false } },
    { "name": "everything muted until unmuted", "local": { "mutes": { "everything": 0, "servers": {}, "rooms": {}, "people": {} } }, "expect": { "why": "all_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a mute of everything that has ended", "local": { "mutes": { "everything": 999999, "servers": {}, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a mention on a muted server", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 1003600 }, "rooms": {}, "people": {} } }, "expect": { "why": "server_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a mention on a server muted until unmuted", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {}, "people": {} } }, "expect": { "why": "server_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a DM through a muted server still notifies (a DM is a person, not the server)", "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a server mute that has ended", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 999000 }, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "another server muted", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://b.example": 0 }, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a mention in a muted room", "mention": true, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://a.example|general": 1003600 }, "people": {} } }, "expect": { "why": "room_muted", "toast": false, "sound": false, "list": false } },
    { "name": "the same room muted on another server", "mention": true, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://b.example|general": 0 }, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "quiet hours past midnight, late evening", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 1380 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false, "list": false } },
    { "name": "quiet hours past midnight, early morning", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 300 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false, "list": false } },
    { "name": "quiet hours past midnight, the day", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 600 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "quiet hours end on the minute they end", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 420 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "quiet hours in the old hour-only shape the website wrote", "synced": { "quiet_start": "22", "quiet_end": "7" }, "moment": { "minute": 1380 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false, "list": false } },
    { "name": "quiet hours with equal ends silence nothing", "synced": { "quiet_start": "08:00", "quiet_end": "08:00" }, "moment": { "minute": 480 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "quiet hours with only one end set silence nothing", "synced": { "quiet_start": "22:00", "quiet_end": null }, "moment": { "minute": 1380 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "quiet hours that do not read silence nothing", "synced": { "quiet_start": "late", "quiet_end": "07:00" }, "moment": { "minute": 300 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a muted server during quiet hours reports the mute (mutes are checked first)", "mention": true, "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {}, "people": {} } }, "moment": { "minute": 1380 }, "expect": { "why": "server_muted", "toast": false, "sound": false, "list": false } },
    { "name": "the window in front showing that very conversation", "moment": { "focused": true, "on_screen": true }, "expect": { "why": "on_screen", "toast": false, "sound": false, "list": false } },
    { "name": "the window in front, another conversation showing: the sound only", "moment": { "focused": true, "on_screen": false }, "expect": { "why": "notify", "toast": false, "sound": true, "list": true } },
    { "name": "that conversation showing but the window behind another program", "moment": { "focused": false, "on_screen": true }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a second line 3 seconds after the last notice", "moment": { "last_notice": 999997 }, "expect": { "why": "too_soon", "toast": false, "sound": false, "list": false } },
    { "name": "a line 5 seconds after the last notice", "moment": { "last_notice": 999995 }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "desktop notices and sound both off: the in-app list only", "local": { "desktop": false, "sound": false }, "expect": { "why": "notify", "toast": false, "sound": false, "list": true } },
    { "name": "desktop notices off: the sound only", "local": { "desktop": false }, "expect": { "why": "notify", "toast": false, "sound": true, "list": true } },
    { "name": "sound off, the window in front on another conversation: the in-app list only", "local": { "sound": false }, "moment": { "focused": true }, "expect": { "why": "notify", "toast": false, "sound": false, "list": true } },
    { "name": "my own mention in a muted room is still my own", "mention": true, "candidate": { "from_me": true }, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://a.example|general": 0 }, "people": {} } }, "expect": { "why": "own_message", "toast": false, "sound": false, "list": false } },
    { "name": "a kind with no switch is on with every switch off, and no server mute applies", "candidate": { "kind": "game_event", "room": null, "conversation": "game" }, "synced": { "dm": false, "mentions": false, "tasks": false }, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a DM in a muted conversation", "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k1": 1003600 } } }, "expect": { "why": "person_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a DM in a conversation muted until unmuted", "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k1": 0 } } }, "expect": { "why": "person_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a conversation mute that has ended", "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k1": 999999 } } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "another conversation muted", "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k2": 0 } } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a muted conversation does not mute a mention of you in a room", "mention": true, "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k1": 0 } } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "everything muted reports everything before the conversation", "local": { "mutes": { "everything": 0, "servers": {}, "rooms": {}, "people": { "dm:k1": 0 } } }, "expect": { "why": "all_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a muted server never mutes a conversation", "candidate": { "kind": "contact_request" }, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {}, "people": {} } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a contact request", "candidate": { "kind": "contact_request" }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a contact request with the DM switch off", "candidate": { "kind": "contact_request" }, "synced": { "dm": false }, "expect": { "why": "kind_off", "toast": false, "sound": false, "list": false } },
    { "name": "a contact request from a muted conversation", "candidate": { "kind": "contact_request" }, "local": { "mutes": { "everything": null, "servers": {}, "rooms": {}, "people": { "dm:k1": 0 } } }, "expect": { "why": "person_muted", "toast": false, "sound": false, "list": false } },
    { "name": "a reply to my line", "mention": true, "candidate": { "kind": "reply" }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "a reply with the mentions switch off", "mention": true, "candidate": { "kind": "reply" }, "synced": { "mentions": false }, "expect": { "why": "kind_off", "toast": false, "sound": false, "list": false } },
    { "name": "a reply in a muted room", "mention": true, "candidate": { "kind": "reply" }, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://a.example|general": 0 }, "people": {} } }, "expect": { "why": "room_muted", "toast": false, "sound": false, "list": false } },
    { "name": "an ordinary line in a room at the default level (mentions)", "mention": true, "candidate": { "kind": "room_line", "text": "hello all" }, "expect": { "why": "room_level", "toast": false, "sound": false, "list": false } },
    { "name": "an ordinary line in a room set to every line", "mention": true, "candidate": { "kind": "room_line", "text": "hello all" }, "local": { "levels": { "https://a.example|general": "all" } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
    { "name": "every line set for the same room on another server", "mention": true, "candidate": { "kind": "room_line" }, "local": { "levels": { "https://b.example|general": "all" } }, "expect": { "why": "room_level", "toast": false, "sound": false, "list": false } },
    { "name": "every line notifies with every synced switch off (it has none)", "mention": true, "candidate": { "kind": "room_line" }, "synced": { "dm": false, "mentions": false, "tasks": false }, "local": { "levels": { "https://a.example|general": "all" } }, "expect": { "why": "notify", "toast": true, "sound": true, "list": true } },
