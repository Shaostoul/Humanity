{
  "_comment": "THE notification rule's shared cases (docs/design/notifications.md, section 4). The desktop app (src/notifications/tests.rs) and the website (scripts/tests/notify-rules-web.test.js) both run every case and must give the same answer. A case is `base` with each of its four parts merged over (a part's keys replace the base's; `local.mutes` is replaced whole); a case marked `mention` has `mention_room` merged into its candidate first. Times are Unix seconds, `minute` is minutes after local midnight, a mute of 0 lasts until unmuted.",
  "base": {
    "candidate": { "kind": "dm", "from_me": false, "server": "https://a.example", "room": null, "conversation": "dm:k1", "sender": "Ben", "room_name": "", "text": "hi" },
    "synced": { "dm": true, "mentions": true, "tasks": true, "quiet_start": null, "quiet_end": null, "loaded": true },
    "local": { "desktop": true, "show": "name", "sound": true, "mutes": { "everything": null, "servers": {}, "rooms": {} } },
    "moment": { "now": 1000000, "minute": 600, "focused": false, "on_screen": false, "last_notice": null }
  },
  "mention_room": { "kind": "mention", "room": "general", "conversation": "general", "room_name": "general", "text": "hey @me" },
  "cases": [
    { "name": "a DM from someone else, app behind: notice and sound", "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "my own DM (another of my devices): never", "candidate": { "from_me": true }, "expect": { "why": "own_message", "toast": false, "sound": false } },
    { "name": "a kind the data file does not have", "candidate": { "kind": "nope" }, "expect": { "why": "unknown_kind", "toast": false, "sound": false } },
    { "name": "the server's switches have not arrived yet", "synced": { "loaded": false }, "expect": { "why": "not_loaded", "toast": false, "sound": false } },
    { "name": "DM switch off", "synced": { "dm": false }, "expect": { "why": "kind_off", "toast": false, "sound": false } },
    { "name": "a mention with the mentions switch off", "mention": true, "synced": { "mentions": false }, "expect": { "why": "kind_off", "toast": false, "sound": false } },
    { "name": "a mention with only the DM switch off still notifies", "mention": true, "synced": { "dm": false }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "everything muted for a while: a DM too", "local": { "mutes": { "everything": 1003600, "servers": {}, "rooms": {} } }, "expect": { "why": "all_muted", "toast": false, "sound": false } },
    { "name": "everything muted until unmuted", "local": { "mutes": { "everything": 0, "servers": {}, "rooms": {} } }, "expect": { "why": "all_muted", "toast": false, "sound": false } },
    { "name": "a mute of everything that has ended", "local": { "mutes": { "everything": 999999, "servers": {}, "rooms": {} } }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "a mention on a muted server", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 1003600 }, "rooms": {} } }, "expect": { "why": "server_muted", "toast": false, "sound": false } },
    { "name": "a mention on a server muted until unmuted", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {} } }, "expect": { "why": "server_muted", "toast": false, "sound": false } },
    { "name": "a DM through a muted server still notifies (a DM is a person, not the server)", "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {} } }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "a server mute that has ended", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 999000 }, "rooms": {} } }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "another server muted", "mention": true, "local": { "mutes": { "everything": null, "servers": { "https://b.example": 0 }, "rooms": {} } }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "a mention in a muted room", "mention": true, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://a.example|general": 1003600 } } }, "expect": { "why": "room_muted", "toast": false, "sound": false } },
    { "name": "the same room muted on another server", "mention": true, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://b.example|general": 0 } } }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "quiet hours past midnight, late evening", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 1380 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false } },
    { "name": "quiet hours past midnight, early morning", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 300 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false } },
    { "name": "quiet hours past midnight, the day", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 600 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "quiet hours end on the minute they end", "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 420 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "quiet hours in the old hour-only shape the website wrote", "synced": { "quiet_start": "22", "quiet_end": "7" }, "moment": { "minute": 1380 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false } },
    { "name": "quiet hours with equal ends silence nothing", "synced": { "quiet_start": "08:00", "quiet_end": "08:00" }, "moment": { "minute": 480 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "quiet hours with only one end set silence nothing", "synced": { "quiet_start": "22:00", "quiet_end": null }, "moment": { "minute": 1380 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "quiet hours that do not read silence nothing", "synced": { "quiet_start": "late", "quiet_end": "07:00" }, "moment": { "minute": 300 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "a muted server during quiet hours reports the mute (mutes are checked first)", "mention": true, "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 1380 }, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {} } }, "expect": { "why": "server_muted", "toast": false, "sound": false } },
    { "name": "the window in front showing that very conversation", "moment": { "focused": true, "on_screen": true }, "expect": { "why": "on_screen", "toast": false, "sound": false } },
    { "name": "the window in front, another conversation showing: the sound only", "moment": { "focused": true, "on_screen": false }, "expect": { "why": "notify", "toast": false, "sound": true } },
    { "name": "that conversation showing but the window behind another program", "moment": { "focused": false, "on_screen": true }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "a second line 3 seconds after the last notice", "moment": { "last_notice": 999997 }, "expect": { "why": "too_soon", "toast": false, "sound": false } },
    { "name": "a line 5 seconds after the last notice", "moment": { "last_notice": 999995 }, "expect": { "why": "notify", "toast": true, "sound": true } },
    { "name": "desktop notices and sound both off", "local": { "desktop": false, "sound": false }, "expect": { "why": "nothing_on", "toast": false, "sound": false } },
    { "name": "desktop notices off: the sound only", "local": { "desktop": false }, "expect": { "why": "notify", "toast": false, "sound": true } },
    { "name": "sound off, the window in front on another conversation: nothing", "local": { "sound": false }, "moment": { "focused": true }, "expect": { "why": "nothing_on", "toast": false, "sound": false } },
    { "name": "my own mention in a muted room is still my own", "mention": true, "candidate": { "from_me": true }, "local": { "mutes": { "everything": null, "servers": {}, "rooms": { "https://a.example|general": 0 } } }, "expect": { "why": "own_message", "toast": false, "sound": false } },
    { "name": "a kind with no switch is on with every switch off, and no server mute applies", "candidate": { "kind": "game_event", "room": null, "conversation": "game" }, "synced": { "dm": false, "mentions": false, "tasks": false }, "local": { "mutes": { "everything": null, "servers": { "https://a.example": 0 }, "rooms": {} } }, "expect": { "why": "notify", "toast": true, "sound": true } }
  ],
  "mentions": [
    { "text": "hello @Ben", "name": "Ben", "mentioned": true },
    { "text": "hello @ben!", "name": "Ben", "mentioned": true },
    { "text": "@BEN look", "name": "Ben", "mentioned": true },
