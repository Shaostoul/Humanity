    { "name": "quiet hours, a friend's DM, nothing excepted", "candidate": { "from_friend": true }, "synced": { "quiet_start": "22:00", "quiet_end": "07:00" }, "moment": { "minute": 1380 }, "expect": { "why": "quiet_hours", "toast": false, "sound": false, "list": false } },
