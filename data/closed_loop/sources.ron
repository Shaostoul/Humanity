            id: "sdg-2026-goal6",
            title: "The Sustainable Development Goals Extended Report 2026, Goal 6",
            by: "United Nations Statistics Division, storylines by the custodian agencies (FAO AQUASTAT for 6.4, UN-Habitat and WHO for 6.3.1)",
            url: "https://unstats.un.org/sdgs/report/2026/extended-report/Extended-Report-2026_Goal-6.pdf",
            published: "2026 (inputs as of 2026-04-30)",
