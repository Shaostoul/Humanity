        ),
        (
            id: "fao-fli",
            title: "SDG Indicators Data Portal: 12.3.1 Global food losses",
            by: "FAO",
            url: "https://www.fao.org/sustainable-development-goals-data-portal/data/indicators/1231-global-food-losses/en",
            published: "undated",
            read: "2026-10-23",
            kind: Primary,
            registry: Some("fao"),
            note: "Read the page text. The Food Loss Index covers losses after harvest up to, but not including, retail; waste at retail and in homes is UNEP's index (unep-fwi-2024).",
        ),
        (
            id: "unep-fwi-2024",
            title: "World squanders over 1 billion meals a day - UN report (press release for the Food Waste Index Report 2024)",
