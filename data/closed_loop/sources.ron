        // ---- EARTH: ENERGY, CARBON -------------------------------------------------
        (
            id: "ei-review-2026",
            title: "Statistical Review of World Energy 2026, 75th edition",
            by: "Energy Institute, with Ember, Kearney and KPMG",
            url: "https://www.energyinst.org/__data/assets/file/0004/1827616/Statistical-Review-of-World-Energy-PDF-Report.pdf",
            published: "2026",
            read: "2026-10-23",
            kind: Primary,
            registry: None,
            note: "Read the PDF text (raw extraction of pages 23 to 26 and 61 to 64): Total energy supply by fuel, supply per capita, electricity generation. ACCOUNTING: 'Energy from non-fossil fuel combustible electricity generation is accounted for on their input heat requirements and non-combustible renewables on the energy content of their gross electrical output.' So wind and solar count at the electricity they make; an accounting that credits them with the fuel they displace gives them a larger share. Press coverage gives its release as 30 June 2026 (dieselnet.com).",
        ),
        (
            id: "gcb-2025",
            title: "The Global Carbon Project releases the Global Carbon Budget 2025",
            by: "Global Carbon Project, Tsukuba International Office (NIES); the budget itself by Friedlingstein et al. in Earth System Science Data",
