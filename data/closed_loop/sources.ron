// Every source the closed-loop test cites (docs/design/closed-loop-test.md).
// Shape: schemas/closed_loop.toml. Cited by id from the other files here.
//
// HOW THESE WERE READ (2026-10-23). Each PDF was downloaded and its own text
// searched for the figure (pdftotext); each web page was fetched and its raw text
// searched. Page summaries were not used for any number (the 2026-09-27 lesson in
// the project's teaching-data note: summaries of two extension PDFs had invented
// figures). Where only a secondary account could be read, `kind` says Secondary
// and the figure that rests on it is marked Uncertain in its `check`.
//
// This is a reading of public sources, not an endorsement of any of them.
(
    sources: [
        // ---- THE PERSON ----------------------------------------------------------
        (
            id: "bvad-2022",
            title: "Life Support Baseline Values and Assumptions Document, NASA/TP-2015-218570/REV2",
            by: "Anderson, M.S., Ewert, M.K. and Keener, J.F. (eds.), NASA Johnson Space Center",
            url: "https://ntrs.nasa.gov/api/citations/20210024855/downloads/BVAD_2.15.22-final.pdf",
            published: "2022-02",
            read: "2026-10-23",
            kind: Primary,
            registry: Some("nasa-ntrs"),
            note: "Read: Table 3-31 (Summary of Nominal Human Metabolic Interface Values, an 82 kg crewmember, RQ 0.860, 12.778 MJ a day), Table 2-3 (mission options, including Opt 6 Multi-Generational and Opt 7 Permanent), Tables 4-20 and 4-21 (water use and wastewater by mission), section 4.1 leakage (0.02 kg/day/module), section 4.14 plant growth (lighting efficacy, biomass per kWh, crew access 25 to 50% of canopy). US federal work, public domain. data/life_support.ron already cites the same document for Tables 4-1, 4-90 and 4-91.",
        ),
        (
            id: "hanford-2004",
            title: "Advanced Life Support Baseline Values and Assumptions Document, NASA/CR-2004-208941",
            by: "Hanford, A.J. (ed.), NASA Johnson Space Center",
            url: "http://www.marsjournal.org/contents/2006/0005/files/Hanford2004B.pdf",
            published: "2004-08-16",
            read: "2026-09-26",
            kind: Primary,
            registry: Some("nasa-contractor-reports"),
            note: "Not re-read on 2026-10-23: its figures are quoted from data/life_support.ron, which read Table 3.3.6 (0.835 kg O2, 0.998 kg CO2 at 11.82 MJ, a 70 kg crewmember) and Table 7.3.2 (CDRA 860 W, TCCS 180 W). Kept because the game's people breathe on these numbers; the test checks them against bvad-2022.",
        ),
        (
            id: "enn-1997",
            title: "Summary of the revised joint WFP/UNHCR Guidelines for Estimating Food and Nutritional Needs in Emergencies, Field Exchange 3",
            by: "Emergency Nutrition Network (ENN), summarising WFP and UNHCR",
            url: "https://ennonline.net/fex/3/summary",
            published: "1997",
            read: "2026-10-23",
            kind: Secondary,
            registry: None,
            note: "Read the page text. The guidelines themselves (UNHCR-hosted PDF) refused a scripted download behind a robot check. The 2,100 kcal planning figure is the population-average requirement used for emergency rations, including children and older people, at light activity.",
        ),

        // ---- EARTH: POPULATION, FOOD, LAND -----------------------------------------
        (
            id: "wpp-2024",
            title: "World Population Prospects 2024: Summary of Results (advance unedited version)",
            by: "United Nations, Department of Economic and Social Affairs, Population Division",
            url: "https://desapublications.un.org/file/20622/download",
            published: "2024-07",
            read: "2026-10-23",
            kind: Primary,
            registry: None,
            note: "Read the PDF text, Key messages. No 2026 revision was found on 2026-10-23 (a search found only the 2024 edition and third parties projecting from it).",
        ),
        (
