            id: "cordell-2010",
            title: "The Story of Phosphorus: Sustainability implications of global phosphorus scarcity for food security (doctoral thesis), Linkoping Studies in Arts and Science No. 509",
            by: "Cordell, D., Linkoping University and the University of Technology, Sydney",
            url: "https://sswm.info/sites/default/files/reference_attachments/CORDELL%202010%20The%20Story%20of%20Phosphorus.pdf",
            published: "2010",
            read: "2026-10-23",
            kind: Primary,
            registry: Some("peer-reviewed-literature"),
            note: "Read the PDF text (raw extraction), Appendix A Table A-II, 'Global phosphorus flows data related to the food production and consumption system', in million tonnes of P a year: phosphate rock production 17.5, mineral fertilizer application 14, human defecation 3 ('1.2g/person/day (1-1.5g/person/day av)'), animal manure recycled 8, crop residues recycled 2, organic solid waste reused 0.2, sewage recycled 0.3 ('10% estimated, high variability'). Its note: 'baseline data is 2005 where possible, otherwise sourced from between 2000-2005.'",
        ),

