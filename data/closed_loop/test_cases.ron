// THE PHASE-2 TEST CASES. Each names its inputs, what it expects, the tolerance, what
// counts as a pass, how much compute and memory it may use, the real game systems it
// runs, and what has to exist first. Shape: schemas/closed_loop.toml; plan:
// docs/design/closed-loop-test.md section 8.
//
// THE RULE THAT SHAPES ALL OF THEM: the test runs the game's own systems (the life
// support, farming, plumbing, electrical and ship-power systems, the machines' meters),
// never a separate model of them. The larger scales (a village to all of humanity)
// cannot run every machine, so they run an aggregate tier whose per-person coefficients
// are MEASURED from the home runs (case aggregate_matches_home_at_n1 holds them to it),
// not typed in. A number in these files that the game computes differently is a finding
// for one or the other, never silently reconciled.
//
// `rule`: Within (|got - value| <= tolerance), AtLeast, AtMost, or Report (printed and
// recorded, no pass line yet, where nobody knows what right looks like).
(
    budget: (
        ci_total_cpu_s: 60.0,
        ci_total_memory_mb: 600.0,
        nightly_total_cpu_s: 1800.0,
        nightly_parallel_runs: 4,
        why: "CI cases (Unit, HomeDay, Aggregate, Calibration) run in `just verify` and must not slow it by more than a minute on one core; the existing shipped-homes test already simulates two game days of both homes in seconds. Nightly cases (HomeYear, Millennium) run at most four at a time, inside the share of the PC the operator keeps (scripts/pc-share-guard.ps1; headless-sim-runner.md section 'Several runs in parallel'). No GPU, no window, no audio, no network, no writes outside a scratch storage root.",
    ),
    cases: [
        // ---------------- UNIT: the data and the person ----------------
        (
            id: "every_closed_loop_figure_is_sourced", tier: Unit, mode: Both, sim_time: "none", step_s: 0.0,
            inputs: ["data/closed_loop/*.ron"],
            expect: [
                (metric: "figures without a source id that exists in sources.ron", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "sources without a read date", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "figures without a check", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "Research options without a readiness level", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "options at readiness (0, 0) that a scenario switches on", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
            ],
            pass: "All zero. Seen red first on a deliberate break (a figure citing a missing id).",
            budget: (cpu_s: 0.2, memory_mb: 20.0),
            uses: ["src/systems/closed_loop/data.rs (new)"],
            needs: ["the loader (phase 2, step 1)"],
        ),
        (
            id: "person_breathes_by_the_current_nasa_baseline", tier: Unit, mode: Both, sim_time: "none", step_s: 0.0,
            inputs: ["data/life_support.ron (Hanford 2004 coefficients)", "data/closed_loop/person.ron (BVAD 2022)"],
            expect: [
                (metric: "O2 at 12.778 MJ a day, from the game's LifeSupportData::breath", value: 0.895, tolerance: 0.009, unit: "kg/day", rule: Within),
                (metric: "CO2 at 12.778 MJ a day", value: 1.085, tolerance: 0.011, unit: "kg/day", rule: Within),
                (metric: "O2 at 2,100 kcal", value: 0.615, tolerance: 0.006, unit: "kg/day", rule: Within),
            ],
            pass: "Within 1%. Passes on today's data (the two NASA documents agree per MJ to 0.9%); fails if either drifts.",
            budget: (cpu_s: 0.01, memory_mb: 5.0),
            uses: ["src/systems/life_support.rs"],
            needs: ["the loader"],
        ),
        (
            id: "closure_is_never_one_number_by_mass", tier: Unit, mode: Both, sim_time: "one synthetic day", step_s: 0.0,
            inputs: ["a home ledger that recycles all water and air and imports all food"],
            expect: [
                (metric: "mass closure of the whole ledger", value: 0.991, tolerance: 0.005, unit: "fraction", rule: Within),
                (metric: "food loop closure", value: 0.0, tolerance: 0.0, unit: "fraction", rule: Within),
                (metric: "reports that print one aggregate closure without the per-loop table", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
            ],
            pass: "The reporter prints every loop separately; the 99.1% exists only beside the food loop's 0%.",
            budget: (cpu_s: 0.01, memory_mb: 5.0),
            uses: ["src/systems/closed_loop/report.rs (new)"],
            needs: ["the loader"],
        ),
        (
            id: "same_seed_same_bytes", tier: Unit, mode: Full, sim_time: "one game day", step_s: 6.0,
            inputs: ["the solo home, seed fixed"],
            expect: [(metric: "byte difference between two runs' ledgers", value: 0.0, tolerance: 0.0, unit: "bytes", rule: Within)],
            pass: "Identical output, or the closure numbers are not reproducible.",
            budget: (cpu_s: 4.0, memory_mb: 300.0),
            uses: ["src/systems/farming/life_support_tests.rs (shipped_home)"],
            needs: ["sim seeds (headless-sim-runner.md increment 2)"],
        ),

        // ---------------- HOME DAY: the real homes, today ----------------
        (
            id: "solo_home_closes_what_it_closes", tier: HomeDay, mode: Full, sim_time: "a game day to settle, a game day measured", step_s: 6.0,
            inputs: ["data/machines/home_solo.ron at full planting", "Realistic and Station-supplied modes"],
            expect: [
                (metric: "water returned by the air handlers / water put in the air", value: 1.0, tolerance: 0.01, unit: "fraction", rule: Within),
                (metric: "CO2 taken up by the crops / CO2 breathed out, settled day", value: 0.98, tolerance: 0.03, unit: "fraction", rule: AtLeast),
                (metric: "O2 given out by the crops / O2 breathed in", value: 0.88, tolerance: 0.0, unit: "fraction", rule: Report),
                (metric: "energy made at the home / energy used, Realistic", value: 0.14, tolerance: 0.02, unit: "fraction", rule: Within),
                (metric: "energy made at the home / energy used, Station-supplied", value: 0.51, tolerance: 0.05, unit: "fraction", rule: Within),
                (metric: "food grown / food needed (upper bound)", value: 0.81, tolerance: 0.05, unit: "fraction", rule: Within),
                (metric: "air leaked overboard", value: 0.60, tolerance: 0.05, unit: "kg/day", rule: Within),
            ],
            pass: "Every Within holds; the Reports are recorded beside docs/design/ship-life-support.md's tables. Expected values are that document's section 9 measurements and home_solo.ron's loops (1.86 to 1.92 of 1.96 kg CO2; 1.33 of 1.51 kg O2 on the 2026-09-27 day; 4.45 of 31.8 and 8.7 kWh; 1,780 of 2,200 kcal). A change in the game that moves one is a finding to write down, not a tolerance to widen.",
            budget: (cpu_s: 3.0, memory_mb: 300.0),
            uses: ["src/systems/farming/life_support_tests.rs (shipped_home, settle_home)", "src/systems/life_support.rs", "src/systems/farming/humidity.rs", "src/systems/grow_machines.rs", "src/machines.rs (utility_meters)", "src/systems/ship_power.rs"],
            needs: [],
        ),
        (
            id: "family_home_closes_what_it_closes", tier: HomeDay, mode: Full, sim_time: "a game day to settle, a game day measured", step_s: 6.0,
            inputs: ["data/machines/home.ron at full planting"],
            expect: [
                (metric: "water returned / put in the air", value: 1.0, tolerance: 0.01, unit: "fraction", rule: Within),
                (metric: "CO2 taken up / breathed out, settled near 670 ppm", value: 0.97, tolerance: 0.03, unit: "fraction", rule: AtLeast),
                (metric: "energy made / used, Realistic", value: 0.18, tolerance: 0.02, unit: "fraction", rule: Within),
            ],
            pass: "As the solo case; expected values from ship-life-support.md section 9 (4.98 of 5.89 kg on the measured day, 5.71 to 5.93 settled; 11.0 of 60.85 kWh).",
            budget: (cpu_s: 4.0, memory_mb: 400.0),
            uses: ["src/systems/farming/life_support_tests.rs", "src/systems/life_support.rs", "src/machines.rs"],
            needs: [],
        ),
        (
            id: "one_to_three_residents_per_person", tier: HomeDay, mode: Full, sim_time: "the two home days above", step_s: 6.0,
            inputs: ["the solo and family ledgers"],
            expect: [
                (metric: "food area per resident, family / solo", value: 1.0, tolerance: 0.0, unit: "ratio", rule: Report),
                (metric: "air handler energy per resident, family / solo", value: 0.53, tolerance: 0.0, unit: "ratio", rule: Report),
                (metric: "air leak per resident, family / solo (one hull, both homes 30 rooms)", value: 0.33, tolerance: 0.02, unit: "ratio", rule: Within),
            ],
            pass: "The per-resident ratios are printed with data/home_outline.json's scaling list beside them; the leak's 1/3 is exact because both homes have the same rooms. This is the first measurement of what does not scale linearly, at N = 1 and 3.",
            budget: (cpu_s: 0.1, memory_mb: 10.0),
            uses: ["the two cases above"],
            needs: [],
        ),
        (
            id: "time_to_harm_when_one_thing_fails", tier: HomeDay, mode: Full, sim_time: "until the first limit is crossed or 60 game days", step_s: 60.0,
            inputs: ["the solo home, settled", "one failure at a time: every crop dead; the air handlers off; the reactor tie off at night (Realistic); the CO2 scrubber off"],
            expect: [
                (metric: "crops dead: days until CO2 reaches the scrubber's 2,636 ppm", value: 22.0, tolerance: 11.0, unit: "days", rule: Within),
                (metric: "crops dead, scrubber running: CO2 held at or below", value: 2636.0, tolerance: 50.0, unit: "ppm", rule: AtMost),
                (metric: "crops dead: years of oxygen in the home's air", value: 13.0, tolerance: 0.0, unit: "years", rule: Report),
                (metric: "air handlers off: days until the cistern is empty", value: 24.0, tolerance: 0.0, unit: "days", rule: Report),
                (metric: "reactor tie off at night: the scrubber is the last load shed", value: 1.0, tolerance: 0.0, unit: "boolean", rule: Within),
            ],
            pass: "The failure margins table in docs/design/closed-loop-test.md section 3.5 is printed from the game, not from the design doc. The 22-day figure is this plan's hand estimate (resident 0.78 and tents 1.19 kg of CO2 a day into 11,160 m3); half to double it passes, outside that the estimate or the model is wrong.",
            budget: (cpu_s: 10.0, memory_mb: 300.0),
            uses: ["src/systems/life_support.rs", "src/systems/electrical.rs", "src/systems/ship_power.rs", "src/systems/plumbing"],
            needs: ["coarse steps validated by dt_ladder (or run at 6 s and accept the time)"],
        ),

        // ---------------- HOME YEAR: stocks and slow loops (needs the runner) ----------------
        (
            id: "solo_home_year", tier: HomeYear, mode: Full, sim_time: "one game year", step_s: 600.0,
            inputs: ["the solo home", "the safe step from dt_ladder_closure_is_step_invariant"],
            expect: [
                (metric: "O2 stock change in the home's air over the year", value: -88.0, tolerance: 18.0, unit: "kg", rule: Within),
                (metric: "phosphorus ledger: in - out - change in soil and stores", value: 0.0, tolerance: 0.001, unit: "fraction of throughput", rule: Within),
                (metric: "food grown over the year / needed (with the light the canopy really gets)", value: 0.0, tolerance: 0.0, unit: "fraction", rule: Report),
                (metric: "hidden sink: stock change minus ledgered flows, every gas", value: 0.0, tolerance: 0.01, unit: "fraction of stock", rule: AtMost),
            ],
            pass: "-88 kg is 0.24 kg a day (0.1 shortfall plus 0.14 in the leak, home_solo.ron) for 365 days, +/- 20%. The phosphorus ledger closes to 0.1%: the first time the game's nutrient loop is measured over a season, not asserted.",
            budget: (cpu_s: 120.0, memory_mb: 500.0),
            uses: ["the whole ECS SystemRunner through frame_sim::step", "src/systems/farming/soil.rs", "src/save_load.rs (catch_up_world for the away-versus-live check)"],
            needs: ["headless-sim-runner.md increment 2 (--sim soak, sim seeds)", "data/sim/step_tolerances.ron"],
        ),
        (
            id: "dt_ladder_closure_is_step_invariant", tier: HomeYear, mode: Full, sim_time: "seven game days at each step", step_s: 60.0,
            inputs: ["the solo home at steps of 60, 600 and 3,600 game seconds"],
            expect: [(metric: "largest difference in any loop's closure from the 60 s run", value: 0.0, tolerance: 0.01, unit: "fraction", rule: AtMost)],
            pass: "The largest step that stays within 1 point on every loop is the home's safe step for every closure case; it is printed in each report with its measured error.",
            budget: (cpu_s: 90.0, memory_mb: 500.0),
            uses: ["frame_sim::step"],
            needs: ["headless-sim-runner.md increment 2"],
        ),
        (
            id: "a_hidden_sink_is_found", tier: HomeYear, mode: Full, sim_time: "one game year", step_s: 600.0,
            inputs: ["the solo home with an unledgered oxygen sink of 1% of its stock a year injected (Biosphere 2's concrete, in miniature)"],
            expect: [(metric: "days until the stock-versus-ledger check reports it", value: 365.0, tolerance: 0.0, unit: "days", rule: AtMost)],
            pass: "Reported within the year. Seen red first: with the check off, the year passes silently.",
            budget: (cpu_s: 120.0, memory_mb: 500.0),
            uses: ["src/systems/life_support.rs", "src/systems/closed_loop/report.rs (new)"],
            needs: ["headless-sim-runner.md increment 2"],
        ),

        // ---------------- CALIBRATION AND AGGREGATE: from a home to humanity ----------------
        (
            id: "aggregate_matches_home_at_n1", tier: Calibration, mode: Both, sim_time: "one game day", step_s: 3600.0,
            inputs: ["per-person coefficients measured by solo_home_closes_what_it_closes", "the aggregate tier at N = 1"],
            expect: [(metric: "largest difference in any loop's ledger from the home run", value: 0.0, tolerance: 0.02, unit: "fraction", rule: AtMost)],
            pass: "Within 2% on every loop. The aggregate tier is a ledger per zone (population: u64, mothership-superstructure.md), and this case is what keeps it from becoming a second, drifting twin of the home systems (headless-sim-runner.md, risk 1).",
            budget: (cpu_s: 0.1, memory_mb: 20.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the aggregate tier (phase 2, step 4)"],
        ),
        (
            id: "earth_today_reproduces_the_measured_world", tier: Calibration, mode: Simplified, sim_time: "one year", step_s: 3.156e7,
            inputs: ["data/closed_loop/earth_today.ron"],
            expect: [
                (metric: "carbon taken back up / emitted, 2015 to 2024 (a period figure: filtered by its period, never by data_year)", value: 0.50, tolerance: 0.05, unit: "fraction", rule: Within),
                (metric: "carbon taken back up / emitted, 2024, emissions minus measured growth (the same value as carbon_uptake_is_measured_by_the_air)", value: 0.32, tolerance: 0.02, unit: "fraction", rule: Within),
                (metric: "energy from sustained flows / commercially traded supply", value: 0.086, tolerance: 0.005, unit: "fraction", rule: Within),
                (metric: "renewables / final consumption (SDG 7.2.1), printed beside the line above", value: 0.18, tolerance: 0.005, unit: "fraction", rule: Within),
                (metric: "phosphorus put on land that is recycled (2000 to 2005)", value: 0.43, tolerance: 0.02, unit: "fraction", rule: Within),
                (metric: "materials recycled / used", value: 0.069, tolerance: 0.005, unit: "fraction", rule: Within),
                (metric: "phosphate reserve life", value: 292.0, tolerance: 10.0, unit: "years", rule: Within),
                (metric: "freshwater withdrawal per person", value: 1343.0, tolerance: 50.0, unit: "L/day", rule: Within),
                (metric: "food supplied per person", value: 3016.0, tolerance: 50.0, unit: "kcal/day", rule: Within),
            ],
            pass: "The aggregate's arithmetic on sourced inputs gives the sourced outputs. This checks the model's bookkeeping, not the world: the world is in the figures.",
            budget: (cpu_s: 0.05, memory_mb: 10.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the aggregate tier"],
        ),
        (
            id: "population_ladder", tier: Aggregate, mode: Both, sim_time: "one year at each step", step_s: 86400.0,
            inputs: ["N = 1, 4, 150, 10,000, 1e6, 1e8, 8.2e9; Earth and ship"],
            expect: [
                (metric: "per-loop verdicts against population_steps.ron", value: 0.0, tolerance: 0.0, unit: "disagreements", rule: Report),
                (metric: "land for everyone on a bare-tier homestead", value: 2.62e9, tolerance: 0.33e9, unit: "ha", rule: Within),
                (metric: "the same, heated without a woodlot", value: 2.13e9, tolerance: 0.17e9, unit: "ha", rule: Within),
                (metric: "per-person trace contaminant energy, N = 4 / N = 1", value: 0.25, tolerance: 0.0, unit: "ratio", rule: Report),
            ],
            pass: "Every step's per-person budget and verdict is printed; a disagreement with population_steps.ron is a finding for the file or the model. 2.62e9 ha is 0.32 ha (the middle of 0.28 to 0.36) x 8.2 billion; 2.13e9 is 0.26 ha (0.24 to 0.28). The land figures come from homestead_land_is_the_sum_of_its_parts, not typed here.",
            budget: (cpu_s: 2.0, memory_mb: 100.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the aggregate tier", "Threshold industries (drift.ron) for the steps above a household"],
        ),
        (
            id: "mothership_with_todays_technology", tier: Aggregate, mode: Full, sim_time: "one year", step_s: 86400.0,
            inputs: ["data/closed_loop/mothership.ron", "only Today options"],
            expect: [
                (metric: "electricity per person (net, delivered)", value: 10.8, tolerance: 0.5, unit: "kW", rule: Within),
                (metric: "electricity, whole ship", value: 88.6, tolerance: 4.0, unit: "TW", rule: Within),
                (metric: "radiator per person, habitat AND reactor heat, at the reactor's net 20%", value: 67.2, tolerance: 3.4, unit: "m2", rule: Within),
                (metric: "the same at the reactor's stated 23.3%", value: 57.9, tolerance: 2.9, unit: "m2", rule: Within),
                (metric: "people the hull side's area of fin can carry, at net 20%", value: 2.34e9, tolerance: 0.15e9, unit: "people", rule: Within),
                (metric: "fission fuel at net 20%", value: 170200.0, tolerance: 8500.0, unit: "t/yr", rule: Within),
                (metric: "phosphorus make-up at an assumed 20% retention", value: 7.2e6, tolerance: 1.8e6, unit: "t/yr", rule: Within),
                (metric: "loops that do not close", value: 0.0, tolerance: 0.0, unit: "list", rule: Report),
            ],
            pass: "The per-person sum recomputed from the figures equals pp.total.power; once the aggregate is calibrated against the home runs, the home-measured coefficients replace the hand-derived ones and any difference is reported. THIS CASE CANNOT CATCH A WRONG INPUT on its own (it re-derives the same arithmetic): the cases marked INDEPENDENT ROUTE below check each of its load-bearing inputs another way, and this case passes only when they do. The unsourced 33% plant is a labelled scenario, never the point.",
            budget: (cpu_s: 1.0, memory_mb: 100.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the aggregate tier"],
        ),
        (
            id: "each_research_option_changes_only_what_it_says", tier: Aggregate, mode: Full, sim_time: "one year per option", step_s: 86400.0,
            inputs: ["mothership_with_todays_technology", "each technologies.ron option with `changes`, one at a time"],
            expect: [
                (metric: "fusion_dt: fuel carried per joule of heat / fission's fissioned per joule", value: 0.305, tolerance: 0.005, unit: "ratio", rule: Within),
                (metric: "fusion_dt: fuel carried per YEAR at its assumed 33% / fission's at net 20% (printed with the word 'assumed')", value: 0.185, tolerance: 0.01, unit: "ratio", rule: Report),
                (metric: "fusion_dt: habitat electricity per person changes by", value: 0.0, tolerance: 0.0, unit: "kW", rule: Within),
                (metric: "fusion_dt: reactor radiator per person", value: 0.0, tolerance: 0.0, unit: "m2", rule: Report),
                (metric: "led_at_limit: food electricity per person at 4.1 umol/J", value: 6.4, tolerance: 0.1, unit: "kW", rule: Within),
                (metric: "full_mineral_recycling: phosphorus make-up", value: 9000.0, tolerance: 2300.0, unit: "t/yr", rule: Within),
                (metric: "options at readiness (0, 0) accepted", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
            ],
            pass: "Switching an option on changes exactly its listed figures and nothing else; the printed table is the 'what matters most' ranking the design doc's section 7.3 argues for. 0.305 = 8.21e13 / 2.69e14 (fusion_energy_counts_both_reactions). The per-year ratio is Report, not a pass line: it sits 39% below the per-joule 0.305 at fission's net 20% (0.185; 29% below at the stated 23.3%, 0.216), and that gap is the assumed 33% fusion plant efficiency, not the fuel. The fusion reactor's radiator is Report: its plant efficiency is unproven.",
            budget: (cpu_s: 2.0, memory_mb: 100.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the aggregate tier"],
        ),
        (
            id: "simplified_mode_agrees_with_full", tier: Calibration, mode: Both, sim_time: "as the cases it compares", step_s: 0.0,
            inputs: ["solo_home_closes_what_it_closes, population_ladder and mothership_with_todays_technology, each run in both modes"],
            expect: [
                (metric: "loops whose verdict differs between modes", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "largest difference in a closure fraction", value: 0.0, tolerance: 0.10, unit: "fraction", rule: AtMost),
            ],
            pass: "The simplified mode may be coarser, never different in its answer: a loop that does not close in full realism does not close in the simplified mode either.",
            budget: (cpu_s: 5.0, memory_mb: 300.0),
            uses: ["all of the above"],
            needs: ["the aggregate tier"],
        ),

        // ---------------- INDEPENDENT ROUTES (added in the second review) ----------------
        //
        // An independent critic found that not one case above could have caught the
        // errors it found: the radiator case re-derived the same arithmetic without the
        // reactor term, and the others hard-coded the questioned values. Each case below
        // checks a load-bearing figure by a route that does NOT share its inputs: a law
        // of physics, a second source, a sum of parts, or another loop's ledger. Each
        // names the first-pass error it would have caught; phase 2 makes each one fail on
        // that error first (seen red), then pass on the corrected data.
        (
            id: "bvad_table_reading_balances", tier: Unit, mode: Both, sim_time: "none", step_s: 0.0,
            inputs: ["person.ron's reference figures, read from bvad-2022 Table 3-31"],
            expect: [
                (metric: "mass in (O2 + food solids + potable water + food water) minus mass out (CO2 + solids + water out)", value: 0.0, tolerance: 0.001, unit: "kg/day", rule: Within),
                (metric: "water in + metabolic water minus water out", value: 0.0, tolerance: 0.001, unit: "kg/day", rule: Within),
            ],
            pass: "The table's own mass balance closes to a gram. INDEPENDENT ROUTE: conservation of mass, not the values' labels; a value read against the wrong label (the layout prints each one a line above its label) breaks the balance.",
            budget: (cpu_s: 0.01, memory_mb: 5.0),
            uses: ["src/systems/closed_loop/data.rs (new)"],
            needs: ["the loader"],
        ),
        (
            id: "heat_engines_obey_carnot", tier: Unit, mode: Both, sim_time: "none", step_s: 0.0,
            inputs: ["every figure and per_person budget whose `thermo` field has efficiency_high, t_hot_k AND t_reject_k (today ship.energy.reactor_klt40s, pp.heat.reactor_radiator and pp.fuel.fission; pp.heat.habitat_radiator and pp.fuel.fusion_dt lack a hot side and are skipped, and listed as skipped)"],
            expect: [
                (metric: "budgets and figures with a full thermo field that were checked", value: 3.0, tolerance: 0.0, unit: "count", rule: AtLeast),
                (metric: "of those, efficiency_high above 1 - t_reject_k / t_hot_k", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "Today-tier budgets with a thermo field whose t_reject_k or t_hot_k differs from ship.energy.reactor_klt40s's", value: 0.0, tolerance: 0.0, unit: "count", rule: Within),
                (metric: "the KLT-40S's highest allowed condenser temperature at its stated 23.3% from a 589 K core", value: 452.0, tolerance: 2.0, unit: "K", rule: Within),
            ],
            pass: "No heat engine beats Carnot. INDEPENDENT ROUTE: the second law, from the reactor's own datasheet temperatures held in structured fields (not prose). It FAILS rather than passing vacuously if no thermo field is found (the AtLeast line). Would have caught the first pass's 'waste heat rejected at 600 K' at 33%: with a 589 K core the bound is negative.",
            budget: (cpu_s: 0.01, memory_mb: 5.0),
            uses: ["src/systems/closed_loop/aggregate.rs (new)"],
            needs: ["the loader, reading the thermo field (schemas/closed_loop.toml)"],
        ),
        (
            id: "radiators_carry_all_the_reactor_heat", tier: Aggregate, mode: Full, sim_time: "one year", step_s: 86400.0,
