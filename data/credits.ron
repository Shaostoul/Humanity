// Third-party sources HumanityOS uses, and what each one's licence obliges us
// to show. This is a DATA file, not a list in code: the set of sources grows
// forever, and several of these are legal obligations rather than courtesies.
//
// `notice` is the exact text shown to a user. Where a licence or a project
// specifies wording (OpenStreetMap and Gaia both do), copy it rather than
// paraphrasing.
//
// `shown_in` records WHERE the notice is actually surfaced, so an audit can
// tell at a glance whether an obligation is met rather than merely recorded
// here. "Credits" alone is enough for a source that only asks to be thanked;
// an attribution-REQUIRED source that renders content must also name the
// surface that renders it.
//
// Verify before adding a row. Every entry here was checked against the code
// that loads the data, not against memory: the star catalogue is ATHYG and
// Gaia, NOT Hipparcos, which is what a first draft of this file guessed.
(
    sources: [
        (
            id: "openstreetmap",
            name: "OpenStreetMap",
            used_for: "Real roads and building footprints for Earth regions (Silverdale and Seattle Center), drawn both as the Maps planet view and as 3D geometry you can walk through.",
            licence: "ODbL 1.0",
            notice: "Map data (c) OpenStreetMap contributors (ODbL)",
            url: "https://www.openstreetmap.org/copyright",
            attribution_required: true,
            // ODbL treats the RENDERED view and the SHIPPED DATA as two
            // separate obligations. The rendered view is a Produced Work and
            // needs a visible notice wherever it is displayed; the region
            // files under data/maps/regions/ are a Derivative Database and
            // must themselves be offered under ODbL. LICENSES.md covers the
            // second, these surfaces cover the first. The in-world credit has
            // its own layer since whole-Earth maps rung 1 (2026-11-09,
            // gui/map_credit.rs), so the HUD switching off in the construction
            // editor and the showroom no longer takes it away.
            shown_in: ["Maps planet view footer", "In-world map credit (in play, the construction editor and the showroom)", "Credits"],
        ),
        // NOAA ETOPO 2022, owed a row since the attribution audit of
        // 2026-09-06 (item 14). Earth's shipped heights
        // (data/planets/earth_heightmap.bin, the 0.05-degree grid built by
        // examples/build_earth_grid.rs from the 15 arc-second tiles), the
        // connected-ocean mask derived from them (earth_ocean_mask.bin), and
        // the optional 15 arc-second tile tier (terrain_tiles.rs). Licence,
        // NOAA's metadata read 2026-11-08 (docs/reference/findings/
        // 2026-11-08-whole-earth-map-data.md, finding 14): "NOAA waives any
        // potential copyright and related rights in these data worldwide
        // through the Creative Commons Zero 1.0 Universal Public Domain
        // Dedication (CC0-1.0)." Nothing is owed; it is credited by the house
        // rule, in the citation NOAA's product page asks for (read 2026-11-09,
        // https://www.ncei.noaa.gov/products/etopo-global-relief-model).
        (
            id: "noaa_etopo",
            name: "NOAA ETOPO 2022",
            used_for: "Earth's heights on land and under the sea: the shape of the whole planet's ground and seabed, and the map of which water is connected ocean.",
            licence: "CC0 1.0 (NOAA's public domain dedication)",
            notice: "NOAA National Centers for Environmental Information. 2022: ETOPO 2022 15 Arc-Second Global Relief Model. NOAA National Centers for Environmental Information. DOI: 10.25921/fd45-gt74",
            url: "https://www.ncei.noaa.gov/products/etopo-global-relief-model",
            attribution_required: false,
            shown_in: ["Credits"],
        ),
        // The two OSM regions' height surveys, data/maps/regions/*.dem.bin,
        // fetched once by scripts/fetch-region-dem.mjs from the AWS Open Data
        // "Terrain Tiles" (Mapzen / Tilezen, terrarium encoding). LICENSES.md
        // used to file them under OpenStreetMap, which they are not
        // (attribution audit 2026-09-06, item 10). For the two Puget Sound
        // regions the tiles are United States public-domain data (USGS
        // 3DEP/NED, NASA SRTM and NOAA bathymetry, as the script's header
        // records; not re-checked tile by tile). The tile
        // set's own guidance, read 2026-11-08 (the finding above, item 20),
        // says "Attribution is required for many terrain tile data providers";
        // its list for other countries includes two "All rights reserved"
        // sources, which is why this source is not used for the planet.
        (
            id: "aws_terrain_tiles",
            name: "AWS Open Data Terrain Tiles (Mapzen / Tilezen)",
            used_for: "Fine ground heights under the two real map regions, Silverdale and Seattle Center (about 13 m apart), so their shores slope the way the real ones do.",
            licence: "The underlying sources' terms; for these two regions United States public-domain data (USGS 3DEP/NED, NASA SRTM, NOAA)",
            notice: "Region heights: AWS Open Data Terrain Tiles (Mapzen / Tilezen), from USGS 3DEP, NASA SRTM and NOAA data",
            url: "https://registry.opendata.aws/terrain-tiles/",
            attribution_required: false,
            shown_in: ["Credits"],
        ),
        (
            id: "nasa_gibs",
            name: "NASA GIBS / Worldview",
            used_for: "Live global cloud-cover imagery (MODIS cloud fraction) placed on the real Earth.",
            licence: "Public domain (NASA open data)",
            notice: "Cloud imagery courtesy of NASA GIBS / Worldview",
            url: "https://worldview.earthdata.nasa.gov/",
            attribution_required: false,
            shown_in: ["Credits"],
        ),
        // The Maps page's asteroid belts (Maps increment 2, 2026-10-21). The MPC
        // asserts copyright in its data files and permits software to include
        // MPCORB on three conditions: its header shipped with the data (it is,
        // data/maps/MPCORB-header.txt), attribution to the MPC, and where to
        // get updated copies (both in the notice below and in the file). The
        // research, quoted and dated: docs/reference/findings/2026-10-21-mpc-orbit-data.md.
        (
            id: "mpc_mpcorb",
            name: "Minor Planet Center (MPCORB)",
            used_for: "The asteroid belts, the Hildas, Jupiter's trojans and the Kuiper belt on the Maps page: the real orbits of 20,000 minor planets (data/maps/belts.json, built by scripts/build-belts.js).",
            licence: "MPC data terms (the MPCORB header: software may include the data with its header, attribution and how to get updates)",
            notice: "Asteroid orbits: Minor Planet Center, International Astronomical Union (MPCORB, downloaded 2026-10-21). Updated copies: https://www.minorplanetcenter.org/iau/MPCORB/MPCORB.DAT",
            url: "https://minorplanetcenter.net/iau/MPCORB.html",
            attribution_required: true,
            shown_in: ["Maps solar system view (belts credit line)", "Web Maps page (belts credit line)", "Credits"],
        ),
        (
            id: "nasa_blue_marble",
            name: "NASA Blue Marble",
            used_for: "Earth's surface colour grid.",
            licence: "Public domain (NASA open data)",
            notice: "Earth surface imagery courtesy of NASA Blue Marble",
            url: "https://visibleearth.nasa.gov/collection/1484/blue-marble",
            attribution_required: false,
            shown_in: ["Credits"],
        ),
        // THREE star rows, because the app ships three catalogues and lets the
        // player choose between them in Settings > Sky (Standard / Extended /
        // Ultra), so that people on lesser hardware can pick a smaller one.
        // Until v0.1300 a single row labelled "athyg" claimed to be the
        // "standard ~120k catalogue", which is HYG. One row was doing the work
        // of three and naming the wrong dataset for the tier it described.
        //
        // The licence was recorded as the placeholder "See the ATHYG
        // repository" and CREDITS.md, LICENSES.md and maps-multi-scale.md each
        // gave a different answer. It is now pinned: astronexus publishes BOTH
        // HYG and ATHYG under CC BY-SA 4.0, verified by fetching the LICENSE
        // file from both repositories on 2026-09-07.
        //
        // CC BY-SA is SHARE-ALIKE, not merely attribution. data/stars.csv is
        // the HYG catalogue and data/stars.bin is built from it by
        // scripts/build-stars-bin.js, so both are adapted material and both
        // ship in every release. LICENSES.md carries the consequence.
        (
            id: "hyg",
            name: "HYG star database (astronexus)",
            used_for: "The Standard star catalogue (~120k stars) that ships with the app: positions, magnitudes and colours for the night sky. This is the tier every player sees by default.",
            licence: "CC BY-SA 4.0",
            notice: "Star data from the HYG database (astronexus), CC BY-SA 4.0",
            url: "https://github.com/astronexus/HYG-Database",
            attribution_required: true,
            shown_in: ["Credits"],
        ),
        (
            id: "athyg",
            name: "ATHYG star database (astronexus)",
            used_for: "The Extended star catalogue (~2.5M stars), an optional in-app download that renders the visible Milky Way star by star. HYG combined with the Tycho-2 catalogue.",
            licence: "CC BY-SA 4.0",
            notice: "Star data from the ATHYG database (astronexus), CC BY-SA 4.0",
            // The GitHub repository is archived; the project moved to Codeberg.
            url: "https://codeberg.org/astronexus/athyg",
            attribution_required: true,
            shown_in: ["Credits"],
        ),
        (
            id: "esa_gaia",
            name: "ESA Gaia",
            used_for: "The Ultra star catalogue (Gaia G<14, ~25M stars), an optional in-app download that resolves the full deep-sky census, and the integrated galaxy glow baked from it.",
            licence: "ESA Gaia data, freely available with acknowledgement",
            // Gaia asks for this specific acknowledgement. Keep the wording.
            notice: "This work has made use of data from the European Space Agency (ESA) mission Gaia (https://www.cosmos.esa.int/gaia), processed by the Gaia Data Processing and Analysis Consortium (DPAC, https://www.cosmos.esa.int/web/gaia/dpac/consortium).",
            url: "https://www.cosmos.esa.int/gaia",
            attribution_required: true,
            shown_in: ["Credits"],
        ),
        // The first 3D models that are not CC0 (2026-11-09). CC BY 4.0 makes the credit a condition:
        // failing it ends the licence until cured (section 6). Each converted model's folder also
        // carries NVIDIA's LICENSE.txt and a SOURCE.md listing its changes, and
        // assets/models/LICENSE-nvidia-simready.md lists every folder. The research, quoted and
        // dated: docs/reference/findings/2026-11-08-nvidia-simready-assets.md. NVIDIA requested no
        // wording, so this follows the licence's own list: creator, licence, link, modified.
        (
            id: "nvidia_simready",
            name: "NVIDIA SimReady Assets",
            used_for: "3D models of the home's furniture, fixtures, tools and safety gear (assets/models/simready/), and of the Medical Bay (a downloadable pack), each converted from OpenUSD to glTF, simplified and baked by HumanityOS, with its physics data.",
            licence: "CC BY 4.0",
            notice: "3D models based on NVIDIA SimReady Assets, by NVIDIA, licensed under CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/); converted and modified by HumanityOS",
            url: "https://huggingface.co/datasets/nvidia/simready-assets",
            attribution_required: true,
            // The walk-up card of an object drawn with one of these models carries a one-line credit
            // (engine/home_meshes.rs, the `credit` stat, words model_physics.credit_simready).
            shown_in: ["Credits", "Machine walk-up card (model credit line)"],
        ),
    ],
)
