        ),
        (
            id: "fan_greenhouse_4",
            machine: "circulation_fan",
            room: "room-greenhouse-part-2",
            offset: (11.3, 2.0, 13.5),
            rotation: 90.0,
            zone: "home",
        ),
        // The orchard's breeze: a fan line across the plot, one every 4.5 m (the clip-on grow fan stands in for a fan sized for it).
        (
            id: "fan_orchard_1",
            machine: "circulation_fan",
            room: "room-orchard-part-2",
            offset: (18.4, 2.0, 1.0),
            rotation: 90.0,
            zone: "home",
        ),
        (
            id: "fan_orchard_2",
            machine: "circulation_fan",
            room: "room-orchard-part-2",
            offset: (18.4, 2.0, 5.5),
            rotation: 90.0,
            zone: "home",
        ),
        (
            id: "fan_orchard_3",
            machine: "circulation_fan",
            room: "room-orchard-part-2",
            offset: (18.4, 2.0, 10.0),
            rotation: 90.0,
            zone: "home",
        ),
        (
            id: "fan_orchard_4",
            machine: "circulation_fan",
            room: "room-orchard-part-2",
            offset: (18.4, 2.0, 14.5),
            rotation: 90.0,
            zone: "home",
        ),
        (
            id: "fan_orchard_5",
            machine: "circulation_fan",
            room: "room-orchard-part-2",
