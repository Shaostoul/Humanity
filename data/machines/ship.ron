        "tent_co2_fan": (
            shape: "box",
            size: (0.303, 0.188, 0.176),
            color: (0.62, 0.64, 0.66),
            label: "Tent CO2 fan (mushroom rack)",
            category: "Food",
            // A 4 inch inline fan (AC Infinity CLOUDLINE S4: "Airflow" "226 CFM"
            // = 384 m3/h, "Max Power Draw" "28 W", 30.3 x 18.8 x 17.6 cm, with
            // "backup memory that retains the last speed setting whenever power is
            // cut off", so it runs at its set speed whenever its outlet is on),
            // switched by an AC Infinity CO2 controller (AC-CTC7: "2" outlets,
            // "0 - 10,000 PPM"). It sits on top of a mushroom rack inside its
            // fruiting tent and draws the room's air through the tent while the
            // tent holds more than 900 ppm of carbon dioxide: on for the share of
            // the time that holds it there, off below, drawing its 28 W for that
            // share (data/garden/humidity.ron, THE CO2 FANS).
            // 900 ppm is a GAME CHOICE, 100 under the 1,000 the oysters fruit
            // under (Lin 2022; Won 2010's best yield), and not the 800 Cornell's
            // growers keep oysters below: measured in the family home (the model,
            // docs/design/ship-life-support.md), holding 800 draws more air than
            // the tent's small humidifier can wet, and the tents fall to 81 to 89%
            // humidity with it flat out; at 900 they hold 90.0%. (The one-person
            // home's two racks could hold 800.)
            ventilation_m3_h: 384.0,
            co2_setpoint_ppm: 900.0,
            stats: [
                (
                    kind: "power",
                    value: "28 W while on, on part of the time",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds a mushroom rack's tent under 900 ppm of CO2",
                    status: "ok",
                ),
            ],
            // average_watts (2026-09-27): the power meter's estimate for a day
            // until it has run one (then what it drew, src/systems/day_energy.rs),
            // about 1.7 W a tent, on about 6% of the time, measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(
                watts: 28.0,
                priority: 4,
                average_watts: Some(1.7),
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "tent_humidifier": (
            shape: "box",
            size: (0.172, 0.357, 0.172),
            color: (0.9, 0.9, 0.88),
            label: "Tent humidifier (mushroom rack)",
            category: "Food",
            // A small ultrasonic grow-tent humidifier with a humidity
            // controller (AC Infinity CLOUDFORGE T3: "Output Rate: 8.11 fl
