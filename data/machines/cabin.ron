// HumanityOS machine layout: the CABIN's household (ship homes increment 6,
// docs/design/ship-homes-increment-6-plan.md section 3.2). Same format as data/machines/home.ron.
// Chosen by the Cabin start's one household (data/homes/starts.ron), loaded by
// `crate::machines::home_ron_path()` when the live save's start is a cabin.
//
// One person in one room of 3.15 x 2.5 m (data/homes/shipped/cabin.ron): a single bed along the
// north wall, a nightstand at its head, a wardrobe (the locker) and a desk with its chair on the
// south wall, and a wall screen on the east wall over the bed's foot and the desk. No power rows
// and no loops: the cabin is on the ship's supply, its meals come from the mess hall and its
// water from the ship, so nothing at home can break or die.
//
// Positions are home-local metres from the cabin's own corner (x east, z south; the door is in
// the west wall's middle, x 0, z 1.25), each machine's centre. The steel shell is 0.06 m thick,
// centred on the box edge, so the inside runs from 0.03 to 3.12 (x) and 0.03 to 2.47 (z).
//
// `ship_machines` merges the ship's rows (data/machines/ship.ron) in when this file loads, so a
// cabin player sees the Commons' garden, its trading posts, the mess halls' tables and serving
// counters and the recreation room. The catalog holds the types this file uses that ship.ron
// does not define (ship.ron defines the chair and the wall screen, and every type its own rows
// use, and the merge brings them in; an editor save of this file leaves them out the same way),
// each copied byte for byte from data/machines/home.ron, except `bed_single`, which is new.
//
// Rotation: 0 puts a machine's front toward north (-z), 90 toward west, 180 toward south,
// 270 toward east, the convention home.ron's desks and chairs follow.

(
    ship_machines: Some("ship.ron"),
    catalog: {
        // A single bed (2026-10-12): a 90 x 200 cm mattress, the cabin's one bed. E sleeps the
        // night here, as at the family home's bed (`provides: Some("rest")`). Drawn as its box:
        // the furniture models on disk hold only a double bed, which is never squeezed to fit.
        // assets/models/furniture.blend holds a twin bed (Frame, Mattress and Covers .Box.Twin)
        // to export through docs/dev/adding-3d-models.md.
        "bed_single": (
            shape: "box",
            size: (2.00, 0.50, 0.90),
            color: (0.42, 0.44, 0.50),
            label: "Single bed",
            category: "Furniture",
            stats: [
                (
                    kind: "storage",
                    value: "sleep here",
                    status: "ok",
                ),
            ],
            provides: Some("rest"),
            power: None,
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "nightstand": (
            shape: "box",
            size: (0.50, 0.55, 0.40),
            color: (0.52, 0.38, 0.24),
            label: "Nightstand",
            category: "Furniture",
            stats: [
                (
                    kind: "storage",
                    value: "small drawer",
                    status: "ok",
                ),
            ],
            power: None,
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: Some("furniture_drawer"),
            model: Some("assets/models/furniture/cabinetbeddrawertable/cabinetbeddrawertable.gltf"),
        ),
        "wardrobe": (
            shape: "box",
            size: (1.20, 2.00, 0.60),
            color: (0.52, 0.38, 0.24),
            label: "Wardrobe",
            category: "Furniture",
            stats: [
                (
                    kind: "storage",
                    value: "clothing",
                    status: "ok",
                ),
            ],
            power: None,
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: Some("wardrobe_cabinet"),
            model: Some("assets/models/furniture/bookcasecloseddoors/bookcasecloseddoors.gltf"),
        ),
        "desk": (
            shape: "box",
            size: (1.40, 0.75, 0.70),
            color: (0.52, 0.38, 0.24),
            label: "Desk",
            category: "Furniture",
            stats: [
                (
                    kind: "storage",
                    value: "work surface + drawer",
                    status: "ok",
                ),
            ],
            power: None,
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: Some("furniture_drawer"),
            model: Some("assets/models/furniture/desk/desk.gltf"),
        ),
    },
    instances: [
        // Along the north wall, its foot at the east wall, its head to the west by the nightstand.
        (
            id: "bed_single_1",
            machine: "bed_single",
            room: "room-cabin",
            offset: (2.12, 0.0, 0.48),
            rotation: 0.0,
            zone: "home",
        ),
        (
            id: "nightstand_1",
            machine: "nightstand",
            room: "room-cabin",
            offset: (0.85, 0.0, 0.23),
            rotation: 180.0,
            zone: "home",
        ),
        // The locker: the south wall's west end, clear of the door (z 0.8 to 1.7).
        (
            id: "wardrobe_1",
            machine: "wardrobe",
            room: "room-cabin",
            offset: (0.63, 0.0, 2.17),
            rotation: 0.0,
            zone: "home",
        ),
        // The desk on the south wall's east end, its chair facing it.
        (
            id: "desk_1",
            machine: "desk",
            room: "room-cabin",
            offset: (2.4, 0.0, 2.12),
            rotation: 0.0,
            zone: "home",
        ),
        (
            id: "chair_1",
            machine: "chair",
            room: "room-cabin",
            offset: (2.4, 0.0, 1.45),
            rotation: 180.0,
            zone: "home",
        ),
        // On the east wall, above the bed's foot and the desk, facing west into the room.
        (
            id: "wall_screen_1",
            machine: "wall_screen",
            room: "room-cabin",
            offset: (3.09, 1.2, 1.25),
            rotation: 90.0,
            zone: "home",
        ),
    ],
    connections: [],
)
