        "aeroponic_tower_apothecary": (
            shape: "cylinder",
            size: (0.16, 1.9, 0.16),
            color: (0.45, 0.55, 0.3),
            label: "Apothecary tower",
            category: "Food",
            stats: [
                (
                    kind: "nutrient",
                    value: "herbs + teas",
                    status: "ok",
                ),
                (
                    kind: "power",
                    value: "sun-lit; a 35 W pump on 5 minutes in every 50: 3.5 W averaged",
                    status: "ok",
                ),
            ],
            // Its pump (2026-09-27; it had none, so the meter charged it nothing while its stat
            // said -12 W). Tower Garden's standard submersible pump, the maker's own figures (read
            // 2026-09-27): "This pump is rated at 357 US GPH, 0.65 amps, 35 watts @120 VAC/60 Hz"
            // (https://us.towergarden.com/products/pump), switched by the maker's timer, "Select I
            // for Indoor use (5 min on, 45 min off)" (https://us.towergarden.com/products/tower-garden-timer).
            // The towers stand indoors, so it runs a tenth of the time: 3.5 W averaged over a day.
            // A tower has no power role (the electrical sim does not run its pump, home_spawn.rs),
            // so its port is what the static meter charges; the port therefore carries that
            // continuous-equivalent 3.5 W, the convention home_solo.ron's washer and water heater
            // already use, and the 35 W nameplate lives in the label and the stat.
            power: None,
            ports: [
                (
                    utility: Electricity,
                    dir: In,
                    label: "pump (35 W, on 5 min in 50: 3.5 W averaged)",
                    watts: 3.5,
                    flow_lpm: 0.0,
                    mbps: 0.0,
                    anchor: (0.0, 0.0, 0.0),
                ),
            ],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "aeroponic_tower_nutrition": (
            shape: "cylinder",
            size: (0.3, 2.4, 0.3),
            color: (0.3, 0.65, 0.38),
            label: "Variety tower",
            category: "Food",
            stats: [
                (
                    kind: "nutrient",
                    value: "vitamins + protein",
                    status: "ok",
                ),
                (
                    kind: "power",
                    value: "sun-lit; a 48 W pump on 5 minutes in every 50: 4.8 W averaged",
                    status: "ok",
                ),
            ],
            // Its pump (2026-09-27). The port was 15 W of "pump + light" for 24 hours, 0.36 kWh a
            // day a tower and 11.9 kWh for the 33 placed; the tower is sun-lit and has no light.
            // Tower Garden's high capacity submersible pump, the maker's own figures (read
            // 2026-09-27): "This pump is rated at 714 GPH, 0.43 amps, 48 watts @ 120 VAC/60 Hz"
            // (https://us.towergarden.com/products/pump-model-3-0). Which pump is a GAME CHOICE:
            // this tower is 2.4 m and 50 cups, taller than a standard Tower Garden, and its parts
            // list (data/towers/aeroponic_configs.ron) asks for a pump that lifts over 2.5 m, so it
            // gets the maker's larger pump (twice the standard 357 GPH, 35 W). The maker's timer:
            // "Select I for Indoor use (5 min on, 45 min off)"
            // (https://us.towergarden.com/products/tower-garden-timer), so it runs a tenth of the
            // time, 4.8 W averaged. A tower has no power role (the electrical sim does not run its
            // pump, home_spawn.rs), so its port is what the static meter charges; the port carries
            // that continuous-equivalent 4.8 W and the 48 W nameplate lives in the label and stat.
            power: None,
            ports: [
                (
                    utility: Electricity,
                    dir: In,
                    label: "pump (48 W, on 5 min in 50: 4.8 W averaged)",
                    watts: 4.8,
                    flow_lpm: 0.0,
                    mbps: 0.0,
                    anchor: (0.0, 0.0, 0.0),
                ),
            ],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
