                    kind: "display",
                    value: "camera, 70 degree lens, 10 pictures a second",
                    status: "ok",
                ),
            ],
            power: None,
            ports: [],
            storage: [],
            rf_emission: 0.0,
            auto_recipe: None,
            container_type: None,
            model: None,
            camera: Some((0.0, -8.0, 70.0)),
            camera_px: (640, 360),
        ),
