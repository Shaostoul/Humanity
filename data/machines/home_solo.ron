// The ONE-PERSON self-sufficient homestead (v0.653). Re-derivation of `home.ron` (the
// 3-person design) down to a single occupant, per the dedicated design pass in
// docs/design/homestead-solo-design.md (2026-07-01). Every quantity below traces to that
// doc's sizing math (Wh/day not nameplate watts, kcal/day per catalog stat, storage days =
// capacity / demand). The point of this file is pedagogical: establish the honest baseline
// for what ONE human needs to close energy/water/air/nutrients/~94% of food -- and by
// implication, what is left over (manufacturing, metallurgy, medicine, equipment renewal)
// that only a larger, trading civilization can supply. See homestead-solo-design.md section
// 8, "What this homestead cannot close the loop on," for that half of the lesson.
//
// Selected via Settings -> Data -> Home Design -> "Solo"; loaded by
// `crate::machines::home_ron_path()` in place of the default `home.ron`. Same catalog/
// instance/connection/loop shape as the family home -- just fewer units. Data-driven
// (infinite-of-X): edit here, no code.
(
    catalog: {
        "solar_panel": (
            shape: "box", size: (1.1, 0.12, 0.7), color: (0.12, 0.16, 0.45),
            label: "Solar panel",
            category: "Power",
            stats: [(kind: "power", value: "+1.1 kWh/d a year's average here, 0.5 in January", status: "ok")],
            // What a panel makes at the home's site (2026-09-27), the same machine and figures as
            // home.ron's solar_panel, whose comment quotes them: NREL PVWatts 8.5.0 for Silverdale,
            // WA (queried 2026-09-27), "ac_annual" 440.68 kWh a year for 0.4 kW at a 40 degree
            // tilt, and Tesla's Powerwall 2 "Round Trip Efficiency 90%": 440.68 x 0.90 / 8,760 h =
            // 45.3 W averaged, 1.09 kWh a day (the meter counted 400 W x 4.5 sun-hours, 1.8, and
            // this home's Energy loop 1.44 at a generic 4.5 sun-hours x 0.80).
            power: Some(Solar(peak_watts: 400.0, average_watts: Some(45.3))),
        ),
        "battery_bank": (
            shape: "box", size: (0.6, 0.9, 0.5), color: (0.20, 0.60, 0.32),
            label: "Battery bank",
            category: "Power",
            stats: [(kind: "storage", value: "~4 kWh", status: "ok"), (kind: "power", value: "charging", status: "ok")],
            power: Some(Battery(capacity_wh: 4000.0, max_charge_w: 2000.0, max_discharge_w: 2000.0)),
        ),
        "wind_turbine_small": (
            shape: "cylinder", size: (0.1, 2.4, 0.1), color: (0.85, 0.86, 0.90),
            label: "Wind turbine",
            category: "Power",
            stats: [(kind: "power", value: "+0.11 kWh/d here: the wind averages 2.4 m/s, under the 3.1 it starts at", status: "warn")],
            // What the turbine makes at the home's site (2026-09-27), the same machine and figures
            // as home.ron's wind_turbine_small, whose comment quotes them: Primus Wind Power's AIR
            // 40 ("Rated Power: 160 watts @ 28 mph (12.5 m/s)", "40 kWh/month @ 12 mph (5.5 m/s)")
            // in the Bremerton airport's 2.37 m/s average wind (WRCC, 1996-2006), a Rayleigh
            // distribution as AWEA 9.1-2009 rates small turbines: 4.4 W averaged, 0.11 kWh a day,
            // a 2.8% capacity factor (the meter counted 150 W for 24 hours, 3.6 kWh a day, and
            // this home's Energy loop +0.7). `watts` is that average (the electrical sim has no
            // wind model); the port keeps the 160 W nameplate, which sizes the cable.
            power: Some(Generator(watts: 4.4)),
            ports: [(utility: Electricity, dir: Out, label: "160 W at 12.5 m/s", watts: 160.0)],
        ),
        "exhaust_fan": (
            shape: "box",
            size: (0.45, 0.36, 0.31),
            color: (0.62, 0.64, 0.66),
            label: "Exhaust fan (humidity)",
            category: "Food",
            // A 12 inch EC inline exhaust fan with a humidity controller (AC
            // Infinity CLOUDLINE T12: "Total Airflow: 1604 CFM" = 2,725 m3/h,
            // "Max Power Draw: 250 W", 31.2 x 45.0 x 35.7 cm). While powered it
            // exchanges the air of the grow room it stands in with the home's,
            // as fast as it takes to hold the room at 80% humidity, drawing its
            // watts at the cube of its speed (data/garden/humidity.ron, which
            // also shows why the 3-person greenhouse needs one: its crops
            // breathe out more water than its leakage can carry away).
            ventilation_m3_h: 2725.0,
            stats: [
                (
                    kind: "power",
                    value: "~30 W holding a full greenhouse, 250 W flat out",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds the grow room at 80% humidity",
                    status: "ok",
                ),
            ],
            power: Some(Consumer(
                watts: 250.0,
                priority: 4,
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "humidifier": (
            shape: "box",
            size: (0.26, 0.52, 0.26),
            color: (0.9, 0.9, 0.88),
            label: "Humidifier (mushroom room)",
            category: "Food",
            // An ultrasonic grow-room humidifier with a humidity controller (AC
            // Infinity CLOUDFORGE T7: "Output Rate: 43.95 fl oz/h (1300 ml/h)",
            // "Power Consumption: 100 W", 26.0 x 26.0 x 52.1 cm, an "Automatic
            // water valve with tubing refills from an external water source").
            // While powered, and while the garden has water, it puts vapour
            // into the grow room it stands in, as much as holds the room at 90%
            // humidity (oyster mushrooms fruit at 85 to 95%), drawing its watts
            // in proportion to its output and its litres from the home's tanks
            // with the irrigation (data/garden/humidity.ron has the balance).
            // For a whole grow room; this home places none, because its two
            // mushroom racks fruit in tents (the tent humidifier below): held
            // whole, the room took this unit flat out (100 W, 2.4 kWh and 31 L
            // a day) and still settled near 88%.
            humidifies_l_h: 1.3,
            stats: [
                (
                    kind: "power",
                    value: "100 W flat out for a 300 m3 room",
                    status: "warn",
                ),
                (
                    kind: "water",
                    value: "~31 L a day from the tanks for a 300 m3 room",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds a grow room near 90% humidity",
                    status: "ok",
                ),
            ],
            power: Some(Consumer(
                watts: 100.0,
                priority: 4,
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "tent_humidifier": (
            shape: "box",
            size: (0.172, 0.357, 0.172),
            color: (0.9, 0.9, 0.88),
            label: "Tent humidifier (mushroom rack)",
            category: "Food",
            // A small ultrasonic grow-tent humidifier with a humidity
            // controller (AC Infinity CLOUDFORGE T3: "Output Rate: 8.11 fl
            // oz/h" = 240 ml/h, "Power Consumption: 24 W", a 4.5 L reservoir,
            // 17.2 x 17.2 x 35.7 cm). It stands on a mushroom rack's bottom
            // shelf inside the rack's fruiting tent and holds the tent at 90%,
            // drawing its watts in proportion to its output and its litres from
            // the home's tanks with the irrigation (data/garden/humidity.ron,
            // THE FRUITING TENT, has the balance).
            humidifies_l_h: 0.24,
            stats: [
                (
                    kind: "power",
                    value: "~17 W holding one rack's tent at 90% with its CO2 fan, 24 W flat out",
                    status: "ok",
                ),
                (
                    kind: "water",
                    value: "~4 L a day from the tanks",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds a mushroom rack's tent at 90% humidity",
                    status: "ok",
                ),
            ],
            // average_watts (2026-09-27): what the static power meter charges it
            // for a day, about 17 W a tent with the tents' CO2 fans running, measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(
                watts: 24.0,
                priority: 4,
                average_watts: Some(16.9),
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "tent_co2_fan": (
            shape: "box",
            size: (0.303, 0.188, 0.176),
            color: (0.62, 0.64, 0.66),
            label: "Tent CO2 fan (mushroom rack)",
            category: "Food",
            // A 4 inch inline fan (AC Infinity CLOUDLINE S4: "Airflow" "226 CFM"
            // = 384 m3/h, "Max Power Draw" "28 W", 30.3 x 18.8 x 17.6 cm, with
            // "backup memory that retains the last speed setting whenever power is
            // cut off", so it runs at its set speed whenever its outlet is on),
            // switched by an AC Infinity CO2 controller (AC-CTC7: "2" outlets,
            // "0 - 10,000 PPM"). It sits on top of a mushroom rack inside its
            // fruiting tent and draws the room's air through the tent while the
            // tent holds more than 900 ppm of carbon dioxide: on for the share of
            // the time that holds it there, off below, drawing its 28 W for that
            // share (data/garden/humidity.ron, THE CO2 FANS).
            // 900 ppm is a GAME CHOICE, 100 under the 1,000 the oysters fruit
            // under (Lin 2022; Won 2010's best yield), and not the 800 Cornell's
            // growers keep oysters below: measured in the family home (the model,
            // docs/design/ship-life-support.md), holding 800 draws more air than
            // the tent's small humidifier can wet, and the tents fall to 81 to 89%
            // humidity with it flat out; at 900 they hold 90.0%. (The one-person
            // home's two racks could hold 800.)
            ventilation_m3_h: 384.0,
            co2_setpoint_ppm: 900.0,
            stats: [
                (
                    kind: "power",
                    value: "28 W while on, on part of the time",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds a mushroom rack's tent under 900 ppm of CO2",
                    status: "ok",
                ),
            ],
            // average_watts (2026-09-27): what the static power meter charges it
            // for a day, about 1.5 W a tent, on about 5.5% of the time, measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(
                watts: 28.0,
                priority: 4,
                average_watts: Some(1.5),
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "room_co2_fan": (
            shape: "box",
            size: (0.32, 0.212, 0.2),
            color: (0.62, 0.64, 0.66),
            label: "Mushroom room CO2 fan",
            category: "Food",
            // A 6 inch inline fan (AC Infinity CLOUDLINE S6: "Airflow" "425 CFM"
            // = 722 m3/h, "Max Power Draw" "70 W", 21.2 x 32.0 x 20.0 cm, the same
            // speed memory as the S4) on an AC Infinity CO2 controller (AC-CTC7).
            // High on the mushroom room's wall, it exchanges the room's air with
            // the home's while the room holds more than 600 ppm of carbon dioxide,
            // so the racks' tents draw air their own fans can hold at 900 without
            // outrunning their humidifiers: on for the share of the time that
            // holds it, off below, drawing its 70 W for that share
            // (data/garden/humidity.ron, THE CO2 FANS). 600 ppm is a GAME CHOICE
            // from the model's balance (docs/design/ship-life-support.md), the
            // family home's setpoint. Here two racks lift the room only about 180
            // ppm over the home on its own leakage, so while a new game's air is
            // near 400 ppm the room stays under 600 and the fan idles; as the
            // home's air settles near 465 it runs a little of the time.
            ventilation_m3_h: 722.1,
            co2_setpoint_ppm: 600.0,
            stats: [
                (
                    kind: "power",
                    value: "70 W while on, on part of the time",
                    status: "ok",
                ),
                (
                    kind: "air",
                    value: "holds the mushroom room under 600 ppm of CO2",
                    status: "ok",
                ),
            ],
            // average_watts (2026-09-27): what the static power meter charges it
            // for a day, idle: two racks leave the room under its 600 ppm, measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(
                watts: 70.0,
                priority: 4,
                average_watts: Some(0.0),
            )),
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: None,
        ),
        "generator_portable": (
            shape: "box", size: (0.55, 0.45, 0.45), color: (0.45, 0.45, 0.20),
            label: "Generator (backup)",
            category: "Power",
            stats: [(kind: "fuel", value: "200 L drum", status: "ok"), (kind: "power", value: "backstop 1.8 kW while it runs, 1.1 L of fuel an hour", status: "off")],
            // A backstop (2026-09-27; it had no power role at all, so it was a prop wired to a
            // battery bank). The same machine as home.ron's generator_portable, whose comment
            // quotes its figures: a Honda EU2200i class inverter set, "Rated output" "1.8 kVA",
            // "3.2hr @ rated load" on its 3.6 L tank, so 1,800 W while it runs on 1.125 L of fuel
            // an hour. It burns what is in its 200 L drum, which this home has no refinery to
            // fill: its fuel is traded for. The meter shows what it can add, apart from what the
            // home makes on its own.
            power: Some(Generator(watts: 1800.0, fuel_lph: 1.125)),
            container_type: Some("steel_fuel_drum"),
            level_gauge: true,
        ),
        "water_tank": (
            shape: "cylinder", size: (0.9, 2.2, 0.9), color: (0.20, 0.45, 0.75),
            label: "Cistern (8000 L)",
            category: "Water",
            stats: [(kind: "storage", value: "62 days (dry season, net draw ~128 L/d)", status: "ok"), (kind: "water", value: "rain + well fed", status: "ok")],
            // One person's net demand is the 85 L household plus the garden's net 43 L a day
            // (the Water loop, 2026-09-27; it said 80 L and ~100 days before the garden's water
            // was a real loop), so the same 8000 L tank the 3-person home holds for ~23 days
            // gives ONE person ~62 (over-provisioned buffer is a feature -- self-sufficiency.md:
            // dry-season storage is the binding constraint).
            storage: [(utility: Water, capacity: 8000.0)],
            ports: [(utility: Water, dir: Out, label: "rain catchment", flow_lpm: 0.1)],
        ),
        "water_pump": (
            shape: "box", size: (0.35, 0.35, 0.35), color: (0.30, 0.50, 0.60),
            label: "Water pump",
            category: "Water",
            stats: [(kind: "power", value: "-0.06 kWh/d", status: "ok"), (kind: "water", value: "2 L/min", status: "ok")],
            power: Some(Consumer(watts: 10.0, priority: 2)),
            ports: [
                (utility: Electricity, dir: In, label: "motor", watts: 10.0),
                (utility: Water, dir: Out, label: "well lift", flow_lpm: 2.0),
            ],
        ),
        "water_purifier": (
            shape: "cylinder", size: (0.28, 0.7, 0.28), color: (0.35, 0.65, 0.78),
            label: "Water purifier",
            category: "Water",
            stats: [(kind: "water", value: "+240 L/d potable", status: "ok"), (kind: "power", value: "-0.08 kWh/d", status: "ok")],
            power: Some(Consumer(watts: 13.0, priority: 2)),
            // Water leaving the purifier is drinking water: its lines carry ISO 14726's potable-water marker (2026-10-04, data/piping/marking_schemes.ron).
            outlet_media: {"water": "potable_water"},
        ),
        "home_water_use": (
            shape: "box", size: (0.3, 0.3, 0.3), color: (0.40, 0.60, 0.78),
            label: "Drinking water",
            category: "Water",
            // v0.1027 (homestead increment 3): the fixtures below carve the
            // old -80 L/d aggregate into real per-room draws; this node
            // keeps only drinking/cooking water (~5 L/d).
            stats: [(kind: "water", value: "-5 L/d (drinking)", status: "ok")],
            ports: [(utility: Water, dir: In, label: "taps", flow_lpm: 0.0035)],
        ),
        // ── Homestead plumbing fixtures (v0.1027, homestead.md section 5.2;
        // per-day flows sized for ONE person, expressed as L/min averages).
        // water_heater is the FIRST HotWater producer - Utility::HotWater
        // existed end-to-end with zero producers until this entry. ──
        // THE HOT WATER (2026-09-27): each fixture's hot share is the measured share of its water
        // that is hot, from the Water Research Foundation's Residential End Uses of Water,
        // Version 2 (DeOreo et al. 2016, 94 homes), as tabled by Lawrence Berkeley National
        // Laboratory for the EPA (Chen et al. 2020, Table 2, https://www.osti.gov/servlets/purl/1619186,
        // read 2026-09-27): "Showers ... 66.2", "Faucets ... 57.0", "Clothes washers ... 20.0"
        // percent. home.ron carries the same list for three and quotes the checks. So 36.8 L of
        // hot water a day (it was 27 L, split by no source), 43% of this home's 85 L.
        "kitchen_sink": (
            shape: "box", size: (0.6, 0.85, 0.5), color: (0.75, 0.78, 0.80),
            label: "Kitchen sink + counter",
            category: "Water",
            stats: [(kind: "water", value: "-15 L/d, 57% of it hot", status: "ok")],
            ports: [
                (utility: Water, dir: In, label: "cold", flow_lpm: 0.00448),
                (utility: HotWater, dir: In, label: "hot", flow_lpm: 0.00594),
            ],
        ),
        "bath_sink": (
            shape: "box", size: (0.5, 0.8, 0.4), color: (0.85, 0.87, 0.88),
            label: "Bathroom sink",
            category: "Water",
            stats: [(kind: "water", value: "-5 L/d, 57% of it hot", status: "ok")],
            ports: [
                (utility: Water, dir: In, label: "cold", flow_lpm: 0.00149),
                (utility: HotWater, dir: In, label: "hot", flow_lpm: 0.00198),
            ],
        ),
        "shower": (
            shape: "box", size: (0.9, 2.1, 0.9), color: (0.70, 0.82, 0.86),
            label: "Shower",
            category: "Water",
            stats: [(kind: "water", value: "-35 L/d, 66% of it hot", status: "ok"), (kind: "water", value: "the big hot draw", status: "warn")],
            ports: [
                (utility: Water, dir: In, label: "cold", flow_lpm: 0.00822),
                (utility: HotWater, dir: In, label: "hot", flow_lpm: 0.01609),
            ],
        ),
        "toilet": (
            shape: "box", size: (0.45, 0.75, 0.65), color: (0.90, 0.90, 0.92),
            label: "Toilet",
            category: "Water",
            stats: [(kind: "water", value: "-14 L/d", status: "ok")],
            ports: [
                (utility: Water, dir: In, label: "fill", flow_lpm: 0.0097),
                (utility: Waste, dir: Out, label: "black water", flow_lpm: 0.0097),
            ],
        ),
        "washer": (
            shape: "box", size: (0.6, 0.85, 0.6), color: (0.82, 0.82, 0.86),
            label: "Washing machine",
            category: "Water",
            stats: [(kind: "water", value: "-11 L/d avg, 20% of it hot", status: "ok"), (kind: "power", value: "-0.13 kWh/d (US survey average, one person)", status: "ok")],
            // Energy (2026-09-27; it was a 12 W continuous-equivalent, 0.29 kWh a day, from no
            // source). EIA, 2020 Residential Energy Consumption Survey, Table CE5.3a (released June
            // 2023, revised March 2024, https://www.eia.gov/consumption/residential/data/2020/c&e/xls/ce5.3a.xlsx,
            // read 2026-09-27): clothes washers, "1 member", 46 kWh a year per household using
            // one, 5.25 W averaged: the motor only, as RECS counts the wash water under water
            // heating (home.ron's washer has the definitions). RECS Table HC3.4 (final release
            // March 2023, read 2026-09-27) finds 21.04 million one-person homes washing "1 to 4
            // loads per week" and 2.45 million more; at the bins' midpoints (a game estimate)
            // about 3 loads a week, so about 0.3 kWh a load. This file's convention: the Consumer
            // and its port both carry the continuous-equivalent the electrical sim draws around
            // the clock; `average_watts` states it for the static meter as home.ron's does.
            // Its water (2026-09-27; it had only a cold fill): a hot and a cold hose, mixed for a
            // warm wash, "Clothes washers ... 20.0" percent of it hot (above).
            power: Some(Consumer(watts: 5.25, priority: 4, average_watts: Some(5.25))),
            ports: [
                (utility: Water, dir: In, label: "cold fill", flow_lpm: 0.00611),
                (utility: HotWater, dir: In, label: "hot fill", flow_lpm: 0.00153),
                (utility: Electricity, dir: In, label: "motor (5.25 W averaged)", watts: 5.25),
            ],
        ),
        "water_heater": (
            shape: "cylinder", size: (0.55, 1.5, 0.55), color: (0.88, 0.84, 0.70),
            label: "Water heater (150 L)",
            category: "Water",
            // Energy (2026-09-27). It was ~1.2 kWh/day, a continuous-equivalent 50 W: the heat in
            // 26 L warmed about 40 C with nothing lost, which leaves out the tank's standby loss.
            // Now the real figure: EIA, 2020 Residential Energy Consumption Survey, Table CE5.3a
            // "Detailed household site electricity end-use consumption, part 1 - averages"
            // (released June 2023, revised March 2024,
            // https://www.eia.gov/consumption/residential/data/2020/c&e/xls/ce5.3a.xlsx, read
            // 2026-09-27): water heating, "1 member", 1,427 kWh a year per household that heats
            // its water with electricity, 3.91 kWh a day, 162.9 W averaged. This file's convention:
            // the Consumer and its port both carry the continuous-equivalent the electrical sim
            // draws around the clock (it has no thermostat); `average_watts` states it for the
            // static meter as home.ron's does. Its water (2026-09-27): the 36.8 L a day the
            // fixtures draw hot; warmed 35.8 C (LBNL's national 60.5 F inlet to its 125 F
            // setpoint) that is 1.5 kWh of heat, well under the RECS figure, which carries the
            // tank's standby loss and a US single's larger draw.
            stats: [(kind: "power", value: "-3.9 kWh/d (US survey average, one person)", status: "warn"), (kind: "water", value: "hot 37 L/d", status: "ok")],
            power: Some(Consumer(watts: 162.9, priority: 3, average_watts: Some(162.9))),
            storage: [(utility: HotWater, capacity: 150.0)],
            ports: [
                (utility: Electricity, dir: In, label: "element (162.9 W averaged)", watts: 162.9),
                (utility: Water, dir: In, label: "cold feed", flow_lpm: 0.02554),
                (utility: HotWater, dir: Out, label: "hot supply", flow_lpm: 0.02554),
            ],
        ),
        "septic_tank": (
            shape: "cylinder", size: (1.2, 1.0, 1.2), color: (0.35, 0.32, 0.28),
            label: "Septic tank (2000 L)",
            category: "Water",
            stats: [(kind: "storage", value: "black water", status: "ok")],
            storage: [(utility: Waste, capacity: 2000.0)],
            ports: [(utility: Waste, dir: In, label: "inlet", flow_lpm: 0.0097)],
        ),
        // ── Furniture (v0.1028, homestead.md section 6): ported verbatim
        // from home.ron - same house, same rooms, same GLTF models with
        // primitive fallback. ──
        "bed": (
            shape: "box",
            size: (2.00, 0.60, 1.00),
            color: (0.42, 0.44, 0.50),
            label: "Bed",
            category: "Furniture",
            stats: [
                (
                    kind: "storage",
                    value: "sleep here",
                    status: "ok",
                ),
            ],
            // E sleeps the night here, as at a bed you build (first-hour audit F5, 2026-10-04).
            provides: Some("rest"),
            power: None,
            ports: [],
            storage: [],
            auto_recipe: None,
            container_type: None,
            model: Some("assets/models/furniture/beddouble/beddouble.gltf"),
        ),
        "nightstand": (
            shape: "box",
            size: (0.50, 0.55, 0.40),
            color: (0.52, 0.38, 0.24),
            label: "Nightstand",
            category: "Furniture",
            stats: [
