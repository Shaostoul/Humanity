        // THE FIRST QUESTS' STATIONS (2026-10-04, the first-hour audit's B4). A hand craft
        // needs its recipe's station placed in the home, and this home placed no smelter and
        // no workbench: a one-person player could never smelt the first iron ingot (the only
        // smelter a player can build, the furnace in data/blueprints/basic.ron, takes 3 iron
        // ingots) nor forge the hammer after it. One small smelter and one workbench, the
        // same machines as home.ron's, where the family home has its forge and workshop.
        // homestead-solo-design.md section 8 already allows a homestead small metal jobs;
        // what one home cannot do is mine and refine at scale, and the ore still comes from
        // outside, by drone or trade. The test that holds every shipped home to the starter
        // quests: every_shipped_home_has_what_the_starter_quests_need (src/machines.rs).
        "smelter": (
            shape: "box", size: (0.7, 0.9, 0.7), color: (0.55, 0.22, 0.12),
            label: "Smelter",
            category: "Production",
            stats: [(kind: "heat", value: "1200 C", status: "ok"), (kind: "power", value: "-1.0 kWh/d", status: "warn")],
            auto_recipe: Some("smelt_iron"),
        ),
        "workbench": (
            shape: "box", size: (1.2, 0.9, 0.6), color: (0.45, 0.35, 0.22),
            label: "Workbench",
            category: "Production",
            stats: [(kind: "progress", value: "auto-crafting", status: "ok")],
            auto_recipe: Some("craft_hammer"),
            auto_keep: Some(2),
        ),
        // THE TRADING POST (2026-10-04, the first-hour audit's F3). The first quest sends a
        // new player for ore to "Inventory > Mining, or the trading post", and the quests
        // after it need goods this home cannot make: Build First Habitat's window takes a
        // glass pane, and the smelter's own recipe burns coal. A one-person home trading for
        // what it cannot make is the lesson of homestead-solo-design.md section 8. The same
        // machine as home.ron's, where the family home stands it, in the vehicle bay.
        "trading_post": (
            shape: "box", size: (1.6, 1.1, 0.8), color: (0.55, 0.42, 0.25),
            label: "Trading post",
            category: "Logistics",
            stats: [(kind: "trade", value: "buys + sells goods", status: "ok")],
        ),
    },

    // Placed instances, one-person BOM from homestead-solo-design.md sections 1-5:
    // Power: 4 solar / 2 battery / 1 wind / 1 generator (vs 8/8/1/0 for 3 people).
    // Water: 1 cistern / 1 pump / 1 purifier / 1 household tap.
    // Air: 1 recycler. Waste: 2 composters (maturation-lag insurance).
    // Food: 9 nutrition towers + 1 apothecary + 8 potato beds + 3 oilseed + 2 grain trays +
    // 2 mushroom racks + 1 aquaponic tank + 1 grain field + 1 legume field + 1 silo +
    // 1 irrigation. `tuber_field`/`oilseed_field` dropped entirely (3-person bulk, not
    // needed once the garden alone reaches ~94% of one person's calories).
    //
    // OFFSETS ARE ABSOLUTE box coordinates, same frame as home.ron (metres from the box min
    // corner) since this reuses the identical `blueprints/homestead_layout.ron` room shells --
    // just far fewer instances, so everything sits well inside each room's footprint.
    instances: [
