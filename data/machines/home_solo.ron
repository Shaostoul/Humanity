    // Dense garden fill, infinite-of-X grids (one line per block instead of many hand-typed
    // instances): 8 potato beds, 9 variety towers, 3 oilseed beds, 2 grain trays and 2
    // mushroom racks. The counts were first sized from homestead-solo-design.md section 3's
    // per-crop kcal table. What each machine grows a day is no longer typed here: it is
    // computed from its crops (src/systems/grow_machines.rs; the ignored test
    // print_grown_food_per_machine prints the table), and the Food loop's note below gives
    // the whole home's total and whether it closes.
    arrays: [
        (
            machine: "potato_grow_bed",
            room: "room-greenhouse",
            origin: (13.0, 0.0, 54.0),
            rows: 2,
            cols: 4,
            spacing: (2.7, 2.2),
            id_prefix: "potato",
            zone: "home",
        ),
        (
            machine: "oilseed_bed",
            room: "room-greenhouse",
            origin: (30.0, 0.0, 54.0),
            rows: 1,
            cols: 3,
            spacing: (2.7, 2.2),
            id_prefix: "oilbed",
            zone: "home",
        ),
        (
            machine: "staple_grain_tray",
            room: "room-greenhouse",
            origin: (30.0, 0.0, 59.5),
            rows: 1,
            cols: 2,
            spacing: (2.7, 2.2),
            id_prefix: "graintray",
            zone: "home",
        ),
        (
            machine: "aeroponic_tower_nutrition",
            room: "room-greenhouse",
            origin: (14.0, 0.0, 62.0),
            rows: 3,
            cols: 3,
            spacing: (2.2, 2.2),
            id_prefix: "ntower",
            zone: "home",
        ),
        (
            machine: "mushroom_rack",
            room: "room-mushroom",
            origin: (2.0, 0.0, 53.0),
            rows: 2,
            cols: 1,
            spacing: (2.6, 2.2),
            id_prefix: "mush",
            zone: "home",
        ),
        // One tent humidifier on each rack's bottom shelf, inside its fruiting
        // tent (the same grid as the racks above, 2026-09-26;
        // data/garden/humidity.ron, THE FRUITING TENT).
        (
            machine: "tent_humidifier",
            room: "room-mushroom",
            origin: (2.0, 0.0, 53.0),
            rows: 2,
            cols: 1,
            spacing: (2.6, 2.2),
            id_prefix: "mushhum",
            zone: "home",
        ),
        // One CO2 fan on top of each rack, inside its tent (2026-09-27, the
        // same grid as the racks; data/garden/humidity.ron THE CO2 FANS).
        (
            machine: "tent_co2_fan",
            room: "room-mushroom",
            origin: (2.0, 1.6, 53.0),
            rows: 2,
            cols: 1,
            spacing: (2.6, 2.2),
            id_prefix: "mushfan",
            zone: "home",
        ),
    ],

    // Connections mirror home.ron's topology exactly (homestead-solo-design.md: "copy the
    // connections topology from home.ron -- it's already correct, just fewer instances"),
    // scaled to 2 batteries instead of 8 and no fuel-refinery link (dropped for solo scope).
    connections: [
        // Power: 4 panels + wind feed the 2-bank bus; the generator backstops it.
        (from: "solar_1", to: "battery_1", kind: "power"),
        (from: "solar_2", to: "battery_1", kind: "power"),
        (from: "solar_3", to: "battery_2", kind: "power"),
        (from: "solar_4", to: "battery_2", kind: "power"),
        (from: "wind_1", to: "battery_1", kind: "power"),
        (from: "gen_1", to: "battery_2", kind: "power"),
        (from: "battery_1", to: "battery_2", kind: "power"),
        (from: "battery_2", to: "pump_1", kind: "power"),
        (from: "battery_2", to: "purifier_1", kind: "power"),
        (from: "battery_1", to: "irrigation_1", kind: "power"),
        (from: "battery_1", to: "mushhum_0", kind: "power"),
        (from: "battery_1", to: "mushhum_1", kind: "power"),
        (from: "battery_1", to: "mushfan_0", kind: "power"),
        (from: "battery_1", to: "mushfan_1", kind: "power"),
        (from: "battery_1", to: "mushroom_fan_1", kind: "power"),
        (from: "battery_1", to: "air_recycler_1", kind: "power"),
        // The fish tank's air pump (2026-09-27).
        (from: "battery_1", to: "aqua_1", kind: "power"),

        // Water: cistern -> pump -> purifier trunk, then per-fixture
        // branches (v0.1027, homestead 5.2: copper 3/4" trunk, PEX 1/2"
        // branches - pinned specs teach real plumbing gauges).
        (from: "cistern_1", to: "pump_1", kind: "water"),
        (from: "pump_1", to: "purifier_1", kind: "water"),
        (from: "purifier_1", to: "irrigation_1", kind: "water"),
        (from: "purifier_1", to: "household_1", kind: "water", spec: Some("pex_half")),
        (from: "purifier_1", to: "water_heater_1", kind: "water", spec: Some("copper_threequarter")),
        (from: "purifier_1", to: "kitchen_sink_1", kind: "water", spec: Some("pex_half")),
        (from: "purifier_1", to: "bath_sink_1", kind: "water", spec: Some("pex_half")),
        (from: "purifier_1", to: "shower_1", kind: "water", spec: Some("pex_half")),
        (from: "purifier_1", to: "toilet_1", kind: "water", spec: Some("pex_half")),
        (from: "purifier_1", to: "washer_1", kind: "water", spec: Some("pex_half")),
        // Hot water: the heater's first-ever HotWater consumers.
        (from: "water_heater_1", to: "kitchen_sink_1", kind: "hot_water", spec: Some("pex_half")),
        (from: "water_heater_1", to: "bath_sink_1", kind: "hot_water", spec: Some("pex_half")),
        (from: "water_heater_1", to: "shower_1", kind: "hot_water", spec: Some("pex_half")),
        (from: "water_heater_1", to: "washer_1", kind: "hot_water", spec: Some("pex_half")), // its hot hose (2026-09-27)
        // Black water: toilet -> septic (honest dead end for now).
        (from: "toilet_1", to: "septic_1", kind: "waste", spec: None),
        // Power: washer + heater on the utility circuit.
        (from: "battery_2", to: "washer_1", kind: "power", spec: Some("cu_awg12")),
        (from: "battery_2", to: "water_heater_1", kind: "power", spec: Some("cu_awg10")),
        (from: "irrigation_1", to: "potato_0", kind: "water"),
        (from: "aqua_1", to: "ntower_0", kind: "water"),
        (from: "composter_1", to: "irrigation_1", kind: "water"),

        // Nutrients: compost + fish waste + nitrogen-fixing legumes close the loop.
        (from: "composter_1", to: "potato_0", kind: "nutrient"),
        (from: "composter_2", to: "ntower_0", kind: "nutrient"),
        (from: "composter_1", to: "grain_field_1", kind: "nutrient"),
        (from: "legume_field_1", to: "grain_field_1", kind: "nutrient"),

        // Food: the field crop banks into the silo (the winter/preservation buffer).
        (from: "grain_field_1", to: "silo_1", kind: "food"),
        // SHIP LIFE SUPPORT (2026-09-26) wiring: each air handler's fan to a
        // battery bank, its condensate line to the cistern.
        (from: "battery_2", to: "air_handler_g1", kind: "power"),
        (from: "air_handler_g1", to: "cistern_1", kind: "water"),
        (from: "battery_2", to: "air_handler_c1", kind: "power"),
        (from: "air_handler_c1", to: "cistern_1", kind: "water"),
        (from: "battery_2", to: "air_handler_h1", kind: "power"),
        (from: "air_handler_h1", to: "cistern_1", kind: "water"),
        (from: "battery_2", to: "air_handler_h2", kind: "power"),
        (from: "air_handler_h2", to: "cistern_1", kind: "water"),
        (from: "battery_2", to: "air_handler_h3", kind: "power"),
        (from: "air_handler_h3", to: "cistern_1", kind: "water"),
        // end ship life support wiring
    ],

    // The coupled loops for ONE person -- see homestead-solo-design.md for the full
    // sizing derivation behind the first figures here, and ship-life-support.md for
    // the air and the garden's water aboard (2026-09-26).
    loops: [
        (
            name: "Energy",
            demand: "~32.8 kWh/day in the Realistic mode (the home and its machines ~8.6, the air handlers ~24.1); ~8.6 kWh/day Station-supplied (water heater ~3.9, freezer ~1.5, tower pumps ~1.1, mushroom tent humidifiers ~0.8, the fish tank's air pump ~0.4, the tents' CO2 fans ~0.1, the rest ~0.8)",
            supply: "~4.45 kWh/day: 4 solar panels ~4.35 (their yield at the home's site after the batteries' round trip; ~2.0 in January) + wind ~0.1; 2 batteries; the backstop generator (1.8 kW while it runs) counted apart",
            closes: false,
            weakest: true,
            note: "Does NOT close in either mode, on the year's average or in winter. THE METER (2026-09-27): these figures are the Construction page's power meter, which charges every machine its real daily energy and credits every source what it makes at the home's site (Silverdale, WA, data/self_sufficiency/location.ron), and a test (the_household_machines_charge_their_sourced_daily_energy in src/machines.rs) holds this loop to it. SUPPLY: a 400 W panel makes 1.09 kWh a day there averaged over the year and 0.51 in January, the worst month (NREL's PVWatts: 440.7 kWh a year at the inverter for a panel tilted 40 degrees to the south, less the batteries' 90% round trip, Tesla Powerwall 2), and the wind turbine (a Primus AIR 40, 160 W at 12.5 m/s) makes 0.11 kWh a day, because the nearest measured wind, the Bremerton airport's, averages 2.4 m/s (5.3 mph) and the turbine needs 3.1 to start. So the home makes about 4.45 kWh a day on its own, about 2.1 in January. The backstop generator (a 1.8 kW inverter set, 1.1 L of fuel an hour, which had no power role until now) is not counted as supply: the meter shows what it can add while it runs, and this home has no refinery to fill its drum. Until this the meter counted the turbine's 150 W for 24 hours and each panel's 400 W for 4.5 sun-hours with nothing lost, 10.8 kWh a day, and this loop's 5.76 rested on a generic 4.5 sun-hours with a 0.80 derate. DEMAND: the household's machines are EIA's 2020 Residential Energy Consumption Survey averages for a one-person household (Tables CE5.3a and CE5.3b): the water heater 3.9 kWh a day (1,427 kWh a year for a home that heats its water with electricity; it was a continuous 50 W, 1.2 kWh, the heat in 26 L a day with nothing lost), the freezer 1.5 (539 kWh a year), the washer's motor 0.13 (46 kWh a year). The towers' pumps are 1.1 (Tower Garden's 48 W and 35 W pumps on the maker's indoor timer, 5 minutes on in every 50), and the fish tank's air pump 0.41 (a 17 W HIBLOW HP-20, all day, the top of FAO's 5 to 8 L of air a minute for each cubic metre of water; its stat said 50 W and it had no power). In the Station-supplied mode, the default, the station's own plant powers the air handlers and the scrubber, and the home draws about 8.6 kWh a day against the 4.45 it makes: the water heater 3.9, the freezer 1.5, the tower pumps 1.1, the mushroom tent humidifiers 0.8, the fish tank's air pump 0.4, the tents' CO2 fans 0.1 and the rest 0.8 (the water purifier and pump, the irrigation and the washer). It does NOT close: 4.2 kWh a day short, about 4 more panels on the year's average and about 13 more for January; the backstop would have to run about 2.3 hours a day on 2.6 L of fuel to cover it. The water heater alone takes most of what the panels make, and its RECS figure is about two and a half times the heat in this home's own 37 L of hot water a day (the Water loop): the average US single it comes from draws more. Not counted yet, because no data carries them: lighting, cooking, small appliances, and the fish tank's water pump (FAO sizes 25 to 50 W for a 1,000 L unit). In the Realistic mode the air handlers' 24.1 kWh a day come onto the home's grid as well, about 32.8 kWh a day against 4.45: it does NOT close, about 27 more panels on the year's average, or the backstop running about 15.7 hours a day on 17.7 L of fuel. Aboard a sealed station every litre the crops breathe out has to be condensed back out of the air, because there is no outside to vent it to; until this the model held the home's air at 40% for nothing. The home now carries five air handlers (Carrier 42CT size 14 fan coils on the station's cooling loop: 1,842 m3/h, 325 W flat out, data/life_support.ron): one in the greenhouse and one in the court, holding them at 75% (the greenhouse's crops breathe out about 199 L a day, the court's towers 43 L), and three in the plant room, holding the home's own air at 50%. Measured over a day and a night at full planting (src/systems/farming/life_support_tests.rs) they average about 1,005 W, 24.1 kWh a day. Nearly all of it is the home's three: the greenhouse is the same 2,970 m3 room the family home has, and it and the court leak 0.5 air changes an hour into the drier home air, about 215 L of their water a day, where every litre costs about 105 Wh of fan power against 27 Wh in the greenhouse. Each mushroom tent has a CO2 fan since 2026-09-27 (an AC Infinity CLOUDLINE S4, 28 W, switched at 900 ppm by a CO2 controller) and the mushroom room one of its own (a CLOUDLINE S6, 70 W, at 600 ppm): the tent fans run about 5.5% of the time, about 3 W together, and the room fan idles while two racks leave the room under 600. The fresh air they bring in makes the tent humidifiers work harder, about 34 W (0.81 kWh a day, was 0.42). The CO2 scrubber that replaced the 25 W air recycler idles (the crops keep the carbon dioxide near 465 ppm once it settles). The cheaper levers are design calls: holding the home's air at 60% instead of 50% (the EPA's line; the handlers then average about 450 W, 11 kWh a day, measured), sealing the greenhouse and the court from the home more tightly than an Earth greenhouse's 0.5 air changes an hour, a smaller greenhouse for one person, or fan coils with EC motors (the catalogue's are permanent split capacitor motors, the least efficient kind, and its EC option publishes no figures to model). The coils' heat, about 7 kW of it latent (250 L a day at 2.45 MJ a litre, FAO-56), goes to the station's radiators, which the game does not model yet: the Climate loop. The indoor garden stays sun-lit, not grow-lit: artificial lights to feed one person indoors would cost 10-50 kWh/d.",
        ),
        (
            name: "Water",
            demand: "~128 L/day net (household ~85, 37 of it hot + the garden's net ~43)",
            supply: "rain + well + ~52 L/day greywater recycling; the air handlers hand ~254 L/day back to the tanks; 8000 L cistern = ~65 days",
            closes: true,
            weakest: false,
            note: "Closes, and the garden's water is now a real loop (2026-09-26, ship life support). The irrigation draws what the crops breathe out plus what their tissue keeps (NASA's measured share, 2 to 10% by crop, data/life_support.ron), about 297 L a day at full planting, and the five air handlers condense what the air carries and pipe it back to the cistern: about 254 L a day, every litre the indoor crops (242), the mushroom tents (2 breathed, 8 humidified, up from 4 since their CO2 fans bring in drier air) and the resident (2) put into the air, to within 1% (src/systems/farming/life_support_tests.rs). The garden's net draw is therefore about 43 L a day: the water its crops keep (~15 L, which leaves in the harvest), what the outdoor fields breathe into the weather (~29 L), less the resident's breath the coils catch (~2 L). Net demand is the household plus that, about 128 L a day, and the same 8000 L cistern reaches about 62 days (it was quoted at 93 when the garden's water was billed at a fraction of its real rate and its vapour vanished into the home's air, and at 65 against the older 80 L household). THE HOUSEHOLD (2026-09-27): data/home_outline.json's fixture list, 85 L a day (drinking and cooking 5, the kitchen sink 15, the bathroom sink 5, the shower 35, the toilet 14, the laundry 11); each fixture's hot water is its measured share (the Water Research Foundation's Residential End Uses of Water, 94 homes: showers 66.2%, faucets 57.0%, clothes washers 20.0%), 37 L a day, 43% of it (it was 27 L, split by no source), and the water heater makes exactly that; the washer now has the hot and cold fills a real one has (home.ron quotes the sources). The air runs on game hours and the tanks on real minutes, which is still the operator's open question; the flows cross as litres a day on both sides, so a day's water balances on either clock.",
        ),
        (
            name: "Air",
            demand: "~2.0 kg/day of carbon dioxide breathed out (the resident ~0.8, two mushroom tents ~1.2) and ~1.5 kg/day of oxygen breathed in",
            supply: "the crops' photosynthesis (they take up the carbon dioxide and give out ~0.72 kg of oxygen per kg of it); CO2 scrubber (ISS CDRA, 860 W) above 2,636 ppm; five air handlers for the water; a CO2 fan in each mushroom tent and one for the mushroom room",
            closes: false,
            weakest: false,
            note: "The carbon closes on the crops; the oxygen does not quite (2026-09-26, ship life support, data/life_support.ron). The resident breathes in proportion to the food they burn (NASA's crew figures, 0.835 kg of oxygen in and 0.998 kg of carbon dioxide out at 11.82 MJ, scaled to the Food loop's 2,200 kcal: 0.65 and 0.78 kg), and the tents' substrate breathes out 1.09 g of carbon dioxide per kg an hour, more than the resident does. The crops take it up through the pores they breathe water out of, at NASA's measured grams per litre, in their lit hours, and less in thin air (Kimball: 33% more per doubling). Over a measured day and night at full planting they took up about 1.85 of the 1.96 kg with the home's air near 395 to 425 ppm; they catch up as it rises, and it settles near 465 ppm (measured: started at 450, its day ran 426 to 457 with the crops taking up 1.92 kg), so the scrubber idles. Oxygen falls short: the crops give out one molecule of oxygen for each of carbon dioxide they fix, but a person burning fat and protein takes in more oxygen than the carbon dioxide they breathe out (respiratory quotient 0.87), so once the carbon settles the home still loses about 0.1 kg of oxygen a day, plus about 0.1 kg in the 0.46 kg of air a day that leaks overboard (BVAD's 0.02 kg a day per module, each of the home's 23 rooms counted as one). That is years before it matters out of the ~2,900 kg in the home's air, but it is not closed: an electrolyser splitting water would make it back for about 6.5 kWh per kg of oxygen (data/home_outline.json), about 1.3 kWh a day, and the home does not carry one yet. The leaked nitrogen has to be brought in. The mushrooms' own air is held since 2026-09-27: each tent's CO2 fan (an AC Infinity CLOUDLINE S4 on a CO2 controller) holds it at 900 ppm, under the 1,000 the oysters fruit under, and the room's (a CLOUDLINE S6) holds the room under 600, so both tents sit at 900 ppm and 90% humidity where they ran about 1,200 ppm; stale air now costs a mushroom its crop (26.7% per 1,000 ppm over, data/garden/humidity.ron). They still hold with the home's air at its settled ~465 ppm (measured). The carbon closes in either Ship life support mode; the mode only decides who powers the machines.",
        ),
        (
            name: "Food",
            demand: "~2,200 kcal/day + complete nutrition (1 person)",
            supply: "indoor sun-lit garden (9 variety towers + 1 apothecary + 8 potato beds + 3 oilseed beds + 2 grain trays + 2 mushroom racks + 1 aquaponic tank): ALL veg/herbs/protein/vitamins + B12 + omega-3; one outdoor grain field and one legume field add grain and pulses; silo = 750 days. The calories are the grown line, computed from the crops placed",
            closes: false,
            weakest: true,
            note: "Does not close (2026-09-27): the placed crops grow about 1,780 kcal a day against the 2,200 one person needs, 81%, and that is an upper bound. It was about 2,154 (98%) until two defects were fixed. The two mushroom racks counted an unsourced placeholder of about 198 kcal a day each; a rack is ten 5 lb fruiting blocks, and a block gives about 1 lb of oyster mushrooms over four flushes and 53 days on its shelf, so a rack grows about 28 (data/garden/yields.ron, MUSHROOMS). And sunflower and paddy rice counted their hulls as food, so the oilseed beds lost a quarter and the rice trays a fifth. About seven more potato beds (61.5 kcal a day each) would close it on paper; the fish tank is not counted. The pedagogical payoff: this is the SAME 34x34 m garden room the 3-person home uses, sized for 1. The grown figure is computed from the crops placed (2026-09-26): each plant at its cited yield, cropped back to back all year, so it is an upper bound that does not yet discount for the light the canopy really gets. The hard limit is still light, not floor area: one sun, one canopy, no stacked tiers. The outdoor grain and legume fields (the 3-person tuber/oilseed fields dropped) add grain and pulses banked in the silo; the fish tank's figure is an estimate the crop model cannot count.",
            food_demand_kcal: Some(2200.0),
        ),
        (
            name: "Nutrients",
            demand: "~13 nutrient-units/day (garden + field, one person's share)",
            supply: "2 composters (food + crop + human waste) -> fertilizer; legume nitrogen fixing; aquaponic fish waste",
            closes: true,
            weakest: false,
            note: "Compost + the legume field's nitrogen fixing close the nutrient loop the same way the 3-person home's does, just scaled down. The aquaponic tank's fish waste fertilizes the towers -- a closed fish-to-plant nutrient loop even at this small scale.",
        ),
    ],
)
