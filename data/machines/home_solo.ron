        "grow_light": (
            shape: "box", size: (1.2, 0.1, 0.6), color: (0.72, 0.30, 0.78),
            label: "LED grow light",
            category: "Food",
            lights_crops: true, // lights the grow machines nearest it while powered (data/garden/lighting.ron); fields have only the sun
            stats: [(kind: "power", value: "-1.4 kWh/d (100 W x 14 h)", status: "warn"), (kind: "food", value: "light past the sun, at a cost", status: "warn")],
            // The honest teaching machine (v0.664, self-sufficiency.md's "light cap"): the solo
            // home's whole budget is ~4 kWh/day, and ONE 100 W LED on a 14 h crop photoperiod
            // eats 1.4 kWh/day of it -- three lights alone rival the entire home. The grow-light
            // power meter in the construction editor shows exactly that (green -> amber -> red).
            // NOT placed in the seed design: the solo garden closes on sunlight alone, which is
            // the lesson. Priority 5 = optional, shed first.
            power: Some(Consumer(watts: 100.0, priority: 5)),
        ),
        "bumblebee_hive": (
            shape: "box", size: (0.35, 0.28, 0.28), color: (0.85, 0.62, 0.20),
            label: "Bumblebee hive",
            category: "Food",
            pollinates_crops: true, // pollinates the indoor grow areas within ~18 m (data/garden/pollination.ron); corn still needs a hand
            stats: [(kind: "food", value: "pollinates flowers within ~18 m", status: "ok"), (kind: "progress", value: "needs a bought colony; it works 10 weeks", status: "warn")],
            // Not placed in the seed design: the solo garden is hand-pollinated until the player
            // chooses bees. The hive holds no colony until the player introduces a bought one
            // (Garden panel, Introduce colony); it works 70 garden days, Koppert's "Remove
            // bumblebee hives the latest 10 weeks after introduction", and is then spent
            // (2026-09-27, cited in pollination.ron). A colony can also over-work the few flowers
            // of a small garden (LSU, cited there); that is not modelled.
        ),
        "circulation_fan": (
            shape: "box", size: (0.247, 0.30, 0.20), color: (0.20, 0.22, 0.24),
            label: "Circulating fan (clip-on)",
            category: "Food",
            // A 6 inch clip-on grow fan (AC Infinity CLOUDRAY S6, read 2026-09-27:
            // "Maximum Airflow 325 CFM", "Power 11 W", "Total Dimensions 9.73 x 11.82 in.
            // (24.7 x 30.0 cm)"; the 0.20 m depth is a game estimate). Clipped over a grow
            // machine and powered, its wind pollinates the strawberries there to about 79% of a
            // full crop (Allen and Gaede via McGregor: 77% of flowers set under a fan, 97% brushed
            // daily; data/garden/pollination.ron `devices`). No source has a fan pollinate
            // tomatoes, peppers or eggplants indoors. Serves the grow machine nearest it. Not
            // placed in the seed design.
            stats: [(kind: "air", value: "wind over one grow machine", status: "ok"), (kind: "food", value: "strawberries set ~79%; not tomatoes", status: "ok")],
            power: Some(Consumer(watts: 11.0, priority: 4)),
        ),
