        // In-world screens (rung 2): displays that show a native app page on
        // one face. Same two defs as home.ron; place an instance and set its
        // screen_source ("page:inventory", "page:tasks", "watch:<stream>", ...) to choose
        // what it shows.
        // The bedroom's standing mirror: a full-height portrait display that is
        // also the look editor (walk up, press E). Same def as home.ron.
        "standing_mirror": (
            shape: "box", size: (1.0, 2.0, 0.08), color: (0.78, 0.83, 0.88),
            label: "Standing mirror",
            category: "Furniture",
            stats: [(kind: "display", value: "720 x 1280 mirror panel", status: "ok")],
            screen: Some((source: "profile", px: (720, 1280), face: "front", bezel_m: 0.03, brightness: 1.1)),
        ),
        "wall_screen": (
            shape: "box", size: (1.2, 0.7, 0.05), color: (0.08, 0.08, 0.1),
            label: "Wall screen",
            category: "Displays",
            stats: [(kind: "display", value: "1280 x 720 touchscreen", status: "ok")],
            screen: Some((source: "page:inventory", px: (1280, 720), face: "front", bezel_m: 0.02, brightness: 1.2)),
        ),
        "desk_monitor": (
            shape: "box", size: (0.6, 0.36, 0.04), color: (0.08, 0.08, 0.1),
            label: "Desk monitor",
            category: "Displays",
            stats: [(kind: "display", value: "1024 x 600 touchscreen", status: "ok")],
            screen: Some((source: "page:inventory", px: (1024, 600), face: "front", bezel_m: 0.015, brightness: 1.2)),
        ),
        // In-world screens (rung 3): a camera post, same def as home.ron. A
        // screen with screen_source "camera:<the post's instance id>" shows
        // what it sees. `camera` = (yaw, pitch, fov) degrees; the instance's
        // rotation adds to the yaw. `camera_px` = the size the camera renders
        // at (a quarter of a 1280 x 720 wall's pixels for about a quarter of
        // the cost; the wall stretches it; see home.ron).
        "camera_post": (
            shape: "box", size: (0.14, 1.7, 0.14), color: (0.2, 0.2, 0.22),
            label: "Camera post",
            category: "Displays",
            stats: [(kind: "display", value: "camera, 70 degree lens, 10 pictures a second", status: "ok")],
            camera: Some((0.0, -8.0, 70.0)),
            camera_px: (640, 360),
        ),
        "air_handler": (
            shape: "box", size: (1.831, 0.242, 0.56), color: (0.78, 0.8, 0.82),
            label: "Air handler (condensing coil)",
            category: "Life support",
            // A ducted chilled-water fan coil (Carrier 42CT size 14: at 50 Pa of
            // static pressure its "High" speed moves "1084" CFM, 1,842 m3/h, on
            // "325" W of "Power Input"; its cabinet is 1,831 x 560 x 242 mm), hung
            // under the ceiling with its coil on the station's cooling loop. While
            // powered it holds the air it stands in, a grow room's at 75% humidity
            // or the home's own at 50%, by condensing the water out of it on the
            // cold coil, and sends every litre back to the tanks through its water
            // line: the loop a closed habitat closes (data/life_support.ron has the
            // numbers and sources, docs/design/ship-life-support.md the balance).
            // The heat its coil takes goes to the station's radiators, which the
            // game does not model yet.
            dehumidifies_m3_h: 1842.0,
            stats: [(kind: "power", value: "325 W flat out, about 0.19 W per m3/h on its Low speed", status: "ok"), (kind: "water", value: "condensate back to the tanks", status: "ok"), (kind: "air", value: "holds a grow room at 75% humidity, the home's air at 50%", status: "ok")],
            // average_watts (2026-09-27): what the static power meter charges it
            // for a day, about 201 W a unit over a day at full planting (the five: greenhouse, court, home), measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(watts: 325.0, priority: 2, average_watts: Some(201.1))),
            ports: [
                (utility: Electricity, dir: In, label: "fan", watts: 325.0),
                (utility: Water, dir: Out, label: "condensate"),
            ],
            // Water leaving the coil is condensate, not drinking water: its line to the cistern carries ISO 14726's condensate marker (2026-10-04).
            outlet_media: {"water": "condensate"},
        ),
        "air_recycler": (
            shape: "box", size: (0.8, 1.2, 0.4), color: (0.55, 0.78, 0.82),
            label: "CO2 scrubber (molecular sieve)",
            category: "Life support",
            // The ISS's Carbon Dioxide Removal Assembly: a four-bed molecular sieve
            // that takes carbon dioxide out of the air and vents it overboard
            // (Hanford 2004, Table 7.3.2: peak "1,487" W, operational average "860"
            // W; Peters 2017: it removed "4.74 kg/day" of CO2 at a "267 Pa (2.0
            // torr)" inlet, more than 4 crew breathe out). It runs only above 2,636
            // ppm, BVAD 2022's coming 24-hour limit for a crew, cycling to hold it,
            // and takes a fixed share of the carbon dioxide in the air it draws
            // (data/life_support.ron). Below that the crops take the carbon dioxide
            // up. Until 2026-09-26 this was a 25 W "air recycler" that also made
            // oxygen; aboard, only the crops make oxygen (the Air loop below). Its
            // id is kept so its wiring stands.
            scrubs_co2_kg_day: 4.74,
            stats: [(kind: "power", value: "860 W while it runs, idle below 2,636 ppm of CO2", status: "warn"), (kind: "air", value: "takes CO2 overboard, up to 4.74 kg a day", status: "ok")],
            // average_watts (2026-09-27): what the static power meter charges it
            // for a day, idle: the crops hold the carbon dioxide far under its 2,636 ppm, measured by src/systems/farming/life_support_tests.rs
            // (which holds this figure to the measured draw).
            power: Some(Consumer(watts: 860.0, priority: 1, average_watts: Some(0.0))),
            ports: [
                (utility: Electricity, dir: In, label: "bed heaters + blower", watts: 860.0),
            ],
        ),
        "composter": (
            shape: "box", size: (0.7, 0.55, 0.7), color: (0.35, 0.25, 0.14),
