<?xml version="1.0" encoding="UTF-8"?>
<!-- The Ode to Joy theme (docs/design/score-player.md, rung 1; data/music/scores/index.ron plays it).
     Written by the HumanityOS project by hand from the melody as it is commonly sung: a simple
     version, not a transcription of any edition or file (Beethoven's own setting in his Ninth
     Symphony, 1824, differs in places, the third phrase's end among them). The words are the first
     verse of Friedrich Schiller's "An die Freude" as Beethoven set them (Schiller's revision of
     1803). The music is in D major in concert pitch; the app plays it at the person's tuning
     (A = 432 Hz unless they chose 440). The musical core is MEI Basic 5.1. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.1+basic">
  <meiHead>
    <fileDesc>
      <titleStmt>
        <title>Ode to Joy (the theme, a simple version)</title>
        <composer>Ludwig van Beethoven</composer>
        <lyricist>Friedrich Schiller</lyricist>
      </titleStmt>
      <pubStmt>
        <availability>Encoded by the HumanityOS project, 2026-11-20, and dedicated to the public domain under CC0 1.0 Universal, like the rest of the data folder. The melody (1824) and the words (1785, revised 1803) are long out of copyright.</availability>
      </pubStmt>
    </fileDesc>
  </meiHead>
