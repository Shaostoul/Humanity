// A taiko for the danger moods' ostinatos: the deep drum's skin struck harder with a heavier stick,
// so it rings shorter, brighter and with more of the strike.
Instrument(
    id: "taiko",
    words: "music.instrument.taiko",
    kind: Membrane((
        modes: [(1.0, 1.0, 1.3), (1.594, 0.5, 0.6), (2.136, 0.32, 0.45), (2.296, 0.3, 0.5), (2.653, 0.18, 0.35), (2.918, 0.14, 0.3)],
        pitch_drop: 0.1,
        pitch_drop_s: 0.05,
        noise: 0.5,
        noise_hz: 900.0,
        noise_decay_s: 0.03,
        attack_s: 0.003,
    )),
    level_db: -8.0,
    reverb_send: 0.25,
    pan_spread: 0.25,
)
