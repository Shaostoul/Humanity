// Electro swing's open hi-hat on every off-beat (the house "tss" between the kicks): high-passed
// noise ringing about a third of a second.
Instrument(
    id: "open_hat",
    words: "music.instrument.open_hat",
    kind: Noise((
        filter: (kind: HighPass, cutoff_hz: 7800.0, q: 0.7),
        envelope: (attack_s: 0.001, decay_s: 0.3, sustain: 0.0, release_s: 0.08),
    )),
    level_db: -20.0,
    reverb_send: 0.08,
    pan_spread: 0.2,
)
