// RETRO FM's snare (docs/design/music-page.md rung 3a; crate::fm_ops): the first operator fed back
// on itself so hard its sine breaks into noise (the rattle of the wires), heard beside a short
// falling tone (the drum's shell).
Instrument(
    id: "retro_fm_snare",
    words: "music.instrument.retro_fm_snare",
    kind: FmOps((
        ops: [
            (ratio: 3.0, level: 0.7, envelope: (attack_s: 0.001, decay_s: 0.22, sustain: 0.0, release_s: 0.05), out: true),
            (ratio: 1.0, level: 0.5, envelope: (attack_s: 0.001, decay_s: 0.14, sustain: 0.0, release_s: 0.04), out: true),
        ],
        feedback: 11.0,
        pitch_drop: Some((5.0, 0.02)),
    )),
    level_db: -12.0,
    reverb_send: 0.12,
)
