// RETRO FM's flute (docs/design/music-page.md rung 3a; crate::fm_ops): an almost pure sine with a
// light 1:1 modulation at the breath of its attack and a wide, slow vibrato. It plays flutes,
// piccolos and recorders.
Instrument(
    id: "retro_fm_flute",
    words: "music.instrument.retro_fm_flute",
    kind: FmOps((
        ops: [
            (ratio: 1.0, level: 0.7, envelope: (attack_s: 0.05, decay_s: 0.3, sustain: 0.4, release_s: 0.1), velocity: 0.5),
            (ratio: 1.0, level: 0.8, envelope: (attack_s: 0.05, decay_s: 1.0, sustain: 0.9, release_s: 0.12), mods: [0], out: true),
        ],
        vibrato: Some((5.2, 12.0)),
    )),
    level_db: -14.0,
    reverb_send: 0.2,
)
