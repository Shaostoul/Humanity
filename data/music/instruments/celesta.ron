// Celesta-like bells by modal synthesis: decaying partials at slightly stretched ratios (the
// sketch's bells). Also the alarm figure of the danger moods.
Instrument(
    id: "celesta",
    words: "music.instrument.celesta",
    kind: Modal((
        partials: [(1.0, 1.0, 3.2), (2.003, 0.32, 2.0), (3.01, 0.13, 1.2), (4.17, 0.07, 0.8), (5.43, 0.04, 0.5), (6.8, 0.02, 0.35)],
        attack_s: 0.004,
        decay_pitch_scale: 0.2,
    )),
    level_db: -14.0,
    reverb_send: 0.75,
    pan_spread: 0.2,
)
