        (id: "accordion", words: "instrument_packs.part.accordion", synth: (kind: "synth", preset: "soft_saw_pad"), sustained: true, not_used_yet: true),
        (id: "ukulele", words: "instrument_packs.part.ukulele", synth: (kind: "plucked", preset: "harp"), not_used_yet: true),
