        (id: "jazz_guitar", words: "instrument_packs.part.jazz_guitar", synth: (kind: "plucked", preset: "jazz_guitar"), fallback_part: Some("guitar"), not_used_yet: true),
        (id: "honky_tonk_piano", words: "instrument_packs.part.honky_tonk_piano", synth: (kind: "fm", preset: "electric_piano"), fallback_part: Some("piano")),
        (id: "electric_piano", words: "instrument_packs.part.electric_piano", synth: (kind: "fm", preset: "electric_piano")),
        (id: "alto_sax", words: "instrument_packs.part.alto_sax", synth: (kind: "synth", preset: "clarinet"), sustained: true, not_used_yet: true),
        (id: "baritone_sax", words: "instrument_packs.part.baritone_sax", synth: (kind: "synth", preset: "clarinet"), sustained: true, not_used_yet: true),
        (id: "tuba", words: "instrument_packs.part.tuba", synth: (kind: "synth", preset: "swing_horns")),
        (id: "bagpipe", words: "instrument_packs.part.bagpipe", synth: (kind: "synth", preset: "drone"), sustained: true, not_used_yet: true),
        (id: "choir_soprano", words: "instrument_packs.part.choir_soprano", synth: (kind: "choir", preset: "choir_ah"), sustained: true),
