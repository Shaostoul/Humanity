// "Lo-fi", the first extra genre (docs/design/music.md, section 7a): the genre seam's working rung.
// Chosen before electroswing or dubstep because the default world is calm and lo-fi is calm too
// (70 to 82 bpm), and because every timbre it needs synthesises well here (an FM electric piano, a
// round plucked bass, soft synthesised drums, vinyl crackle, tape wow): electroswing leans on recorded
// swing-era brass and clarinet, and dubstep's drop on a loud, dense mix, so both wait for later rungs.
// Swung sixteenths, a lazy backbeat, the electric piano comping on a pattern, the bass on its own,
// seventh chords on every chord, one or two bars each, a worn-tape low-pass, wow and saturation, a
// drier room. The choir, the drone and the deep drums step out.
//
// Recorded instruments where they are installed (2026-11-07, BUG-266; data/music/parts.ron): the
// comping keys are the piano part (the core set's upright, a grand from the keys pack), the lead
// the guitar part (the guitars pack's hollowbody electrics, the soft lead without it), and the
// melody the handpan part, low (D3 to A4, the Hang's own nine notes): the percussion pack's Hang
// where it has the note, the steel pan for the rest and without the pack. Each falls back to the
// synthesised voice named beside it.
Genre(
    id: "lofi",
    words: "music.genre.lofi",
    about_words: "music.genre.lofi_about",
    tempo_bpm: Some((70.0, 82.0)),
    beat_felt: Some(true),
    groove: Some((swing: 0.6, subdivision: 4, syncopation: 0.2, humanize_ms: 9.0)),
    // The kit a piece draws (2026-11-13, the genre pass): the soft drum machine, or a JAZZ KIT played
    // with sticks (the "Brushes and jazz drum kits" pack's kick, snare and hi-hat, the drum machine's
    // voices standing in until it is installed), both on the same lazy boom-bap patterns; or (rung E4,
    // 2026-11-14) the 808-STYLE drum machine: its long boom of a kick, its snare, its closed hat and
    // now and then its open hat (choked by the next closed one), as hip-hop's lo-fi beats use it.
    kits: [(id: "machine", weight: 1.0), (id: "jazz", weight: 1.0), (id: "808", weight: 1.0)],
    drums: [
        (instrument: "lofi_kick", note: "A1", velocity: 0.9, patterns: ["x.........x.....", "x......x..x.....", "x.........x..x.."], kit: Some("machine")),
        (instrument: "lofi_snare", note: "D3", velocity: 0.7, patterns: ["....x.......x...", "....x.......x..g"], kit: Some("machine")),
        (instrument: "lofi_hat", note: "D5", velocity: 0.45, patterns: ["x.x.x.x.x.x.x.x.", "x.xgx.x.x.xgx.x.", "x.x.x.xxx.x.x.x."], kit: Some("machine")),
        (instrument: "lofi_kick", part: Some("kit_kick"), note: "A1", velocity: 0.85, patterns: ["x.........x.....", "x......x..x.....", "x.........x..x.."], kit: Some("jazz")),
        (instrument: "lofi_snare", part: Some("kit_snare"), note: "D3", velocity: 0.6, patterns: ["....x.......x...", "....x.......x..g"], kit: Some("jazz")),
        (instrument: "lofi_hat", part: Some("kit_hihat_closed"), note: "D5", velocity: 0.4, patterns: ["x.x.x.x.x.x.x.x.", "x.xgx.x.x.xgx.x.", "x.x.x.xxx.x.x.x."], kit: Some("jazz")),
        (instrument: "kick_808", note: "A1", velocity: 0.85, patterns: ["x.........x.....", "x......x..x.....", "x.........x..x.."], kit: Some("808")),
        (instrument: "snare_808", note: "D3", velocity: 0.7, patterns: ["....x.......x...", "....x.......x..g"], kit: Some("808")),
        (instrument: "hat_808_closed", note: "D5", velocity: 0.5, patterns: ["x.x.x.x.x.x.x...", "x.xgx.x.x.xgx...", "x.x.x.xxx.x.x..."], kit: Some("808")),
        (instrument: "hat_808_open", note: "D5", velocity: 0.4, patterns: ["..............x.", "..............x.", "......x.......x."], kit: Some("808")),
    ],
    pad_patterns: ["x.........x....."],
    bass_patterns: ["x.......5.....x."],
    harmony: (sevenths: true, chord_bars: Some((1, 2))),
    // A piece's sections are eight bars, in one of these forms (docs/design/music.md section 7c).
    phrase_bars: Some([8]),
    forms: [(form: "AABA", weight: 2.0), (form: "ABAB", weight: 1.5), (form: "AABB", weight: 1.0)],
    // What comps, by the piece (2026-11-13): the piano, or an ELECTRIC PIANO (the credited "Electric
    // pianos" pack's Wurlitzer, Yamaha CP80 or Hohner Pianet, the keys pack's FM piano, the FM
    // electric piano synthesised until one is installed), in the ship's pad register.
    leads: [
        (role: Pad, instrument: "electric_piano", part: Some("piano"), low: "B2", high: "B4", voices: 5, weight: 1.0),
        (role: Pad, instrument: "electric_piano", part: Some("electric_piano"), low: "B2", high: "B4", voices: 5, weight: 1.0),
    ],
    palette: [
        (role: Bells, instrument: "soft_lead", level_db: -2.0, part: Some("guitar")),
        (role: Melody, instrument: "steel_pan", part: Some("handpan"), low: Some("D3"), high: Some("A4")),
    ],
    roles_off: [Choir, Drone, Percussion],
    roles_add: [
        (role: Bass, instrument: "round_bass", low: "G1", high: "G2"),
        (role: Texture, instrument: "vinyl_crackle", low: "C4", high: "C4"),
    ],
    recipe: (wow_cents: 7.0, wow_hz: 0.45, flutter_cents: 1.5, flutter_hz: 6.0, lowpass_hz: 5200.0, saturation: 0.25, reverb_scale: 0.45),
    level_db: 4.9,
)
