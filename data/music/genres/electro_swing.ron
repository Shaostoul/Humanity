// "Electro swing" (docs/design/music.md, section 7a). The operator, 2026-11-12: "for the procedural
// music, let's add a genre selector. That way we can change how it sounds. I'd like to hear how the
// math interprets electro swing music similar to the band Caravan Palance." and "Let's have ours be
// 128bpm".
//
// What is captured is the GENRE's character, never a band's recordings, melodies or lyrics (those
// are copyrighted; a style of music is not): swing-era jazz laid over house music. So: 128 bpm with
// swung eighths (the second eighth of each beat lands at 0.64 of it, between straight 0.5 and a
// triplet's 0.667); a four-on-the-floor house kick, a clap on 2 and 4, an open hi-hat on every
// off-beat and a jazz ride's "ding, ding-a ding" on the closed hat; an upright bass that walks
// (chord tones and passing notes on every beat, a half step into each new chord) or plays a two-feel
// (root and fifth); a gypsy-jazz (manouche) guitar's "la pompe" comping, a short strummed chop on
// every beat with 2 and 4 accented; brass stabs pushing the off-beats; clarinet lines CALLING and
// the brass ANSWERING the bar after (call and response), their riffs in the minor blues scale;
// minor-key jazz harmony in D minor (so the ship's hum stays in tune with it): minor sixth chords,
// ii-V-i (E half-diminished, A7 or A7 flat nine, D minor six), diminished passing chords (D sharp
// diminished between D minor and E half-diminished, C sharp diminished leading home), the iv chord,
// a secondary dominant into it, and the B flat seven sliding into A7; each phrase at its own
// dynamic level, a little vinyl crackle and a drier, punchier room than the ship's halls.
//
// Instruments: the house drums are electronic, so synthesis is the genuine article. The clarinet,
// the brass, the upright bass and the guitar are parts of the score (data/music/parts.ron): each
// plays the best recording installed for its part and a synthesised stand-in without one, as
// Settings > Music says.
Genre(
    id: "electro_swing",
    words: "music.genre.electro_swing",
    about_words: "music.genre.electro_swing_about",
    tempo_bpm: Some((128.0, 128.0)),
    beat_felt: Some(true),
    beats_per_bar: Some(4),
    groove: Some((swing: 0.64, subdivision: 2, syncopation: 0.08, humanize_ms: 4.0)),
    // The kit a piece draws (2026-11-13, the genre pass): the house kit (a clap, an open hat on the
    // off-beats, the ride's pattern on a closed hat), or the BRUSHES of a swing-era drummer (a
    // brushed snare on 2 and 4, the brush stirring on every beat, the ride played with brushes, the
    // hi-hat's foot on 2 and 4). The house kick plays four on the floor under either: that is the
    // electro in electro swing. The brushes are recordings once the "Brushes and jazz drum kits"
    // pack is installed, synthesised stand-ins until then. Or (rung E4, 2026-11-14) the 909-STYLE
    // drum machine, house music's own: its punchy kick four on the floor in place of the house kick,
    // its clap on 2 and 4, its open hat on the off-beats and its closed hat on the ride's pattern.
    // Listed first, so the pieces that drew the brushes before it existed still draw them (a piece's
    // kit is its seed's draw across the weights in this order).
    kits: [(id: "909", weight: 1.0), (id: "house", weight: 2.0), (id: "brushes", weight: 1.0)],
    drums: [
        (instrument: "house_kick", note: "A1", velocity: 0.95, patterns: ["x.x.x.x.", "x.x.x.x.", "x.x.x.xo"], kits: ["house", "brushes"]),
        (instrument: "clap", note: "D3", velocity: 0.7, patterns: ["..x...x.", "..x...x.", "..x...xg"], kit: Some("house")),
        (instrument: "open_hat", note: "D5", velocity: 0.5, patterns: [".x.x.x.x"], kit: Some("house")),
        (instrument: "lofi_hat", note: "D5", velocity: 0.35, patterns: ["x.xxx.xx", "x.xxx.x.", "x.x.x.xx"], kit: Some("house")),
        (instrument: "brush_swish", part: Some("brush_snare"), note: "D3", velocity: 0.75, patterns: ["..x...x.", "..x...x.", "..x...xg"], kit: Some("brushes")),
        (instrument: "brush_stir", part: Some("brush_stir"), note: "D3", velocity: 0.45, patterns: ["x.x.x.x."], kit: Some("brushes")),
        (instrument: "open_hat", part: Some("brush_ride"), note: "D5", velocity: 0.4, patterns: ["x.xxx.xx", "x.xxx.x.", "x.x.x.xx"], kit: Some("brushes")),
        (instrument: "lofi_hat", part: Some("brush_hihat"), note: "D5", velocity: 0.35, patterns: ["..x...x."], kit: Some("brushes")),
        (instrument: "kick_909", note: "A1", velocity: 0.9, patterns: ["x.x.x.x.", "x.x.x.x.", "x.x.x.xo"], kit: Some("909")),
        (instrument: "clap_909", note: "D3", velocity: 0.7, patterns: ["..x...x.", "..x...x.", "..x...xg"], kit: Some("909")),
        (instrument: "hat_909_open", note: "D5", velocity: 0.5, patterns: [".x.x.x.x"], kit: Some("909")),
        (instrument: "hat_909_closed", note: "D5", velocity: 0.35, patterns: ["x...x...", "x...x..x", "x.x.x..."], kit: Some("909")),
    ],
    pad_patterns: ["o.x.o.x.", "o.xgo.xg", "o.x.o.xg"],
    comping: (strum_ms: 9.0, hold_beats: 0.3),
    bass_patterns: ["w.w.w.w.", "w.w.w.w.", "x...5..."],
    stab_patterns: ["...x...x", ".......x", "x..x....", "..x...x."],
    stab_hold_beats: 0.3,
    progressions: Some((
        // The keys a piece may be in (a piece draws one by weight; its bridge may move to another).
        // The ship's hum follows whatever key plays.
        keys: [
            (root: "D", mode: HarmonicMinor, weight: 1.0), (root: "G", mode: HarmonicMinor, weight: 0.8), (root: "A", mode: HarmonicMinor, weight: 0.7),
            (root: "C", mode: HarmonicMinor, weight: 0.6), (root: "E", mode: HarmonicMinor, weight: 0.5), (root: "F", mode: HarmonicMinor, weight: 0.4),
        ],
        chords: [
            (name: "i6", root: 0, notes: [0, 3, 7, 9]),
            (name: "i_minmaj7", root: 0, notes: [0, 3, 7, 11]),
            (name: "iv_m7", root: 5, notes: [0, 3, 7, 10]),
            (name: "VI_maj7", root: 8, notes: [0, 4, 7, 11]),
            (name: "iv6", root: 5, notes: [0, 3, 7, 9]),
            (name: "ii_half_dim", root: 2, notes: [0, 3, 6, 10]),
            (name: "V7", root: 7, notes: [0, 4, 7, 10]),
            (name: "V7b9", root: 7, notes: [0, 4, 7, 10, 13]),
            (name: "bVI7", root: 8, notes: [0, 4, 7, 10]),
            (name: "V7_of_iv", root: 0, notes: [0, 4, 7, 10]),
            (name: "dim_passing", root: 1, notes: [0, 3, 6, 9]),
            (name: "dim_leading", root: 11, notes: [0, 3, 6, 9]),
        ],
        moves: [
            ("i6", "iv6", 3.0), ("i6", "ii_half_dim", 2.0), ("i6", "dim_passing", 1.5), ("i6", "V7_of_iv", 1.5), ("i6", "bVI7", 1.0), ("i6", "V7", 1.0),
            ("iv6", "i6", 2.0), ("iv6", "ii_half_dim", 2.0), ("iv6", "V7", 2.0), ("iv6", "bVI7", 1.0),
            ("ii_half_dim", "V7", 4.0), ("ii_half_dim", "V7b9", 2.0),
            ("V7", "i6", 5.0), ("V7", "dim_leading", 1.0),
            ("V7b9", "i6", 5.0),
            ("bVI7", "V7", 4.0),
            ("V7_of_iv", "iv6", 4.0),
            ("dim_passing", "ii_half_dim", 3.0),
            ("dim_leading", "i6", 3.0),
            ("i6", "i_minmaj7", 1.0), ("i_minmaj7", "iv6", 2.0), ("i_minmaj7", "ii_half_dim", 1.5), ("i_minmaj7", "iv_m7", 1.0),
            ("iv_m7", "V7", 2.0), ("iv_m7", "i6", 1.5), ("iv6", "VI_maj7", 0.8), ("VI_maj7", "ii_half_dim", 2.0), ("VI_maj7", "V7", 2.0),
        ],
        cadences: ["i6", "V7"],
        start: "i6",
        // A piece's chord walk (docs/design/music.md section 7c): each section of its form is
        // generated from this grammar rather than walked from the moves above. A SHAPE is a run of
        // functions (T the tonic, S the subdominant side, D the dominant), each slot one chord of
        // that function, the last a cadence; then the embellishments of swing-era harmony, each with
        // its chance: a secondary dominant (the seventh chord a fifth above the chord that follows,
        // in the last bar of the chord before), a tritone substitute (a dominant played as the
        // seventh chord a tritone away, sliding down a half step into its target) and a passing
        // diminished chord (a half step under the chord that follows). These are the commonplace
        // building blocks of the style, never any tune's own changes.
        grammar: Some((
            functions: [
                ("i6", Tonic), ("i_minmaj7", Tonic), ("iv6", Subdominant), ("iv_m7", Subdominant), ("ii_half_dim", Subdominant),
                ("bVI7", Subdominant), ("VI_maj7", Subdominant), ("V7", Dominant), ("V7b9", Dominant),
            ],
            shapes: [
                ("T S D T", 3.0), ("T T S D", 2.0), ("T S T D", 1.5), ("T D T D", 1.0), ("T S S D", 1.0), ("S D T T", 0.8), ("T T D D", 0.6), ("T S D D", 0.8),
            ],
            secondary_dominants: 0.3,
            tritone_substitutes: 0.2,
            passing_diminished: 0.25,
        )),
    )),
    // A piece's sections are eight bars each (the swing era's 32-bar song is four of them), and its
    // FORM, by weight: the order they play in, a letter a section. A letter that returns plays its
    // chords again, and its tune the first time through the form; after that the band improvises
    // over the same chords until the next piece.
    phrase_bars: Some([8]),
    forms: [(form: "AABA", weight: 3.0), (form: "ABAB", weight: 1.5), (form: "AABB", weight: 1.0), (form: "ABAC", weight: 1.0)],
    harmony: (chord_bars: Some((1, 2))),
    motif_scale: Some(Blues),
    // Each piece makes its own riffs from these rules (the motifs below are what plays without
    // them): how many, how many notes each, rhythm cells in beats strung together, the melodic
    // contours a riff may take by weight, its steps in the minor blues scale (mostly steps of one
    // or two, now and then a leap), how far from its starting chord tone it may go, and how much of
    // each note sounds.
    motif_rules: Some((
        count: 5,
        notes: (3, 6),
        cells: [[0.5, 0.5], [1.0], [0.5, 0.5, 1.0], [1.0, 0.5, 0.5], [0.5, 1.0, 0.5], [1.5, 0.5], [0.5, 0.5, 0.5, 0.5]],
        contours: [(Rise, 1.0), (Fall, 1.5), (Arch, 1.5), (Valley, 1.0), (Hover, 0.8), (Zigzag, 0.6)],
        leap: 0.15,
        range: (-3, 6),
        hold: (0.45, 0.85),
    )),
    // The voices a piece chooses for its melody (the call) and its answer, by weight, from what the
    // core set plays: the clarinet, the hot-club violin, the tenor saxophone, the vibraphone and the
    // piano call; the trombone, the violin and the trumpet answer (never the same voice as the call).
    leads: [
        (role: Melody, instrument: "clarinet", part: Some("clarinet"), low: "D4", high: "D6", density: 0.65, level_db: 4.0, weight: 2.0),
        (role: Melody, instrument: "soft_lead", part: Some("solo_violin"), low: "G4", high: "D6", density: 0.65, level_db: 4.0, weight: 1.5),
        (role: Melody, instrument: "clarinet", part: Some("tenor_saxophone"), low: "D3", high: "D5", density: 0.6, level_db: 4.0, weight: 1.5),
        (role: Melody, instrument: "celesta", part: Some("vibraphone"), low: "F4", high: "F6", density: 0.6, level_db: 2.0, weight: 1.0),
        (role: Melody, instrument: "electric_piano", part: Some("piano"), low: "D4", high: "D6", density: 0.6, level_db: 2.0, weight: 1.0),
        (role: Bells, instrument: "swing_horns", part: Some("trombone"), low: "D3", high: "D5", density: 0.5, level_db: 2.0, weight: 2.0),
        (role: Bells, instrument: "soft_lead", part: Some("solo_violin"), low: "G4", high: "D6", density: 0.5, level_db: 2.0, weight: 1.0),
        (role: Bells, instrument: "swing_horns", part: Some("trumpet"), low: "F4", high: "D6", density: 0.5, level_db: 2.0, weight: 1.0),
        // What comps (2026-11-13): the gypsy-jazz guitar's la pompe, or a honky-tonk piano's
        // chop (the "Band and jazz" pack's; the core set's upright piano plays it until then).
        (role: Pad, instrument: "jazz_guitar", part: Some("acoustic_guitar"), low: "D3", high: "D5", voices: 4, weight: 2.0),
        (role: Pad, instrument: "electric_piano", part: Some("honky_tonk_piano"), low: "D3", high: "D5", voices: 4, weight: 1.0),
        // What holds the bottom: the upright bass, or a TUBA (the swing era's first bass, before
        // the string bass took over), walking or playing two to the bar; the "Band and jazz" pack's
        // tuba, a synthesised brass stand-in until it is installed.
        (role: Bass, instrument: "upright_bass", part: Some("double_bass_pizzicato"), low: "E1", high: "D3", weight: 2.0),
        (role: Bass, instrument: "swing_horns", part: Some("tuba"), low: "D1", high: "D3", weight: 1.0),
    ],
    // Short riffs: scale steps of the minor blues from a chord tone, lengths in beats (an off-beat
    // lands swung), and how much of each length the note sounds (short and punched, or held).
    motifs: [
        (steps: [0, 1, 2, 1, 0], beats: [0.5, 0.5, 0.5, 0.5, 1.0], hold: [0.7, 0.7, 0.7, 0.7, 0.6]),
        (steps: [0, 2, 4, 3], beats: [0.5, 0.5, 1.0, 1.0], hold: [0.8, 0.8, 0.5, 0.8]),
        (steps: [4, 3, 2, 0], beats: [1.0, 0.5, 0.5, 1.0], hold: [0.5, 0.8, 0.8, 0.7]),
        (steps: [0, 0, 2, 0], beats: [0.5, 1.0, 0.5, 1.0], hold: [0.5, 0.4, 0.8, 0.6]),
        (steps: [2, 1, 0, -1, 0], beats: [0.5, 0.5, 0.5, 0.5, 2.0], hold: [0.8, 0.8, 0.8, 0.8, 0.7]),
        (steps: [0, 3, 2, 3, 4], beats: [0.5, 0.5, 0.5, 0.5, 1.0], hold: [0.6, 0.6, 0.6, 0.6, 0.5]),
    ],
    call_and_response: true,
    dynamics: Some((0.75, 1.0)),
    roles_off: [Drone, Percussion],
    roles_add: [
        (role: Pad, instrument: "jazz_guitar", part: Some("acoustic_guitar"), low: "D3", high: "D5", voices: 4),
        (role: Bass, instrument: "upright_bass", part: Some("double_bass_pizzicato"), low: "E1", high: "D3"),
        (role: Choir, instrument: "swing_horns", part: Some("trumpet"), low: "F3", high: "D5", voices: 3, density: 0.6, level_db: 4.0),
        (role: Melody, instrument: "clarinet", part: Some("clarinet"), low: "D4", high: "D6", density: 0.65, level_db: 4.0),
        (role: Bells, instrument: "swing_horns", part: Some("trombone"), low: "D3", high: "D5", density: 0.5, level_db: 2.0),
        (role: Texture, instrument: "vinyl_crackle", low: "C4", high: "C4", level_db: -6.0),
    ],
    recipe: (wow_cents: 2.0, wow_hz: 0.55, flutter_cents: 0.5, flutter_hz: 7.0, saturation: 0.15, reverb_scale: 0.5),
    level_db: 1.6,
)
