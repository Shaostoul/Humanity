        // =====================================================================
        // PROFILES ADDED 2026-09-25 (34)
        //
        // Added when data/food/item_profiles.ron replaced the id-prefix guesses,
        // because the first twelve rows could not describe these foods honestly
        // (a potato is not 25 kcal, a cheese is not 98, a loaf of bread does
        // not keep for a year). Each row names the ONE real food its numbers
        // are copied from. A row stands for a group, so the note says which
        // members sit furthest from the base food; every member is within a
        // factor of two on calories unless the note says otherwise.
        // =====================================================================

        // --- Vegetables ---

        // Base: USDA SR Legacy NDB 11124 "Carrots, raw".
        // Keeps: FoodKeeper carrots and parsnips 2-3 weeks refrigerated,
        // turnips 2 weeks, beets 1-2 weeks, onions 1 month in the pantry.
        // Furthest members: ginger 80 kcal, parsnip 75 (1.9x the base).
        (
            id: "root_vegetables",
            name: "Root Vegetables",
            category: "produce",
            calories_per_100g: 41,
            protein_g: 0.93,
            carbs_g: 9.58,
            fat_g: 0.24,
            fiber_g: 2.8,
            vitamins: (A: 0.93, B: 0.05, C: 0.07, D: 0.0, E: 0.04, K: 0.11),
            minerals: (iron: 0.3, calcium: 33.0, zinc: 0.24, potassium: 320.0),
            spoilage_rate_hours: 336.0,
            raw_consumption_risk: 0.02,
            description: "Carrots, beets, turnips, onions, leeks and other firm roots and bulbs. They keep for weeks, not days.",
        ),

        // Base: USDA SR Legacy NDB 11601 "Yam, raw" (118 kcal), chosen from the
        // middle of the group so every member is within a factor of two:
        // potato 77, sweet potato 86, taro 112, plantain (green) 152, garlic
        // 149, chestnut 213 (1.8x), oca 62 (0.5x).
        // Keeps: FoodKeeper yams and sweet potatoes 2-3 weeks in the pantry,
        // potatoes 1-2 months. Sweet corn (1-2 days refrigerated) and
        // breadfruit spoil far faster than this row says.
        // Raw risk: most of these are cooked before eating; taro must be
        // cooked to break down its calcium oxalate.
        (
            id: "starchy_vegetables",
            name: "Starchy Vegetables",
            category: "produce",
            calories_per_100g: 118,
            protein_g: 1.53,
            carbs_g: 27.88,
            fat_g: 0.17,
            fiber_g: 4.1,
            vitamins: (A: 0.01, B: 0.06, C: 0.19, D: 0.0, E: 0.02, K: 0.02),
            minerals: (iron: 0.54, calcium: 17.0, zinc: 0.24, potassium: 816.0),
            spoilage_rate_hours: 336.0,
            raw_consumption_risk: 0.05,
            description: "Potatoes, yams, taro, sweet corn, plantains, chestnuts and other starchy staples, usually cooked before eating.",
        ),

        // Base: USDA SR Legacy NDB 11134 "Cassava, raw".
        // Keeps: FoodKeeper yuca/cassava 7 days in the pantry. Fresh roots
        // start to discolour and rot within a few days of harvest.
        // Raw risk: the roots must be peeled and cooked (sweet varieties) or
        // soaked, fermented or dried (bitter varieties) to drive off cyanide;
        // plants.csv says the same.
        (
            id: "cassava",
            name: "Cassava Root",
            category: "produce",
            calories_per_100g: 160,
            protein_g: 1.36,
            carbs_g: 38.06,
            fat_g: 0.28,
            fiber_g: 1.8,
            vitamins: (A: 0.0, B: 0.05, C: 0.23, D: 0.0, E: 0.01, K: 0.02),
            minerals: (iron: 0.27, calcium: 16.0, zinc: 0.34, potassium: 271.0),
            spoilage_rate_hours: 168.0,
            raw_consumption_risk: 0.30,
            description: "Fresh cassava root. A staple for hundreds of millions of people, but it must be processed before eating and it spoils within days of digging.",
        ),

        // --- Legumes, nuts and seeds ---

        // Base: USDA SR Legacy NDB 16027 "Beans, kidney, all types, mature
        // seeds, raw". Furthest member: soybean 446 kcal (1.3x, and far more fat).
        // Keeps: FoodKeeper dried beans 1-2 years, dried lentils 1 year, dried
        // split peas 1 year.
        // Raw risk: dry beans have to be soaked and boiled hard. Eaten raw or
        // undercooked they cause severe stomach illness (FDA Bad Bug Book,
        // kidney bean lectin), and lupins need their bitter alkaloids leached.
        (
            id: "legumes_dry",
            name: "Dried Legumes",
            category: "staple",
            calories_per_100g: 333,
            protein_g: 23.58,
            carbs_g: 60.01,
