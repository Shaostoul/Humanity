// HumanityOS SHIP'S CREW roster (infinite-of-x, v0.937: was a hardcoded match in
// src/relay/handlers/game_state.rs). One entry per crew member. Since increment 3 of
// docs/design/ship-homes-and-logistics.md they crew the mothership's shared places, not the
// retired Pioneer: the relay's world is the ship file (src/relay/handlers/ship_world.rs).
// Edit or add crew here - dialog lines rotate on interaction, greetings fire the first time a
// player enters the crew member's post. The chore system (data/npc/chores.ron) drives what
// they DO; this file is who they ARE. Disk-first with an embedded fallback, so a zero-file
// install still has a crew.
//
// Fields:
//   post        the room they belong to: a room id of the relay's world ("commons",
//               "mess-hall", "street-1"). They start at work on the first site of their chore
//               rotation, and a player's first visit to their post earns their greeting.
//   npc_type    the entity type AI agents see ("navigator", "medic", ...)
//   role        which chores they do (chores.ron `roles`)
//   eats        (default true) whether they eat: an eater comes to the mess hall when a meal is
//               due and takes it from the ship's food stores, the same stock players take
//               theirs from (data/food/ship_stores.ron). A bot does not eat.
//   household   (default "crew") where their meals come from: "crew" is the ship's company,
//               every meal from the stores; "homestead" is an NPC household on a homestead,
//               which mostly feeds itself (`npc_homestead_self_provided` in ship_stores.ron).
//               Every crew member below is ship's company.
[
    (
        post: "commons",
        npc_type: "navigator",
        name: "Helm Officer Vex",
        role: "navigator",
        description: "Off the helm, keeping the ship's notices",
        household: "crew",
        dialog: [
            "On a cruise this long the helm mostly flies itself. I keep the notices instead.",
            "If you see a notice that is out of date, flag me.",
            "First Street gets busy at meal times. Mind the corner by the Commons door.",
            "I'd kill for a fresh atlas. Real paper. Stars don't move that fast.",
        ],
        greetings: [
            "Welcome to the Commons. The notices are on the board.",
            "Mind the cabling, citizen.",
        ],
    ),
    (
        post: "commons",
        npc_type: "medic",
        name: "Dr. Kel",
        role: "medical_officer",
        description: "Holding the clinic hour in the Commons",
        household: "crew",
        dialog: [
            "If you're hurt, sit down. If you're not, don't touch anything.",
            "Medkits are in the cabinet. They are not snacks.",
            "Eat at the mess hall. Skipped meals are half my patients.",
            "I patched up worse than you yesterday. Stay still.",
        ],
        greetings: [
            "Clinic hour. State your symptom, briefly.",
            "You look pale. Drink some water.",
        ],
    ),
    (
        post: "commons",
        npc_type: "engineer",
        name: "Chief Tan",
        role: "chief_engineer",
        description: "Keeping the Commons' air and water running",
        household: "crew",
        dialog: [
            "The air handlers are humming. Don't tap the vents.",
            "If a panel is hot, I already know. Walk away.",
            "The plumbing under First Street is fixed. Try it before you complain again.",
            "We keep this ship alive on duct tape and hope. Mostly hope.",
        ],
        greetings: [
            "Keep your hands off the valves, please.",
            "Welcome. The fans whine. That's normal.",
        ],
    ),
    (
        post: "mess-hall",
        npc_type: "maintenance_bot",
        name: "CB-7",
        role: "maintenance",
        description: "Autonomous bot keeping the mess hall stocked",
        eats: false,
        household: "crew",
        dialog: [
            "[CB-7] Stores reconciled. Variance: zero.",
            "[CB-7] Tables wiped. Resuming patrol.",
            "[CB-7] Crate 19-A misaligned. Correcting.",
            "[CB-7] Greetings, citizen. Please do not block the serving counter.",
        ],
        greetings: [
            "[CB-7] Citizen detected. Logging entry.",
            "[CB-7] Welcome to the mess hall. Please mind the trolley.",
        ],
    ),
    (
        post: "commons",
        npc_type: "botanist",
        name: "Botanist Yara",
        role: "botanist",
        description: "Tending the Commons garden",
        household: "crew",
        dialog: [
            "These tomatoes are six weeks ahead of schedule. Look at them.",
            "Don't touch the green tray. I'm trialing a new nutrient mix.",
            "Lettuce harvest in three days. Tell the mess hall.",
            "Plants do better when you talk to them. I'm not joking.",
        ],
        greetings: [
            "Welcome! Mind the spore filter by the towers.",
            "Quiet, please. The seedlings are sensitive.",
        ],
    ),
    (
        post: "mess-hall",
        npc_type: "crewmate",
        name: "Crewmate Nia",
        role: "off_duty",
        description: "Off shift in the mess hall",
        household: "crew",
        dialog: [
            "Off-shift. Quiet hour. Whisper if you must.",
            "Cycled through three novels this rotation. Got a recommendation?",
            "The mess hall's stew is better than it sounds.",
            "Wake me at 06:00 ship-time. Not earlier.",
        ],
        greetings: [
            "Hey. Off-shift, but pull up a chair.",
            "The stores are by the serving counter if you're hungry.",
        ],
    ),
]
