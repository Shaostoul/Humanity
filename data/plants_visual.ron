            leaf_count: 14, leaf_color: (0.12, 0.35, 0.14), leaf_droop_deg: 8.0,
            petal_count: 5, flower_color: (0.98, 0.97, 0.92), flower_center_color: (0.95, 0.85, 0.4),
            flower_at: 0.45, fruit_at: 0.7,
            fruit_kind: "sphere", fruit_size: 0.075, fruit_count: 5,
            fruit_color_unripe: (0.35, 0.55, 0.25), fruit_color_ripe: (0.95, 0.55, 0.1),
            show_roots: false,
        ),
        // Lemon: like orange but lighter foliage and yellow fruit.
        "lemon": (
