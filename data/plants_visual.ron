// Procedural plant appearance definitions (v0.862). Each entry is the FULL
// visual recipe for a species: src/renderer/plant_mesh.rs turns these numbers
// into a 3D model at any growth stage. Edit this file while the game runs and
// the plants regenerate live (hot reload). Colors are linear RGB 0..1.
//
// forms: rosette | herb | vine | tree | bulb | bromeliad (unknown -> rosette)
// flower_at / fruit_at: growth fraction (0..1) where flowers/fruit appear.
(
    // Plants drawn per garden plot (2026-09-26). A bed, tray or field plot
    // holds as many plants as its floor fits at the crop's spacing
    // (plants.csv area_per_plant_m2), and the farm harvests, feeds and waters
    // that many. The garden draws every one of them, in rows at that spacing,
    // up to this many per plot. A plot that holds more (a 1.44 m2 field plot
    // of wheat is 480 plants) is drawn as this many clumps instead, each
    // standing for the plants whose floor it covers and drawn that much
    // wider, never taller: a cereal plot reads as a stand, not a count.
    // Why 128: wheat stands 5.5 cm apart, so its 480 plants on a 1.2 m plot
    // drawn as 128 clumps put one every 10.6 cm at 1.9 times a stalk's
    // width, which still reads as a stand of stalks; at 64 the clumps are
    // 2.7 times as wide and read as fat single stalks. Every crop the
    // showcase grows except wheat (beans 32, rice 33, potatoes 4 to 6,
    // sunflowers 5 to 7 a plot) is under it, so they draw their real count.
    // 0 draws one plant per plot, the look before plots were drawn in full.
    plot_visual_cap: 128,
    // And no plot draws more vertices than this: a heavy stage model lowers
    // the cap further, the plants it drops going into wider clumps as above.
    // 65,536 is about one planted aeroponic tower (50 plants of roughly
    // 1,400 vertices), so a plot costs at most what a tower does. It binds on
    // the heavy stage models: rice at its last stage is 3,954 vertices a
    // plant, so a rice plot of 33 then draws 16 clumps. Measured 2026-09-26
    // (photograph-home rig, greenhouse beds view): drawing the real counts
    // took the GPU scene pass from 5.1 to 7.1 ms and the mesh memory from
    // 105 to 185 MB; this budget brought them to 6.7 ms and 154 MB.
    // 0 turns it off.
    plot_vertex_budget: 65536,
    plants: {
        // Strawberry: low leafy rosette, white 5-petal flowers, red hanging cones.
        "strawberry": (
            form: "rosette", height_m: 0.22, spread_m: 0.35, stem_radius: 0.006,
            stem_color: (0.35, 0.5, 0.25),
            leaf_count: 8, leaf_color: (0.16, 0.45, 0.18), leaf_droop_deg: 15.0,
            petal_count: 5, flower_color: (0.95, 0.95, 0.9), flower_center_color: (0.95, 0.8, 0.2),
            flower_at: 0.55, fruit_at: 0.75,
            fruit_kind: "cone", fruit_size: 0.035, fruit_count: 4,
            fruit_color_unripe: (0.55, 0.7, 0.4), fruit_color_ripe: (0.85, 0.12, 0.15),
            show_roots: true,
        ),
        // Tomato: leaning vine, yellow flowers, red fruit clusters.
        "tomato": (
            form: "vine", height_m: 0.9, spread_m: 0.5, stem_radius: 0.01,
            stem_color: (0.3, 0.48, 0.22),
            leaf_count: 10, leaf_color: (0.18, 0.42, 0.16), leaf_droop_deg: 20.0,
            petal_count: 5, flower_color: (0.95, 0.85, 0.2), flower_center_color: (0.9, 0.7, 0.1),
            flower_at: 0.5, fruit_at: 0.65,
            fruit_kind: "sphere", fruit_size: 0.06, fruit_count: 6,
            fruit_color_unripe: (0.5, 0.65, 0.3), fruit_color_ripe: (0.85, 0.18, 0.1),
            show_roots: true,
        ),
        // Amaranth: tall upright herb with a deep-red seed plume.
        "amaranth": (
            form: "herb", height_m: 1.4, spread_m: 0.5, stem_radius: 0.012,
            stem_color: (0.5, 0.25, 0.2),
            leaf_count: 12, leaf_color: (0.25, 0.45, 0.2), leaf_droop_deg: 25.0,
            petal_count: 1, flower_color: (0.6, 0.1, 0.15), flower_center_color: (0.6, 0.1, 0.15),
            flower_at: 0.6, fruit_at: 0.95,
            fruit_kind: "none", fruit_size: 0.02, fruit_count: 0,
            fruit_color_unripe: (0.5, 0.5, 0.3), fruit_color_ripe: (0.55, 0.3, 0.2),
            show_roots: false,
        ),
        // Apple: small trunked tree, white blossom, red spheres.
        "apple": (
            form: "tree", height_m: 2.2, spread_m: 1.6, stem_radius: 0.06,
            stem_color: (0.4, 0.28, 0.18),
            leaf_count: 12, leaf_color: (0.2, 0.42, 0.16), leaf_droop_deg: 10.0,
            petal_count: 5, flower_color: (0.97, 0.94, 0.94), flower_center_color: (0.95, 0.8, 0.3),
            flower_at: 0.45, fruit_at: 0.7,
            fruit_kind: "sphere", fruit_size: 0.08, fruit_count: 4,
