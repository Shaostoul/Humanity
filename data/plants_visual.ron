        "pineapple": (
            form: "bromeliad", height_m: 0.9, spread_m: 0.9, stem_radius: 0.02,
            stem_color: (0.35, 0.45, 0.25),
            leaf_count: 16, leaf_color: (0.2, 0.42, 0.25), leaf_droop_deg: 5.0,
            petal_count: 0, flower_color: (0.7, 0.2, 0.4), flower_center_color: (0.7, 0.2, 0.4),
            flower_at: 0.55, fruit_at: 0.65,
            fruit_kind: "sphere", fruit_size: 0.16, fruit_count: 1,
            fruit_color_unripe: (0.35, 0.5, 0.25), fruit_color_ripe: (0.85, 0.65, 0.15),
