            stem_color: (0.4, 0.29, 0.18),
            leaf_count: 13, leaf_color: (0.16, 0.4, 0.16), leaf_droop_deg: 8.0,
            petal_count: 5, flower_color: (0.98, 0.97, 0.9), flower_center_color: (0.95, 0.85, 0.4),
            flower_at: 0.45, fruit_at: 0.7,
