// HumanityOS ROOM EQUIPMENT catalog (infinite-of-x, v0.937: was a hardcoded match in
// src/relay/handlers/game_state.rs). Item ids the relay puts as furniture/equipment in every
// room of the given type of its shared world. Since increment 3 of
// docs/design/ship-homes-and-logistics.md that world is the mothership's shared places, not the
// retired Pioneer (src/relay/handlers/ship_world.rs): a room's type is its zone's purpose
// ("commons", "street") or a labelled volume's zone type ("mess_hall"). The game does not draw
// these; AI agents see them, and the survey_storage quest counts the lockers, cabinets and bins
// among them (game_state.rs `is_storage_equipment`). Add a room type or a fixture by adding a
// line here. Disk-first with an embedded fallback.
[
    (
        room_type: "commons",
        items: ["notice_board", "bench_seating", "vending_unit", "tool_cabinet", "harvest_bin"],
    ),
    (
        room_type: "mess_hall",
        items: ["dining_table", "bench_seating", "notice_board", "locker"],
    ),
    (
        room_type: "street",
        items: ["bench_seating", "locker"],
    ),
]
