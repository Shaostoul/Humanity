// THE LOCOMOTION STATE MACHINE (character animation rung 1, 2026-11-08;
// docs/design/character-animation.md sections 7 and 8.6; read by crates/humanity-animation/src/graph.rs).
//
// The simplified mode's solver, and the first rung's only one: states that each blend a few clips
// along one input, and transitions between them. Rung 3's motion matching replaces it in the full
// realism mode and leaves it as the simplified mode for good. Every body plays it: the player in
// third person, the other players (their speed read from their interpolated positions, nothing new
// sent) and the crew.
//
// Inputs (crates/humanity-animation/src/motion.rs reads them from where the body went):
//   Speed     metres a second along the way the body faces, negative walking backwards
//   TurnRate  radians a second, positive turning left (counter-clockwise seen from above)
//   Crouch    1 crouching, 0 standing (rung 2a: the crouch key; another player's network stance)
//   Airborne  seconds off the ground, 0 on it (a step down a stair is no time off the ground)
//   VerticalSpeed  metres a second upward, read from where the body went
//   StateTime seconds since the graph entered its current state (only in conditions)
//
// A state is a 1D blend space: `samples` place clips (ids in data/characters/clips.ron) at points
// along its input, and the body plays the two around its input, weighted. `sync` plays them on one
// shared stride phase (a walk and a run blended put the same foot down together); `stride` plays
// them faster or slower so the clip's own speed (its `speed_mps`) matches the body's, within
// min_rate..max_rate, and backwards when the body walks backwards.
//
// Transitions are checked in order from the current state ("*" = any); the first whose conditions
// all hold crossfades to its state over blend_s seconds.
(
    id: "humanoid_locomotion",
    initial: "idle",
    // How fast the inputs follow the body's real motion: long enough that another player's 15
    // position updates a second read as one smooth speed, short enough that a stop reads at once.
    smoothing_s: 0.18,
    // Faster than this (m/s) is a teleport, not a stride: a sprint is about 9 m/s.
    teleport_mps: 14.0,
    states: [
        (
            id: "idle",
            param: Speed,
            samples: [(at: 0.0, clip: "idle")],
        ),
        (
            // Turning on the spot: the turn steps, left at positive rates.
            id: "turn",
            param: TurnRate,
            samples: [
                (at: -2.5, clip: "turn_right"),
                (at: 0.0, clip: "idle"),
                (at: 2.5, clip: "turn_left"),
            ],
        ),
        (
            // Walking, jogging and sprinting (Quaternius's gaits, 2026-11-09): one stride phase,
            // each clip played at the rate that matches the body's speed to its own (clips.ron's
            // speed_mps, measured from the feet), so the feet keep still on the floor.
            //
            // Where each clip is placed, by the walk speeds the two movement modes use
            // (data/game.csv): the realistic walk (1.4 m/s) is the walk alone, played 1.43 times
            // (the library walks at 0.98); the realistic run (4.0) is the jog alone, played 0.68
            // times (it jogs at 5.9: a long-striding jog, slowed; a blend of walk and jog there read
            // as neither); the simplified walk (5.0) is mostly the jog with a fifth of the sprint, and
            // the simplified sprint (9.5) the sprint, 1.07 times. Better gaits for these speeds come
            // with motion matching's captured data (rung 3).
            id: "move",
            param: Speed,
            samples: [
                (at: 1.6, clip: "walk"),
                (at: 4.0, clip: "jog"),
                (at: 8.9, clip: "sprint"),
            ],
            sync: true,
            stride: Some((min_rate: 0.55, max_rate: 1.6)),
        ),
        // CROUCH AND JUMP (rung 2a, 2026-11-09): Quaternius's clips, retargeted since rung 1 and
        // played now that the graph has the inputs. Crouching is the crouch key (Settings >
        // Controls; another player's stance as the network carries it); a jump is the time off the
        // ground and the way the body is going (the walk's own jump, Space).
        (
            id: "crouch_idle",
            param: Speed,
            samples: [(at: 0.0, clip: "crouch_idle")],
        ),
        (
            // Crouched walking: the library's crouch walk (0.72 m/s on its own rig), played at the
            // body's speed like the walk.
            id: "crouch_move",
            param: Speed,
            samples: [(at: 0.7, clip: "crouch_walk")],
            sync: true,
            stride: Some((min_rate: 0.55, max_rate: 1.6)),
        ),
        (
            // The take-off, played once from its start.
            id: "jump_up",
            param: Speed,
            samples: [(at: 0.0, clip: "jump_start")],
        ),
        (
            // In the air, rising or falling: the library's air loop.
            id: "jump_air",
            param: Speed,
            samples: [(at: 0.0, clip: "jump_air")],
        ),
        (
            // Touching down, played once; then standing or walking on.
            id: "land",
            param: Speed,
            samples: [(at: 0.0, clip: "jump_land")],
        ),
    ],
    transitions: [
        // Off the ground first: a jump launches upward (the walk's jump leaves at 5 m/s), a body
        // that has been in the air a while without one is falling.
        (from: ["idle", "turn", "move", "crouch_idle", "crouch_move", "land"], to: "jump_up", when: [(param: Airborne, test: Above, value: 0.0), (param: VerticalSpeed, test: Above, value: 1.5)], blend_s: 0.08),
        (from: ["idle", "turn", "move", "crouch_idle", "crouch_move", "land"], to: "jump_air", when: [(param: Airborne, test: Above, value: 0.3)], blend_s: 0.2),
        (from: ["jump_up"], to: "jump_air", when: [(param: StateTime, test: Above, value: 0.3)], blend_s: 0.15),
        (from: ["jump_up", "jump_air"], to: "land", when: [(param: Airborne, test: Below, value: 0.001)], blend_s: 0.06),
        (from: ["land"], to: "move", when: [(param: StateTime, test: Above, value: 0.25), (param: Speed, test: AbsAbove, value: 0.3)], blend_s: 0.2),
        (from: ["land"], to: "idle", when: [(param: StateTime, test: Above, value: 0.45)], blend_s: 0.25),
        // Crouching down and standing up, standing still or walking.
        (from: ["idle", "turn"], to: "crouch_idle", when: [(param: Crouch, test: Above, value: 0.5)], blend_s: 0.25),
        (from: ["move"], to: "crouch_move", when: [(param: Crouch, test: Above, value: 0.5)], blend_s: 0.25),
        (from: ["crouch_idle"], to: "crouch_move", when: [(param: Speed, test: AbsAbove, value: 0.25)], blend_s: 0.25),
        (from: ["crouch_move"], to: "crouch_idle", when: [(param: Speed, test: AbsBelow, value: 0.12)], blend_s: 0.3),
        (from: ["crouch_idle"], to: "idle", when: [(param: Crouch, test: Below, value: 0.5)], blend_s: 0.3),
        (from: ["crouch_move"], to: "move", when: [(param: Crouch, test: Below, value: 0.5)], blend_s: 0.3),
        (from: ["idle", "turn"], to: "move", when: [(param: Speed, test: AbsAbove, value: 0.3)], blend_s: 0.25),
        (from: ["move"], to: "idle", when: [(param: Speed, test: AbsBelow, value: 0.15)], blend_s: 0.3),
        (from: ["idle"], to: "turn", when: [(param: TurnRate, test: AbsAbove, value: 0.7)], blend_s: 0.2),
        (from: ["turn"], to: "idle", when: [(param: TurnRate, test: AbsBelow, value: 0.35)], blend_s: 0.25),
    ],
)
