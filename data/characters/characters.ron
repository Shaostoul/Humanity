// CHARACTERS: which bodies and graph every humanoid uses, and how they are drawn (character animation
// rung 1, 2026-11-08, real bodies 2026-11-09; docs/design/character-animation.md; read by
// crates/humanity-animation/src/library.rs).
//
// The body is an asset choice, not a code choice (the operator, 2026-11-08). Since 2026-11-09 the
// bodies are MakeHuman's (CC0; the operator: "We need at least a male and a female."), made by
// scripts/gen-makehuman-body.js. A body is a file in bodies/ with its rig's role map in role_maps/;
// nothing in code names one.
(
    // The bodies a look can choose, by the id the look names (its `body_type`).
    bodies: {
        "female": "makehuman_female",
        "male": "makehuman_male",
    },
    // Drawn in place of a body that does not load (and the body the tests and rigs prove skinning
    // and retargeting with): the procedural test figure of scripts/gen-test-figure.js.
    fallback: "hos_test_figure",
    // The `id` inside data/characters/locomotion.ron.
    locomotion: "humanoid_locomotion",
    // Frames a second every clip is baked at when it is retargeted onto a body (in memory, at load;
    // never written to disk).
    clip_fps: 30.0,
    // The drawing tiers (plan 8.4): the nearest bodies, up to near_cap and within near_m, are
    // skinned once a frame by a compute pass; the rest skin in the vertex shader out to middle_m
    // and, until rung 4's baked far tier, beyond it. 40 m is where the crew nameplate retires too.
    tiers: (near_m: 15.0, middle_m: 40.0, near_cap: 16),
    // FEET ON THE WORLD (rung 2a, 2026-11-09; crates/humanity-animation/src/feet.rs): the near
    // bodies' feet go onto the ground under them (two-bone leg IK, the pelvis lowered by the larger
    // drop, the foot turned to the slope about a toe pivot, foot locking, stair footsteps on tread
    // middles); the middle bodies get the pelvis offset alone. Lengths in metres, times in seconds.
    feet: (
        // The furthest the pelvis drops for a foot on lower ground, and rises when both feet stand
        // higher than the body's root (a remote player interpolated between two treads).
        max_drop_m: 0.45,
        max_raise_m: 0.25,
        // How fast the pelvis and a swinging foot's lift follow (exponential follows; a planted foot
        // is put on the ground, and held, at once), and how long a lock takes to let go once the
        // clip lifts the foot.
        pelvis_follow_s: 0.07,
        lift_follow_s: 0.06,
        lock_out_s: 0.15,
        // A lock breaks at once when the clip's foot is further than this from it.
        lock_break_m: 0.35,
        // The most a planted foot turns to a slope.
        max_tilt_deg: 35.0,
        // Contact labels, read from each clip at load: a sole within contact_rel_m of the lowest
        // it goes in the clip, no higher than contact_abs_m over the floor, rising or falling
        // slower than contact_rise_mps, and sliding backwards under the body at the clip's own speed
        // (a clip played in place) to within contact_slip_mps plus contact_slip_share of that
        // speed, is planted.
        contact_rel_m: 0.04,
        contact_abs_m: 0.08,
        contact_rise_mps: 0.5,
        contact_slip_mps: 0.3,
        contact_slip_share: 0.35,
        // How far apart the ground is sampled to read a slope (a step bigger than a slope over
        // that span is a riser, and the foot stays level).
        slope_probe_m: 0.08,
        // Plan footsteps on stairs: a foot planting on a tread is moved along the stair onto the
        // tread's middle (the stair piece's own riser and tread), so it does not land across a nosing.
        plan_steps: true,
        // The least room left between the end of a planted foot that points up the stair and the
        // next riser (the other end may hang over the nosing behind, as heels do on a narrow tread).
        tread_margin_m: 0.035,
        // How far ahead of its toe tips a swinging foot reads the ground, so its lift rises before
        // the next step instead of popping up at the riser.
        swing_ahead_m: 0.12,
        // The most a frame spends on full foot solves (ms): the nearest bodies get the full solve,
        // as many as this buys at what one has been costing on this machine (about 12 microseconds
        // on the operator's i7-8700K, so all 16 near bodies), the rest of the near tier the pelvis
        // offset (question 5: full realism where the budget allows, simplified automatically below).
        full_budget_ms: 1.0,
    ),
    // Each kind of wearer's defaults: the bodies a person of this kind is drawn with when their look
    // names none (one each, by a stable hash of who they are, so a crew is women and men), their
    // skin, hair and eyes when they have no look of their own, and each cosmetic slot's colour when
    // nothing is equipped in it. Players keep the teal top that has always said "a player" at a
    // glance, crew the amber one; the slots are data/cosmetics/cosmetics.csv's.
    wearers: {
        "player": (
            bodies: ["female", "male"],
            skin: (0.80, 0.62, 0.50),
            hair: (0.22, 0.15, 0.10),
            eyes: (0.30, 0.45, 0.55),
            clothes: {
                "head": Hair,
                "chest": Rgb(0.15, 0.62, 0.72),
                "legs": Rgb(0.20, 0.22, 0.28),
                "feet": Rgb(0.12, 0.11, 0.10),
                "hands": Skin,
            },
        ),
        "crew": (
            bodies: ["female", "male"],
            skin: (0.66, 0.48, 0.36),
            hair: (0.10, 0.08, 0.07),
            eyes: (0.25, 0.18, 0.12),
            clothes: {
                "head": Hair,
                "chest": Rgb(0.88, 0.58, 0.16),
                "legs": Rgb(0.26, 0.24, 0.22),
                "feet": Rgb(0.14, 0.12, 0.10),
                "hands": Skin,
            },
            // A crew is not one body copied (2026-11-09): each member's build, proportions,
            // ancestry and height are picked in these ranges by a stable hash of who they are, so
            // each keeps theirs. Slider values run 0 to 1 with the body as made at 0.5 (the body
            // files' sliders); the ancestry parts are drawn in their range and then made to add up
            // to one. Ranges stay inside the plausible middle of each slider; the height is the
            // look height (1.0 = the body's own, so 1.59 to 1.73 m by body, give or take 6%).
            shape: {
                "muscle": (0.3, 0.75),
                "weight": (0.2, 0.8),
                "proportions": (0.3, 0.7),
                "african": (0.0, 1.0),
                "asian": (0.0, 1.0),
                "european": (0.0, 1.0),
            },
            height: Some((0.94, 1.06)),
        ),
    },
)
