// Wild creature spawns (v0.761, combat arc increment 2).
//
// Hostile-tier creatures.csv species placed at absolute world positions AWAY
// from the homestead (the home footprint sits roughly x 0-40, z 0-70; the
// outdoor fields around x 27-31, z 61-65). Each entry scatters `count`
// animals within `radius` metres of `pos`. Their combat behavior comes from
// the species' ai_behavior column (hunt -> predator: they stalk prey
// INCLUDING the player). tint is the placeholder body colour.
//
// Adding a wild species or a den = adding a row here.
(
    spawns: [
        // Wolves REMOVED (v0.1025, operator: a live player was killed at
        // spawn - "pwned before even entered the game"): the hunt-AI pack
        // wandered into the ship interior. The spaceship/homestead is a
        // SAFE zone by design. Wolves return with the predator arc once
        // hostile AI respects interior/zone boundaries; re-add the row
        // then:
        // (creature: "wolf", count: 2, pos: (75.0, 100.0), radius: 10.0, tint: (0.42, 0.42, 0.48)),
        // Forage flora (v0.978): rooted renewable pickups a short walk past
        // the outdoor fields (fields sit ~x 27-31, z 61-65). Berry bushes in
        // a loose thicket; a flax stand nearer the wetter ground. Both are
        // stationary rows - they collect via walk-up [E] and regrow.
        (creature: "berry_bush", count: 4, pos: (52.0, 82.0), radius: 6.0, tint: (0.18, 0.34, 0.15)),
        (creature: "wild_flax", count: 6, pos: (18.0, 88.0), radius: 5.0, tint: (0.55, 0.58, 0.30)),
        // Resource nodes (v0.982, the forage faucet): raw-material sources so
        // the tech tree stops hanging off the vendor. Scattered in a working
        // ring beyond the fields - each a stationary [E]-collect on a regrow
        // timer. Tints double as material color until hero models land.
        (creature: "fallen_log", count: 3, pos: (60.0, 70.0), radius: 8.0, tint: (0.38, 0.26, 0.14)),
        (creature: "stone_outcrop", count: 3, pos: (70.0, 55.0), radius: 7.0, tint: (0.52, 0.52, 0.54)),
        (creature: "clay_pit", count: 2, pos: (12.0, 78.0), radius: 5.0, tint: (0.58, 0.36, 0.24)),
        (creature: "salt_flat", count: 2, pos: (80.0, 40.0), radius: 5.0, tint: (0.88, 0.88, 0.84)),
        (creature: "sand_pit", count: 2, pos: (88.0, 60.0), radius: 5.0, tint: (0.80, 0.70, 0.48)),
        // Ore nodes (2026-10-04, the first-hour audit's B5). The ore samples
        // Initial Survey gathers and the rare ore Distant Expeditions recovers
        // (data/quests/exploration.ron) had no source: only two creatures
        // nothing spawns dropped them. The outcrop is in the empty east half of
        // the fields room (x 0-40, z 73-89), the place that quest's step before
        // sends the player; the vein is at the northeast ridge the next quest
        // walks to (wolf_ridge in destinations.ron), inside First Street (x
        // 65-75). Each sits wholly inside its room or zone, scatter radius and
        // all (quest_ore_comes_from_nodes_a_player_can_walk_to in
        // src/systems/quests/mod.rs). Three outcrops at 2 samples each cover
        // the 5 in one visit, three veins at 1 each the 3. Appended last on
        // purpose: a row's index turns its scatter (engine/world_load.rs), so
        // a row inserted above would move every row below it.
        (creature: "ore_outcrop", count: 3, pos: (32.0, 81.0), radius: 4.0, tint: (0.50, 0.32, 0.22)),
        (creature: "rare_ore_vein", count: 3, pos: (70.0, 100.0), radius: 3.0, tint: (0.38, 0.40, 0.52)),
    ],
)
