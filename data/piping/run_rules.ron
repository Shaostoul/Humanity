            applies: (materials: ["pex"]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "no tighter than six times the outside diameter; three times that against the coil for certain PEX (3.8 in at 1/2 in)",
            source: [R(3)],
            note: "The PPI's design guide; the PEX maker's own figure, where it differs, overrides it (the guide says so). The size rows carry Table 9.1's absolute radii too.",
        ),
        (
            id: "bend_cpvc_coil",
