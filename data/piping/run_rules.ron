            applies: (materials: ["cpvc_coil"]),
            profiles: ["dwelling_us"],
            standing: Maker,
            as_read: "18 in at 1/2 and 3/4 in, 24 in at 1 in",
            source: [R(4)],
        ),
        (
            id: "bend_csst",
            kind: bend_radius(installed: SizeRow(Free)),
            applies: (materials: ["csst"]),
            profiles: ["dwelling_us"],
            standing: Maker,
            as_read: "Table 4-1: 9/16 in at 3/8 in up to 4 in at 2 in",
            source: [R(7)],
            note: "One maker's guide (TracPipe, 12/16); several tight bends also add pressure drop.",
        ),
        (
            id: "bend_hose_makers",
            kind: bend_radius(installed: SizeRow(Free)),
