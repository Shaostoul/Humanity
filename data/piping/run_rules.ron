            applies: (forms: [Cable], tags: ["flame_test_failed"]),
            profiles: ["ship_us"],
            standing: Law,
            as_read: "fire stops At least every 7 meters (21.5 feet) vertically, at most two deck heights, every 15 m (46 ft) horizontally and at each A or B class boundary (46 CFR 111.60-2)",
