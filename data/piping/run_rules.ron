            applies: (materials: ["csst"], dn: (20, 50)),
            profiles: ["dwelling_us"],
            standing: Maker,
            as_read: "TracPipe Table 4-2: 3/4 to 2 in, 8 ft",
            source: [R(7)],
        ),
        (
            id: "support_emt",
            kind: support_spacing(horizontal_m: 3.048, vertical_m: 3.048, every_storey: true),
            applies: (materials: ["emt"]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "exposed risers clamped at each floor and every 3050 mm (10 ft) at most (UFGS 26 20 00); horizontal 10 ft",
            source: [R(31), R(42), Ours("the horizontal 3.05 m is the NEC's 358.30 as the trade quotes it (and as data/routing_rules.ron's header cited it); that section was not read (R42), so the horizontal number is ours until it is")],
            note: "Plastic cable ties are not acceptable supports for a raceway (UFGS 26 20 00).",
        ),
        (
            id: "support_data_cable",
            kind: support_spacing(horizontal_m: 1.5),
            applies: (forms: [Cable], contents: [Data]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "J-hooks on 1.2 to 1.5 m (4 to 5 ft) centres (UFGS 27 10 00); 5 ft at most (Panduit)",
            source: [R(18)],
            note: "At most 20 cables of 6.4 mm on one J-hook: the anchor row's holds_max.",
        ),
        (
            id: "support_ship_cable",
            kind: support_spacing(horizontal_m: 0.61, vertical_m: 0.61),
            applies: (forms: [Cable]),
            profiles: ["ship_us"],
            standing: Law,
            as_read: "metal supports spaced not more than 610 millimeters (24 inches) apart (46 CFR 120.340(b)(4)); IEEE 45.8: no farther apart than the frames or 610 mm, retention every 610 mm, turns included",
            source: [R(14)],
            note: "46 CFR 120.340 is the small passenger vessel rule; 46 CFR 111.60-5 incorporates IEEE 45.8's same 610 mm for vessels generally. Towing vessels may go to 48 in (46 CFR 143.575), which this profile does not use.",
        ),
        (
            id: "support_spacecraft_ties_6mm",
            kind: support_spacing(horizontal_m: 0.0191, vertical_m: 0.0191),
            applies: (forms: [Cable], od_m: (0.0, 0.0064)),
            profiles: ["spacecraft"],
            standing: Standard,
            as_read: "NASA-STD-8739.4A Table 9-1: harness 6.4 mm or less, spot ties at most 19.1 mm apart",
            source: [R(17)],
            note: "Ties along a harness; clamping a harness to structure is the FAA analogue's 24 in (support_spacecraft_clamps).",
        ),
        (
            id: "support_spacecraft_ties_13mm",
            kind: support_spacing(horizontal_m: 0.0381, vertical_m: 0.0381),
            applies: (forms: [Cable], od_m: (0.0064, 0.0127)),
            profiles: ["spacecraft"],
            standing: Standard,
            as_read: "Table 9-1: harness 12.7 mm, ties 38.1 mm",
            source: [R(17)],
        ),
        (
            id: "support_spacecraft_ties_25mm",
            kind: support_spacing(horizontal_m: 0.0508, vertical_m: 0.0508),
            applies: (forms: [Cable], od_m: (0.0127, 0.0254)),
            profiles: ["spacecraft"],
            standing: Standard,
            as_read: "Table 9-1: harness 25.4 mm, ties 50.8 mm",
            source: [R(17)],
        ),
        (
            id: "support_spacecraft_ties_over_25mm",
            kind: support_spacing(horizontal_m: 0.0762, vertical_m: 0.0762),
            applies: (forms: [Cable], od_m: (0.0254, 1.0)),
            profiles: ["spacecraft"],
            standing: Standard,
            as_read: "Table 9-1: harness over 25.4 mm, ties 76.2 mm",
            source: [R(17)],
        ),
        (
            id: "support_spacecraft_clamps",
            kind: support_spacing(horizontal_m: 0.6096, vertical_m: 0.6096, max_sag_m: 0.0127),
            applies: (forms: [Cable]),
            profiles: ["spacecraft"],
            standing: Guidance,
            as_read: "clamps should be spaced at intervals not exceeding 24 inches; no more than 1/2 in of sag between supports (FAA AC 43.13-1B 11-146, 11-118)",
            source: [R(16), R(17)],
            note: "NASA-STD-8739.4A gives no number for clamping a harness to structure (R17), so the FAA's aircraft guidance is the analogue.",
        ),

        // ── support_near: a support close to a bend, a valve, a box, an end ───────────────────
        (
            id: "support_near_bend",
            kind: support_near(near: Bend, within_m: 0.3048),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Specification,
            as_read: "within 1 ft of each change in direction (UFGS 23 05 15; UFGS 22 00 00: of the joint at each change in direction)",
            source: [R(9), R(10)],
        ),
        (
            id: "support_near_valve",
            kind: support_near(near: Valve, span_m: 1.5),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Specification,
            as_read: "supports must be spaced not over 1.5 m 5 feet apart at valves (UFGS 22 00 00)",
            source: [R(10)],
            note: "UFGS 23 05 15 says to shorten the span in proportion at valves (R9).",
        ),
        (
            id: "support_near_runout_end",
            kind: support_near(near: RunoutEnd, within_m: 0.9144),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Specification,
            as_read: "no more than 3 ft from the end of each runout (UFGS 23 05 15)",
            source: [R(9)],
        ),
        (
            id: "support_near_riser_end",
            kind: support_near(near: RiserEnd, within_m: 2.4384),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Specification,
            as_read: "vertical supports 8 ft from a riser's ends (UFGS 22 00 00)",
            source: [R(10)],
        ),
        (
            id: "support_near_box_nm",
            kind: support_near(near: Box, within_m: 0.3048),
            applies: (materials: ["nm_b"]),
            profiles: ["dwelling_us"],
            standing: Law,
            as_read: "within 12 inches of every cabinet, box or fitting (24 CFR 3280.808(d))",
            source: [R(13)],
        ),

        // ── separation: clearance between two groups of runs, or a run and equipment ───────────
        (
            id: "separation_comms_power",
            kind: separation(from: Runs((contents: [Electricity])), min_m: 0.0508),
            applies: (contents: [Data]),
            profiles: ["dwelling_us"],
            standing: Guidance,
            as_read: "Indoor communications wires and cables shall be separated at least 50.8 mm (2 in.) from power conductors (29 CFR 1910.308(e)(2)(iv))",
            source: [R(27), R(42)],
            note: "OSHA's rule for workplaces, the public mirror of the NEC's communications rule (800.133, not read, R42); used for a home as the closest public rule. A special and equally protective method (a barrier) lifts it.",
        ),
        (
            id: "separation_comms_power_parallel",
            kind: separation(from: Runs((contents: [Electricity])), min_m: 0.3, lay: Parallel),
            applies: (contents: [Data]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "cable parallel to power conductors must have a minimum separation of 300 mm 12 in (UFGS 27 10 00)",
            source: [R(20)],
        ),
        (
            id: "separation_conduit_hot_pipes",
            kind: separation(from: Runs((contents: [HotWater])), min_m: 0.15, lay: Parallel),
            applies: (forms: [Raceway]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "Keep conduit minimum 150 mm 6 inches away from parallel runs of flues and steam or hot water pipes (UFGS 26 20 00)",
            source: [R(31)],
        ),
        (
            id: "separation_conduit_flues",
            kind: separation(from: Equipment(["flue", "water_heater_flue"]), min_m: 0.15, lay: Parallel),
            applies: (forms: [Raceway]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "150 mm 6 inches away from parallel runs of flues (UFGS 26 20 00)",
            source: [R(31)],
        ),
        (
            id: "separation_pex_heater_flue",
            kind: separation(from: Equipment(["water_heater_flue"]), min_m: 0.1524),
            applies: (materials: ["pex"]),
            profiles: ["dwelling_us"],
            standing: Guidance,
            as_read: "6 in from a gas or oil water heater's flue, with 18 in metal connectors at the heater (PPI guide)",
            source: [R(3), R(34)],
            note: "Keep PEX at or below 180 F; recessed lights reach 194 F (IC-rated) to 300 F at their surface (R34).",
        ),
        (
            id: "separation_wiring_flammable_lines",
            kind: separation(from: Runs((contents: [Fuel, Air])), min_m: 0.0508, preferred_m: 0.1524, clamped_m: 0.0127, no_parallel: true),
            applies: (contents: [Electricity, Data]),
            profiles: ["ship_us", "spacecraft"],
            standing: Guidance,
            as_read: "a minimum separation of 6 inches or more whenever possible; A minimum of 2 inches must be maintained; 1/2 in where positively clamped; never parallel (FAA AC 43.13-1B 11-126)",
            source: [R(32)],
            note: "Aircraft guidance, used aboard a ship and in a spacecraft as the closest public rule (the findings' judgement call). Air stands in for oxygen lines: Utility has no separate oxygen yet. The 'above' half is vertical_order_wiring_above_flammable.",
        ),

        // ── keep_out: a volume a content may not enter ─────────────────────────────────────────
        (
            id: "keep_out_over_panel",
            kind: keep_out(equipment: ["electrical_panel"], zone: Above(height_m: 1.83)),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us"],
            standing: Guidance,
            as_read: "the space from the floor to 6.0 ft (1.83 m) above a panelboard is dedicated; equipment foreign to the electrical installation may not be located in this area (29 CFR 1910.303(g)(1)(vii)(A)(1))",
            source: [R(28), R(42)],
            note: "OSHA's workplace rule, the public mirror of the NEC's 110.26(E) (not read, R42), used for a home as the closest public rule. Above that space foreign systems are kept out unless protected against condensation, leaks or breaks.",
        ),
        (
            id: "keep_out_panel_working_space",
            kind: keep_out(equipment: ["electrical_panel"], zone: InFront(depth_m: 0.762, width_m: 0.762)),
            applies: (),
            profiles: ["dwelling_us"],
            standing: Law,
            as_read: "a clear working space at least 30 in wide and 30 in in front of the panelboard (24 CFR 3280.804(f))",
            source: [R(13)],
            note: "OSHA's workplace equivalent is the equipment's width or 30 in, 3 ft deep at 0 to 150 V, with 6.5 ft of headroom (R28).",
        ),
        (
            id: "keep_out_over_switchboard",
            kind: keep_out(equipment: ["switchboard"], zone: Above()),
            applies: (forms: [Pipe]),
            profiles: ["ship_us"],
            standing: Law,
            as_read: "Piping must generally not be run over switchboards (46 CFR 56.50-1(d)); each switchboard is fitted with a dripshield (111.30-5(b))",
            source: [R(29)],
            note: "And kept as far from other electrical equipment as practicable, guarded against leaks where it cannot be.",
        ),

        // ── vertical_order: which content runs above which where routes share ──────────────────
        (
            id: "vertical_order_power_above_fluids",
            kind: vertical_order(top_first: [[Electricity, Data], [Air], [Fuel], [Water, HotWater], [Nutrient], [Waste]]),
            applies: (),
            profiles: ["dwelling_us", "ship_us"],
            standing: Ours,
            as_read: "nothing foreign over a panel (OSHA); no piping over switchboards (46 CFR); wiring above fluid lines (FAA)",
            source: [R(28), R(29), R(32), Ours("the order AMONG the fluid lines is the old data/routing_rules.ron lanes (v0.434): air and fuel above water, nutrient below it, waste lowest because a drain falls by gravity; no source read orders them, and that file's \"NEC 300.4\" for power above wet lines was never read (R42), so findings 28, 29 and 32 replace it")],
            note: "Power above water is the drip reasoning every one of the sources shares: water must not land on electricity. data/routing_rules.ron keeps its lanes until the auto-router (rung 9) reads this row instead.",
        ),
        (
            id: "vertical_order_wiring_above_flammable",
            kind: vertical_order(top_first: [[Electricity, Data], [Fuel, Air]]),
            applies: (),
            profiles: ["ship_us", "spacecraft"],
            standing: Guidance,
            as_read: "wiring is routed above lines carrying flammable fluids or oxygen (FAA AC 43.13-1B 11-126)",
            source: [R(32)],
        ),

        // ── no_shared: holes, supports or bundles two contents may not share ───────────────────
        (
            id: "no_shared_hole_pipe_wire",
            kind: no_shared(what: Hole, with: Runs((forms: [Cable, Raceway]))),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us"],
            standing: Law,
            as_read: "Piping and electrical wiring shall not pass through the same holes (24 CFR 3280.603(b)(7))",
            source: [R(30)],
        ),
        (
            id: "no_shared_support_raceway_pipe",
            kind: no_shared(what: Support, with: Runs((forms: [Pipe]))),
            applies: (forms: [Raceway]),
            profiles: ["dwelling_us"],
            standing: Specification,
            as_read: "Do not share supporting means between electrical raceways and mechanical piping or ducts (UFGS 26 20 00)",
            source: [R(31)],
        ),
        (
            id: "no_shared_bundle_redundant",
            kind: no_shared(what: Bundle, with: Redundant),
            applies: (forms: [Cable]),
            profiles: ["spacecraft"],
            standing: Standard,
            as_read: "redundant systems are not routed in the same bundle (NASA-STD-8739.4A 7.2.7)",
            source: [R(17)],
        ),

        // ── slope: a drain falls toward its outlet ─────────────────────────────────────────────
        (
            id: "slope_drain_dwelling",
            kind: slope(min_ratio: 0.0208333, reduced: (ratio: 0.0104167, needs: CleanoutAtUpperEnd)),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us"],
            standing: Law,
            as_read: "a uniform grade of not less than 1/4 inch per foot; where impractical, 1/8 inch per foot with a full-size cleanout at the upper end (24 CFR 3280.610(h))",
            source: [R(36)],
            note: "The UPC (2009) says the same 1/4 in (2%), and 1/8 in (1%) for 4 in and larger with the authority's approval (R37).",
        ),
        (
            id: "slope_drain_ship_dn65",
            kind: slope(min_ratio: 0.0208333),
            applies: (contents: [Waste], dn: (0, 65)),
            profiles: ["ship_us"],
            standing: Guidance,
            as_read: "IPC 2009 Table 704.1: 2 1/2 in or smaller, 1/4 in per foot",
            source: [R(37), Ours("no ship drain slope was read; the 2009 IPC's table (a superseded model code for buildings) is the closest public rule, and a rolling ship may need more")],
        ),
        (
            id: "slope_drain_ship_dn80_150",
            kind: slope(min_ratio: 0.0104167),
            applies: (contents: [Waste], dn: (80, 150)),
            profiles: ["ship_us"],
            standing: Guidance,
            as_read: "IPC 2009 Table 704.1: 3 to 6 in, 1/8 in per foot",
            source: [R(37), Ours("as slope_drain_ship_dn65: the closest public rule")],
        ),
        (
            id: "slope_drain_ship_dn200_up",
            kind: slope(min_ratio: 0.0052083),
            applies: (contents: [Waste], dn: (200, 9999)),
            profiles: ["ship_us"],
            standing: Guidance,
            as_read: "IPC 2009 Table 704.1: 8 in or larger, 1/16 in per foot",
            source: [R(37), Ours("as slope_drain_ship_dn65: the closest public rule")],
        ),

        // ── drain_turn: which drain fitting may turn which way ─────────────────────────────────
        (
            id: "drain_turn_sanitary_tee",
            kind: drain_turn(fitting: "sanitary_tee", turns: [(turn: HorizontalToVertical)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "a sanitary tee turns only from horizontal to vertical (IPC 2009 Table 706.3)",
            source: [R(38)],
            note: "IPC 2009, a superseded model code; 24 CFR 3280's own drain fitting rules were not read, so it is the closest public rule here.",
        ),
        (
            id: "drain_turn_quarter_bend",
            kind: drain_turn(fitting: "quarter_bend", turns: [
                (turn: HorizontalToVertical),
                (turn: VerticalToHorizontal, only: [FixtureDrainUpTo(50)]),
                (turn: HorizontalToHorizontal, only: [FixtureDrainUpTo(50)]),
            ]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "a quarter bend turns vertical to horizontal and horizontal to horizontal only on a fixture drain of 2 in or smaller (IPC 2009 Table 706.3)",
            source: [R(38)],
            note: "The finding records the limits on those two turns; horizontal to vertical, which it does not limit, is allowed.",
        ),
        (
            id: "drain_turn_short_sweep",
            kind: drain_turn(fitting: "short_sweep", turns: [
                (turn: HorizontalToVertical),
                (turn: VerticalToHorizontal, only: [DnAtLeast(80), FixtureDrainUpTo(50)]),
                (turn: HorizontalToHorizontal, only: [FixtureDrainUpTo(50)]),
            ]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "a short sweep turns vertical to horizontal at 3 in or larger or on a 2 in or smaller fixture drain (IPC 2009 Table 706.3)",
            source: [R(38), Ours("the short sweep's horizontal-to-horizontal limit is not in the finding; the quarter bend's limit is used, the cautious reading until the table is read again")],
        ),
        (
            id: "drain_turn_any_direction",
            kind: drain_turn(fitting: "sixteenth_bend", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "sixteenth, eighth and sixth bends, long sweeps, wyes and combination wye and eighth bends may turn in all three directions (IPC 2009 Table 706.3)",
            source: [R(38)],
        ),
        (
            id: "drain_turn_eighth_bend",
            kind: drain_turn(fitting: "eighth_bend", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "as drain_turn_any_direction",
            source: [R(38)],
        ),
        (
            id: "drain_turn_sixth_bend",
            kind: drain_turn(fitting: "sixth_bend", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "as drain_turn_any_direction",
            source: [R(38)],
        ),
        (
            id: "drain_turn_long_sweep",
            kind: drain_turn(fitting: "long_sweep", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "as drain_turn_any_direction",
            source: [R(38)],
        ),
        (
            id: "drain_turn_wye",
            kind: drain_turn(fitting: "wye", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "as drain_turn_any_direction",
            source: [R(38)],
        ),
        (
            id: "drain_turn_combination_wye",
            kind: drain_turn(fitting: "combination_wye_eighth", turns: [(turn: HorizontalToVertical), (turn: VerticalToHorizontal), (turn: HorizontalToHorizontal)]),
            applies: (contents: [Waste]),
            profiles: ["dwelling_us", "ship_us"],
            standing: Guidance,
            as_read: "as drain_turn_any_direction",
            source: [R(38)],
        ),

        // ── penetration: how a run crosses a wall, a deck or a stud ────────────────────────────
        (
            id: "penetration_stud_plate_cable",
            kind: penetration(through: [Stud], needs: Plate, within_m: 0.0381, thickness_m: 0.0015189),
            applies: (forms: [Cable]),
            profiles: ["dwelling_us"],
            standing: Law,
            as_read: "through the centre of the wide side of 2 by 4 studs; steel plates or a tube of at least No. 16 MSG where it would be less than 1 1/2 in from a stud's face (24 CFR 3280.808(e))",
            source: [R(41), Ours("the plate's thickness is our conversion of No. 16 Manufacturers' Standard Gauge to 0.0598 in (1.52 mm); the finding gives the gauge only")],
            note: "No. 16 MSG is 0.0598 in (1.52 mm); the older US Standard Gauge's 16 is 1/16 in, 1.59 mm.",
        ),
        (
            id: "penetration_stud_plate_pipe",
            kind: penetration(through: [Stud], needs: Plate, within_m: 0.0381, thickness_m: 0.0014605),
            applies: (forms: [Pipe]),
            profiles: ["dwelling_us"],
            standing: Guidance,
            as_read: "a 0.0575 in (No. 16 gauge) shield plate where pipe is within 1 1/2 in of a stud's or joist's edge (IPC 2009 305.8)",
            source: [R(11), R(41)],
            note: "The 2024 UPC (312.9, as the PPI guide reprints it) asks a No. 18 gauge plate within 1 in instead (R3, R41); the 2009 IPC's wider 1 1/2 in is the cautious choice.",
        ),
        (
            id: "penetration_pex_hole",
            kind: penetration(through: [Wood], needs: Clearance, clearance_m: 0.00635),
            applies: (materials: ["pex"]),
            profiles: ["dwelling_us"],
            standing: Guidance,
            as_read: "holes through wood 1/4 in larger than the tube (PPI guide)",
            source: [R(3), R(41)],
        ),
        (
            id: "penetration_interior_wall_sleeve",
            kind: penetration(through: [InteriorWall], needs: Sleeve),
            applies: (),
            profiles: ["dwelling_us", "ship_us"],
            standing: Ours,
            as_read: "a gasketed sleeve where a run crosses an interior wall",
