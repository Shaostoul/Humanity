        (
            id: "power_cord",
            name: "Flexible power cord (portable cord, type SOOW)",
            behaviour: Flexible,
            form: Cable,
            carries: [Electricity],
            conductor: Copper,
            tags: ["unarmoured", "multiconductor"],
            look: (srgb: (26, 26, 31), metallic: 0.0, roughness: 0.6, note: "Black cord, ConduitKind::color()'s power-cord colour since v0.535."),
            source: [R(45), Ours("the game's power run since v0.535 is a flexible cord (the operator: 'flexible tubes are hoses and power extension cords')")],
            note: "Type SOOW is hard service cord, 600 V, 18 to 2 AWG (the 2014 NEC's Table 400.4, R45). No cord maker's sheet was read, so these sizes have no outside diameter or bend radius yet: the bend rules that need a diameter (4 times it, R22) have nothing to measure until one is. AMPACITY: each size's figure is the 2014 NEC's 60 C copper column (Table 310.15(B)(16), R45), which for a cord is Table 400.5(A)(1)'s two-conductor column (18, 25, 30, 55 A) held to 240.4(D)'s 15, 20 and 30 A for 14 to 10 AWG; a cord with three current-carrying conductors is rated lower, 15, 20, 25 and 45 A.",
            sizes: [
                (
                    id: "cu_awg14", size: "14 AWG", label: "Copper 14 AWG",
                    awg: 14, ampacity_a: 15.0, voltage_max: 600.0, ohm_per_m: 0.00828, grade: Home, cost_per_m: 0.8,
                    source: [R(45), R(47), Ours("the registry's row since v0.604 (data/utilities/conduits.ron), kept through the merge: its cost is ours, and so is reading the NEC's tables for a two-conductor 120 V circuit (the material's note)")],
                    note: "Standard 15 A home lighting + receptacle circuit. Cheapest; fine for lamps + small loads. Resistance: standard annealed copper at 20 C, 8.28 ohms per km (NBS Handbook 100, R47; 8.286 until 2026-11-02).",
                ),
                (
                    id: "cu_awg12", size: "12 AWG", label: "Copper 12 AWG",
                    awg: 12, ampacity_a: 20.0, voltage_max: 600.0, ohm_per_m: 0.00521, grade: Home, cost_per_m: 1.2,
                    source: [R(45), R(47), Ours("as cu_awg14: the cost and the two-conductor reading are ours")],
                    note: "20 A home circuit -- kitchen/appliance + pumps. The workhorse residential cable. 5.21 ohms per km at 20 C (R47).",
                ),
                (
                    id: "cu_awg10", size: "10 AWG", label: "Copper 10 AWG",
                    awg: 10, ampacity_a: 30.0, voltage_max: 600.0, ohm_per_m: 0.003277, grade: Home, cost_per_m: 1.9,
                    source: [R(45), R(47), Ours("as cu_awg14: the cost and the two-conductor reading are ours")],
                    note: "30 A circuit -- water heater, dryer, EV charger, heavier machines. 3.277 ohms per km at 20 C (R47).",
                ),
                (
                    id: "cu_awg6_ind", size: "6 AWG", label: "Copper 6 AWG (industrial)",
                    awg: 6, ampacity_a: 55.0, voltage_max: 600.0, ohm_per_m: 0.001297, shielded: true, grade: Industrial, cost_per_m: 4.5,
                    source: [R(45), R(47), Ours("as cu_awg14: the cost and the two-conductor reading are ours; shielded is the registry's game flag, not a property of type SOOW")],
                    note: "55 A shielded feeder for industrial machines / sub-panels. Overkill (+expensive) at home. 1.297 ohms per km at 20 C (R47; 1.296 until 2026-11-02).",
                ),
            ],
        ),
