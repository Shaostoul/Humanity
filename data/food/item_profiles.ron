// Which items are food, and which nutrition profile each one uses.
//
// Read by src/systems/food.rs for three things at once: whether an item can be
// eaten or drunk, how nourishing it is, and how fast it spoils. The profile ids
// on the right are rows of data/food_system.ron `nutrition_profiles`, where the
// real-world numbers and their sources live.
//
// THE RULE: an item listed under `items` is food. Anything else is not: it
// cannot be eaten or drunk and it never spoils. There is no guessing from the
// item id any more. Before 2026-09-25 food.rs decided by id prefix, which made
// the grain mill and grain silo edible ("grain_") and fish oil and fish scales
// too ("fish_"), gave 18 of the 26 things the cooking recipes make no nutrition
// at all, and let legumes never spoil.
//
// `not_food` lists the items that data/items.csv files under category "food"
// but that people do not eat, each with the reason. The runtime never reads it;
// it exists so the coverage test in food.rs can insist that every food-category
// item has been decided one way or the other. If you add a food item to
// items.csv, add it to one of the two lists below or that test fails.
//
// A profile stands for a group of foods (see its notes in food_system.ron for
// which members sit furthest from the base food). Where an item is filed under
// a group its items.csv subcategory would not suggest, the line says why.
//
// FORMAT: (item_id, profile_id) and (item_id, reason). Ids must match
// data/items.csv exactly; a typo is caught by the test, not silently ignored.
(
    items: [
        // --- Water and drinks ---
        ("water_bottle_0", "water"),
        ("water_purified_0", "water"),        // items.csv files it as material/liquid; it is drinking water
        ("juice_0", "fruit_juice"),
        ("energy_drink_0", "energy_drink"),
        ("coffee_0", "brewed_coffee"),        // roasted beans; drinking one = brewing a cup
        ("tea_0", "brewed_tea"),              // dried leaves; drinking one = brewing a cup
        ("milk_0", "milk"),                   // also what the homestead's goats produce
        ("ors_solution_0", "oral_rehydration_solution"), // a sachet mixed into a litre of water (mix_ors)

        // --- Meat, fish, eggs, dairy, fats ---
        ("raw_meat_0", "raw_meat"),
        ("raw_beef_0", "raw_meat"),
        ("raw_pork_0", "raw_meat"),
        ("raw_mutton_0", "raw_meat"),
        ("raw_venison_0", "raw_meat"),
        ("raw_poultry_0", "raw_meat"),
        ("alien_meat_0", "raw_meat"),         // fictional creature; modelled as ordinary raw meat
        ("raw_fish_0", "raw_fish"),
        ("roast_chicken_0", "cooked_meat"),
        ("fish_grilled_0", "cooked_fish"),
        ("egg_0", "eggs"),
        ("cheese_0", "cheese"),
        ("butter_0", "fats_oils"),
        ("cooking_oil_0", "fats_oils"),
        ("animal_fat_0", "fats_oils"), // rendered tallow (render_tallow); fat_0 was a duplicate, removed 2026-09-25
        ("blubber_0", "fats_oils"),
        ("sky_blubber_0", "fats_oils"),       // fictional creature; rendered fat like any other

        // --- Preserved and packaged ---
        ("canned_food_0", "canned_food"),
        ("mre_0", "field_ration"),
        ("ration_basic_0", "field_ration"),
        ("jerky_0", "jerky"),
        ("dried_meat_0", "jerky"),
        ("dried_fruit_0", "dried_fruit"),
        ("fruit_date_palm_0", "dried_fruit"), // dates are eaten semi-dry; 277 kcal like dried fruit
        ("protein_bar_0", "protein_bar"),
        ("honey_0", "honey"),
        ("sugar_0", "sugar"),

        // --- Baked goods and cooked dishes (the outputs of the cooking recipes) ---
        ("bread_0", "bread"),
        ("cake_0", "cake"),
        ("cookies_batch_0", "cookies"),
        ("pie_0", "fruit_pie"),
        ("soup_vegetable_0", "vegetable_soup"),
        ("stew_meat_0", "meat_stew"),
        ("sandwich_0", "sandwich"),
        ("pasta_cooked_0", "pasta_dish"),
        ("pizza_slice_0", "pizza"),
        ("omelette_0", "omelette"),
        ("porridge_0", "porridge"),
        ("cooked_rice_0", "cooked_rice"),     // milled rice boiled in water (cook_rice)
        ("salad_0", "raw_vegetables"),        // raw lettuce, tomato and carrot, no dressing

        // --- Grains and flour (dry, keep for a year) ---
        ("rice_0", "grains"),                 // milled white rice (mill_rice); the paddy is under not_food
        ("flour_0", "grains"),
        ("grain_wheat_0", "grains"),
        ("grain_corn_0", "grains"),
        ("barley_dehulled_0", "grains"),      // the covered barley harvest dehulled (dehull_barley); the harvest is under not_food
        ("oat_groats_0", "grains"),           // whole oats dehulled (dehull_oats)
        ("spelt_dehulled_0", "grains"),       // spelt in the hull dehulled (dehull_spelt)
        ("grain_rye_0", "grains"),
        ("grain_sorghum_0", "grains"),
        ("grain_millet_0", "grains"),
        ("grain_amaranth_0", "grains"),
        ("grain_quinoa_0", "grains"),
        ("grain_buckwheat_0", "grains"),
        ("grain_teff_0", "grains"),
        ("grain_finger_millet_0", "grains"),
        ("grain_triticale_0", "grains"),

        // --- Legumes (dry pulses keep for a year; green peas for days) ---
        ("legume_bean_0", "legumes_dry"),
        ("legume_soybean_0", "legumes_dry"),
        ("legume_lentil_0", "legumes_dry"),
        ("legume_chickpea_0", "legumes_dry"),
        ("legume_cowpea_0", "legumes_dry"),
        ("legume_fava_bean_0", "legumes_dry"),
        ("legume_pigeon_pea_0", "legumes_dry"),
        ("legume_lupin_0", "legumes_dry"),
        ("legume_mung_bean_0", "legumes_dry"),
        ("legume_bambara_groundnut_0", "legumes_dry"),
        ("legume_pea_0", "legumes_fresh"),    // plants.csv: "producing edible pods", eaten green

        // --- Nuts and seeds ---
        ("legume_peanut_0", "nuts_seeds"),    // a legume, but eaten and stored like a nut
        ("fruit_hazelnut_0", "nuts_seeds"),
        ("fruit_walnut_0", "nuts_seeds"),
        ("fruit_sunflower_0", "nuts_seeds"),  // grown for the seeds
        ("grain_sesame_0", "nuts_seeds"),     // an oilseed that is also eaten whole
        ("fruit_coconut_0", "coconut_meat"),

        // --- Fruit ---
        ("fruit_apple_0", "fruit"),
        ("fruit_banana_0", "fruit"),
        ("fruit_orange_0", "fruit"),
        ("fruit_lemon_0", "fruit"),
        ("fruit_berries_0", "fruit"),
        ("fruit_strawberry_0", "fruit"),
        ("fruit_blueberry_0", "fruit"),
        ("fruit_cranberry_0", "fruit"),
        ("fruit_grape_0", "fruit"),
        ("fruit_cherry_0", "fruit"),
        ("fruit_watermelon_0", "fruit"),
        ("fruit_peach_0", "fruit"),
        ("fruit_pear_0", "fruit"),
        ("fruit_plum_0", "fruit"),
        ("fruit_mango_0", "fruit"),
        ("fruit_pineapple_0", "fruit"),
        ("fruit_fig_0", "fruit"),
        ("fruit_pomegranate_0", "fruit"),
        ("fruit_prickly_pear_0", "fruit"),

        // --- Vegetables (fresh, keep about a week) ---
        ("vegetable_tomato_0", "raw_vegetables"),
        ("fruit_pepper_0", "raw_vegetables"),   // botanical fruit, eaten as a vegetable
        ("fruit_eggplant_0", "raw_vegetables"), // botanical fruit, eaten as a vegetable
        ("fruit_pumpkin_0", "raw_vegetables"),  // botanical fruit, eaten as a vegetable
        ("vegetable_cucumber_0", "raw_vegetables"),
        ("vegetable_zucchini_0", "raw_vegetables"),
        ("vegetable_squash_0", "raw_vegetables"),
        ("vegetable_okra_0", "raw_vegetables"),
        ("vegetable_lettuce_0", "raw_vegetables"),
        ("vegetable_spinach_0", "raw_vegetables"),
        ("vegetable_kale_0", "raw_vegetables"),
        ("vegetable_collard_0", "raw_vegetables"),
        ("vegetable_chard_0", "raw_vegetables"),
        ("vegetable_mustard_greens_0", "raw_vegetables"),
        ("vegetable_arugula_0", "raw_vegetables"),
        ("vegetable_mache_0", "raw_vegetables"),
        ("vegetable_chicory_0", "raw_vegetables"),
        ("vegetable_bok_choy_0", "raw_vegetables"),
        ("vegetable_cabbage_0", "raw_vegetables"),
        ("vegetable_brussels_sprout_0", "raw_vegetables"),
        ("vegetable_broccoli_0", "raw_vegetables"),
        ("vegetable_cauliflower_0", "raw_vegetables"),
        ("vegetable_celery_0", "raw_vegetables"),
        ("vegetable_fennel_0", "raw_vegetables"),
        ("vegetable_asparagus_0", "raw_vegetables"),
        ("vegetable_artichoke_0", "raw_vegetables"),
        ("vegetable_rhubarb_0", "raw_vegetables"),  // the stalks only; the leaf blades are not eaten
        ("vegetable_radish_0", "raw_vegetables"),   // 16 kcal, closer to salad than to carrots
        ("vegetable_moringa_0", "raw_vegetables"),  // leaves; 64 kcal, the densest member of the group
        ("herb_dandelion_0", "raw_vegetables"),     // eaten as a leafy green, not a garnish
        ("vegetable_oyster_mushroom_0", "raw_vegetables"),
        ("vegetable_shiitake_0", "raw_vegetables"),
        ("vegetable_button_mushroom_0", "raw_vegetables"),
        ("vegetable_runner_bean_0", "raw_vegetables"), // green pods, 31 kcal (FDC 169961): nearer 25 here than fresh peas' 81

        // --- Roots and bulbs (keep for weeks) ---
        ("vegetable_carrot_0", "root_vegetables"),
        ("vegetable_beet_0", "root_vegetables"),
        ("vegetable_turnip_0", "root_vegetables"),
        ("vegetable_rutabaga_0", "root_vegetables"),
        ("vegetable_parsnip_0", "root_vegetables"),
        ("vegetable_sugar_beet_0", "root_vegetables"),
        ("vegetable_horseradish_0", "root_vegetables"),
        ("vegetable_onion_0", "root_vegetables"),
        ("vegetable_leek_0", "root_vegetables"),
        ("herb_ginger_0", "root_vegetables"),       // a fresh rhizome
        ("herb_turmeric_0", "root_vegetables"),     // a fresh rhizome

        // --- Starchy staples ---
        ("vegetable_potato_0", "starchy_vegetables"),
        ("vegetable_sweet_potato_0", "starchy_vegetables"),
        ("vegetable_yam_0", "starchy_vegetables"),
        ("vegetable_taro_0", "starchy_vegetables"),
        ("vegetable_jerusalem_artichoke_0", "starchy_vegetables"),
        ("vegetable_oca_0", "starchy_vegetables"),
        ("vegetable_corn_0", "starchy_vegetables"), // sweet corn ear, 86 kcal
        ("vegetable_garlic_0", "starchy_vegetables"), // 149 kcal and keeps a month, like the tubers
        ("fruit_plantain_0", "starchy_vegetables"), // harvested green and cooked as a starch
        ("fruit_breadfruit_0", "starchy_vegetables"),
        ("fruit_chestnut_0", "starchy_vegetables"), // a starchy, low-fat nut, milled like grain
        ("vegetable_cassava_0", "cassava"),

        // --- Culinary herbs, eaten fresh ---
        ("herb_basil_0", "fresh_herbs"),
        ("herb_mint_0", "fresh_herbs"),
        ("herb_parsley_0", "fresh_herbs"),
        ("herb_cilantro_0", "fresh_herbs"),
        ("herb_dill_0", "fresh_herbs"),
        ("herb_chive_0", "fresh_herbs"),
        ("herb_rosemary_0", "fresh_herbs"),
        ("herb_thyme_0", "fresh_herbs"),
        ("herb_oregano_0", "fresh_herbs"),
        ("herb_sage_0", "fresh_herbs"),
        ("herb_lemongrass_0", "fresh_herbs"),
        ("herb_lavender_0", "fresh_herbs"),
        ("herb_chamomile_0", "fresh_herbs"),
        ("herb_tea_0", "fresh_herbs"),              // fresh tea leaves, before drying
    ],

    not_food: [
        // --- Seasonings and brewing crops: used to flavour other food, not eaten ---
        ("salt_food_0", "table salt: a seasoning with no food energy, never eaten on its own"),
        ("spice_mix_0", "a seasoning blend used by the pinch in cooking"),
        ("herb_cinnamon_0", "dried cinnamon quills: a spice used by the pinch"),
        ("herb_saffron_0", "fresh saffron stigmas are dried into threads and used by the pinch"),
        ("herb_vanilla_0", "cured vanilla beans flavour food by the pinch; they are not eaten as food"),
        ("herb_hop_0", "hop cones flavour beer; they are not eaten"),
        ("fruit_coffee_0", "coffee cherries are grown for the bean, which is roasted and brewed (the cook_coffee recipe); the cherry is not a food"),
        ("fruit_cacao_0", "fermented, dried cocoa beans are roasted and winnowed into nibs before they are eaten or made into chocolate; roasting is not modelled yet"),
        ("fruit_olive_0", "olives straight from the tree are too bitter to eat; they are cured in brine or pressed for oil first (pressing exists: press_oil_olive; curing does not yet)"),
        ("whey_0", "the liquid left from cheese making; used here in baking (cook_bread_whey), drinking it is not modelled yet"),
        ("apple_pomace_0", "the pressed skins, cores and pulp left from juicing; composted here (compost_apple_pomace), not eaten"),
        ("beeswax_0", "the wax of crushed and strained honeycomb (cook_honey), a block for candles (craft_candle); wax is not food"),

        // --- Grain that must be milled or dehulled first ---
        ("grain_rice_0", "paddy rice is still in its hull, which is not eaten; mill it into white rice (mill_rice) and cook that"),
        ("grain_barley_0", "covered barley still has its fibrous husk, which is not eaten; dehull it (dehull_barley) and eat the grain"),
        ("grain_oat_0", "whole oats are still in their hulls, which are not eaten; dehull them into groats (dehull_oats)"),
        ("grain_spelt_0", "spelt comes off the thresher in its hull, which is not eaten; dehull it (dehull_spelt) before milling or cooking"),

        // --- Oilseeds grown for pressing ---
        ("grain_rapeseed_0", "grown to be pressed for oil; the seed is not eaten as it is"),
        ("grain_camelina_0", "grown to be pressed for oil; the seed is not eaten as it is"),
        ("grain_safflower_0", "grown to be pressed for oil; the hard-hulled seed is not eaten as it is"),

        // --- Spoiled ---
        ("rotten_flesh_0", "decomposing meat; not food at any stage"),

    ],

    // HOW MUCH ONE DRINK IS (2026-10-20): (item id, litres). A drink puts back
    // the water it carries: these litres, times the share of the drink that is
    // water (worked out from its profile in data/food_system.ron), at 20
    // Hydration points a litre (src/systems/food.rs, HYDRATION_PER_LITRE: the
    // bar empties in two days at the 2.5 L a day a resting adult loses). So a
    // 500 mL bottle of water puts back 10 points and a litre of milk about 18.
    // Until then every drink gave 30 points, 1.5 L, whatever it was.
    //
    // Every item above whose profile is a beverage needs a row here, and a
    // vessel in data/containers/fluids.ron drinks the litres it is filled with
    // (the coverage test in src/systems/food.rs checks both).
    drinks: [
        ("water_bottle_0", 0.5),     // items.csv "Purified drinking water 500ml"; fluids.ron fills it with 0.5 L
        ("water_purified_0", 1.0),   // items.csv "Filtered clean water jug", 1.0 kg: a litre
        ("juice_0", 0.5),            // items.csv "Fruit juice bottle 500ml"
        ("energy_drink_0", 0.33),    // a 330 mL can: items.csv's 0.35 kg is that much drink and its can
        ("coffee_0", 0.237),         // one cup brewed: USDA's cup of brewed coffee, 8 fl oz, 237 g (SR Legacy NDB 14209)
        ("tea_0", 0.237),            // one cup brewed: USDA's cup of brewed black tea, 8 fl oz, 237 g (SR Legacy NDB 14355)
        ("milk_0", 1.0),             // items.csv "Fresh whole milk 1L"
        ("ors_solution_0", 1.0),     // items.csv "Oral Rehydration Solution (1 L)"
    ],

    // HOW MUCH FOOD ONE ITEM IS (2026-10-20): (item id, grams eaten). Eating
    // one puts back what those grams carry: their food energy (the profile's
    // kcal per 100 g in data/food_system.ron) as Satiation, a day's 2,000 kcal
    // for a day's hunger, and their water (the profile's water_g) as
    // Hydration, at 20 points a litre (src/systems/food.rs, SATIATION_PER_KCAL
    // and HYDRATION_PER_LITRE). Until then an item gave the same whatever it
    // weighed: 0.15 Satiation for each kcal in 100 g of its food, so a 50 g
    // bunch of basil fed like 100 g of it and a 300 g loaf of bread gave 40
    // points, nearly three days of hunger; and 10 Hydration for any produce,
    // 3 for anything else.
    //
    // THE GRAMS are what is eaten of the item as data/items.csv weighs it
    // (weight_kg): the whole item, less the part USDA counts as refuse, the
    // peel, core, pits, shell, rind, husk, cob or bone. Farming and the
    // harvest count an item at its items.csv weight, so a 0.3 kg "Fresh
    // harvested strawberry" is a picking of 300 g, and 282 g of it is eaten.
    // The refuse figures are USDA's, read 2026-10-20 from the SR28 page
    // reports by food group (USDA ARS, "USDA National Nutrient Database for
    // Standard Reference, Release 28", https://www.ars.usda.gov/ARSUserFiles/
    // 80400535/Data/SR/SR28/reports/sr28fgNN.pdf, NN the food group: 09 fruit,
    // 11 vegetables, 12 nuts, 02 herbs, 01 eggs, 05 poultry), cited by NDB
    // number on each line. Where an item is one natural thing (an apple, an
    // egg, an ear of corn) the line also gives USDA's household portion of it
    // (the same report, or FoodData Central's portions for the same food), and
    // the two land within a tenth or so of each other.
    //
    // Packaging is not weighed apart anywhere in the game (a 500 mL water
    // bottle weighs 0.5 kg in items.csv and is drunk as 0.5 L), so a packed
    // food's grams are its items.csv weight. A drink is not listed here: one
    // drink is its `drinks` litres, taken as that many kilograms (a cup of
    // whole milk is 244 g against 236.6 mL, so milk and juice read 3 to 5%
    // light). Meat is boneless: a carcass drops its bones as their own item
    // (data/creatures.csv).
    //
    // Every item in `items` that is not a drink needs a row, and no row may
    // say more grams than items.csv weighs the item (the coverage test
    // every_food_says_how_much_of_it_is_eaten in src/systems/food.rs).
    portions: [
        // --- Meat, fish, eggs, dairy, fats ---
        ("raw_meat_0", 600.0),       // items.csv 0.6 kg of butchered meat, the bones apart
        ("raw_beef_0", 600.0),
        ("raw_pork_0", 600.0),
        ("raw_mutton_0", 600.0),
        ("raw_venison_0", 600.0),
        ("raw_poultry_0", 600.0),
        ("alien_meat_0", 600.0),
        ("raw_fish_0", 600.0),
        ("roast_chicken_0", 1005.0), // a 1.5 kg whole roast bird less USDA's 33% bone (NDB 05009, broiler meat and skin, roasted)
        ("fish_grilled_0", 400.0),   // a 0.4 kg fillet
        ("egg_0", 52.8),             // 60 g in the shell less USDA's 12% shell (NDB 01123); USDA's large egg is 50 g, extra large 56 g
        ("cheese_0", 300.0),
        ("butter_0", 250.0),
        ("cooking_oil_0", 461.0),    // 500 mL at USDA's 218 g a cup (NDB 04582, canola oil; a cup is 236.6 mL); the 0.5 kg is that and its bottle
        ("animal_fat_0", 500.0),
        ("blubber_0", 500.0),
        ("sky_blubber_0", 500.0),

        // --- Preserved and packaged ---
        ("canned_food_0", 400.0),
        ("mre_0", 500.0),            // field_ration is per 100 g of PACKED ration, so all 0.5 kg
        ("ration_basic_0", 400.0),   // the same
        ("jerky_0", 100.0),
        ("dried_meat_0", 100.0),
        ("dried_fruit_0", 150.0),
        ("fruit_date_palm_0", 276.0), // 0.3 kg less USDA's 8% pits (NDB 09421, medjool, the 277 kcal date)
        ("protein_bar_0", 80.0),
        ("honey_0", 500.0),
        ("sugar_0", 500.0),

        // --- Baked goods and cooked dishes: the whole item ---
        ("bread_0", 300.0),          // a 300 g loaf, about ten of USDA's 29 g slices (NDB 18069)
        ("cake_0", 1000.0),
        ("cookies_batch_0", 300.0),
        ("pie_0", 800.0),
        ("soup_vegetable_0", 600.0),
        ("stew_meat_0", 700.0),
        ("sandwich_0", 300.0),
        ("pasta_cooked_0", 400.0),
        ("pizza_slice_0", 250.0),
        ("omelette_0", 300.0),
        ("porridge_0", 400.0),
        ("cooked_rice_0", 350.0),
        ("salad_0", 400.0),

        // --- Grains, flour and dry legumes: 500 g and 300 g bags, no refuse ---
        ("rice_0", 500.0),
        ("flour_0", 500.0),
        ("grain_wheat_0", 500.0),
        ("grain_corn_0", 500.0),
        ("barley_dehulled_0", 500.0),
        ("oat_groats_0", 500.0),
        ("spelt_dehulled_0", 500.0),
        ("grain_rye_0", 500.0),
        ("grain_sorghum_0", 500.0),
        ("grain_millet_0", 500.0),
        ("grain_amaranth_0", 500.0),
        ("grain_quinoa_0", 500.0),
        ("grain_buckwheat_0", 500.0),
        ("grain_teff_0", 500.0),
        ("grain_finger_millet_0", 500.0),
        ("grain_triticale_0", 500.0),
        ("legume_bean_0", 300.0),
        ("legume_soybean_0", 300.0),
        ("legume_lentil_0", 300.0),
        ("legume_chickpea_0", 300.0),
        ("legume_cowpea_0", 300.0),
        ("legume_fava_bean_0", 300.0),
        ("legume_pigeon_pea_0", 300.0),
        ("legume_lupin_0", 300.0),
        ("legume_mung_bean_0", 300.0),
        ("legume_bambara_groundnut_0", 300.0),
        ("legume_pea_0", 300.0),     // already shelled (USDA's 62% refuse for green peas is the pods, NDB 11304)

        // --- Nuts and seeds: the kernel of what is weighed in the shell ---
        // The edible shares are the ones data/food/crop_nutrition.ron uses for
        // the same harvest items, sourced there.
        ("legume_peanut_0", 200.1),  // 0.3 kg in the shell x 0.667 kernel (Alternative Field Crops Manual, "Peanut")
        ("fruit_hazelnut_0", 123.0), // 0.3 kg less USDA's 59% shells (NDB 12120)
        ("fruit_walnut_0", 135.0),   // 0.3 kg less USDA's 55% shells (NDB 12155)
        ("fruit_sunflower_0", 375.0), // 0.5 kg of oil-type seed less a 25% hull (Feedipedia; USDA's 46% is the thick-hulled confection seed, NDB 12036)
        ("grain_sesame_0", 500.0),   // eaten whole, no refuse (NDB 12023)
        ("fruit_coconut_0", 156.0),  // 0.3 kg husked coconut less USDA's 48% "Shells (brown), skin, water" (NDB 12104): the meat

        // --- Fruit: items.csv weight less USDA's refuse ---
        ("fruit_apple_0", 180.0),    // 0.2 kg less 10% core and stem (NDB 09003); USDA's medium apple is 182 g
        ("fruit_banana_0", 96.0),    // 0.15 kg less 36% skin (NDB 09040); USDA's small banana is 101 g
        ("fruit_orange_0", 146.0),   // 0.2 kg less 27% peel and seeds (NDB 09200); USDA's small orange 96 g, large 184 g
        ("fruit_lemon_0", 159.0),    // 0.3 kg less 47%, 45% peel and 2% seeds (NDB 09150)
        ("fruit_berries_0", 96.0),   // 0.1 kg less 4% caps and spoiled berries (raspberries NDB 09302, blackberries 09042)
        ("fruit_strawberry_0", 282.0), // 0.3 kg less 6% caps and stems (NDB 09316)
        ("fruit_blueberry_0", 285.0), // 0.3 kg less 5% stems and spoiled berries (NDB 09050)
        ("fruit_cranberry_0", 294.0), // 0.3 kg less 2% stems and spoiled berries (NDB 09078)
