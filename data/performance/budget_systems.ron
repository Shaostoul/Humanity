// HumanityOS RESOURCE BUDGET REGISTRY (resource budgets increment 1, MEASURE).
// See docs/design/resource-budgets.md.
//
// One row per SYSTEM that shows up as a slice of one of the four pies on the
// Performance page (Platform > Performance). Adding a system to the pie is
// adding a row here - no code change (infinite-of-X).
//
//   id          stable key (also the increment-2 allocation key)
//   display     what the slice is labelled in the UI
//   category    which pie it belongs to: "gpu" | "cpu" | "vram" | "ram"
//   sources     measurement ids summed into this slice. GPU passes are
//               "gpu.*" (wgpu timestamp queries); a "gpu.x" id automatically
//               reads "cpu.x" instead on adapters without timestamp queries.
//               CPU stages are "cpu.*", allocations "vram.*" / "ram.*".
//               An id nothing reports yet contributes 0 - that is how a row
//               can be added before its measurement is wired.
//   locked      true = a floor system the operator may not starve in
//               increment 2 (the UI, the world core). Read-only today; the
//               pie draws locked slices with a marked label.
//   base_frac   the share of its pie this system is expected to want on a
//               balanced machine, 0..1. Increment 1 only DISPLAYS it next to
//               the measured share, so "expected vs actual" is visible.
//   note        one line of plain English shown on hover.
//
// HONEST LIMITS (do not silently "fix" these by renaming rows):
//  * GPU timestamps measure PASSES, and this engine draws terrain, sky, water
//    and clouds inside ONE pass (they share a megashader and branch per
//    material), so they share one row until the pass is split.
//  * The bloom post-process is wired for timing but DORMANT: nothing calls
//    BloomPass::apply today (bloom_intensity defaults to 0), so its share of
//    the "God rays + SSAO + bloom" row is 0 until bloom is switched back on.
//  * The ECS tick is ONE slice ("Game systems"), measured by the frame loop's
//    cpu.systems stage. Every individual system is ALSO measured, as
//    cpu.system.<slug> (farming, weather, ai, ...), and those numbers are in
//    the live store and the HUMANITY_FRAME_COSTS JSON drop - they are not rows
//    here because the pie SUMS its rows, so listing a system next to the total
//    would count that system's milliseconds twice. Increment 2's editor gets
//    the drill-down; the invariant is guarded by the
//    ecs_tick_is_not_counted_twice_on_the_cpu_pie test.
[
    // ── GPU pie: where the frame's milliseconds go on the graphics card ──
    (
        id: "world_surface",
        display: "World surface",
        category: "gpu",
        // gpu.celestial: the opaque terrain/planet/sky pass. gpu.celestial_t:
        // the TRANSPARENT celestial pass (thousands of alpha-blended ocean
        // shell patches plus the water depth prepass; 42% of an ocean frame
        // in the 2026-09-18 measurement). gpu.sky_view: the distant-sky
        // lookup table refreshed each frame near an atmosphere.
        sources: ["gpu.celestial", "gpu.celestial_t", "gpu.sky_view"],
        locked: true,
        base_frac: 0.35,
        color: "nav_sim",
        note: "Terrain patches, planets, sky and the ocean shells: the opaque and transparent celestial passes plus the sky-view table.",
    ),
    (
        id: "clouds",
        display: "Clouds",
        category: "gpu",
        // The cloud passes in frame order: the planet-fixed sun-light cache
        // (cloud_light), the per-ray screen march (cloud_screen), the
        // temporal resolve (cloud_resolve) and the composite over the scene
        // (cloud_composite); cloud_profile / cloud_profile_calib are the far
        // rung's calibration-table passes, which run only when it is armed.
        sources: [
            "gpu.cloud_light", "gpu.cloud_screen", "gpu.cloud_resolve",
            "gpu.cloud_composite", "gpu.cloud_profile", "gpu.cloud_profile_calib",
        ],
        locked: false,
        base_frac: 0.10,
        color: "info",
        note: "The volumetric cloud deck: sun-light cache, screen march, temporal resolve and composite.",
    ),
    (
        id: "screens",
        display: "In-world screens",
        category: "gpu",
        // screen_ui: every framed wall display's egui-to-texture pass (one
        // per screen, summed). screen_sky / screen_scene / screen_transparent
        // / screen_overlay / screen_lines: the camera wall's 10 Hz re-render
        // of the world, every pass of it under its own key so none hides
        // inside the live frame's numbers (the scene pass was 17 ms at
        // 1280 x 720 before the camera got its own render size; the overlay
        // and line passes were summed into gpu.overlay / gpu.lines until
        // the 2026-09-18 review).
        sources: [
            "gpu.screen_ui", "gpu.screen_sky", "gpu.screen_scene",
            "gpu.screen_transparent", "gpu.screen_overlay", "gpu.screen_lines",
        ],
        locked: false,
        base_frac: 0.03,
        color: "nav_tools",
        note: "Wall displays' page renders and the camera wall's re-render of the world.",
    ),
    (
        id: "sun_shadows",
        display: "Sun shadows",
        category: "gpu",
        sources: ["gpu.shadow"],
        locked: false,
        base_frac: 0.12,
        color: "warning",
        note: "The near-field depth pass the sun casts shadows from.",
    ),
    (
        id: "interior_scene",
        display: "Homestead + props",
        category: "gpu",
        sources: ["gpu.scene", "gpu.transparent", "gpu.overlay", "gpu.instanced"],
        locked: true,
        base_frac: 0.15,
        color: "nav_reality",
        note: "Ship and homestead geometry: opaque, glass, and overlay draws.",
    ),
    (
        id: "particles",
        display: "Particles",
        category: "gpu",
        // particles_sim is the compute pass that advances the GPU pool; the
        // other two draw the billboard and GPU pools.
        sources: ["gpu.particles", "gpu.gpu_particles", "gpu.particles_sim"],
        locked: false,
        base_frac: 0.05,
        color: "info",
        note: "Rain, snow, dust and sparks - the billboard and GPU-simulated pools, and the sim step that moves them.",
    ),
    (
        id: "world_lines",
        display: "Orbit + guide lines",
        category: "gpu",
        sources: ["gpu.lines", "gpu.celestial_lines"],
        locked: false,
        base_frac: 0.02,
        color: "orbit_line",
        note: "Orbit paths, rings and placement guides.",
    ),
    (
        id: "interface",
        display: "Interface (egui)",
        category: "gpu",
        sources: ["gpu.ui", "gpu.clear"],
        locked: true,
        base_frac: 0.06,
        color: "accent",
        note: "The app's own panels and HUD. Timed once the egui pass in lib.rs is wired.",
    ),
    (
        id: "stars",
        display: "Star field",
        category: "gpu",
        sources: ["gpu.stars"],
        locked: false,
        base_frac: 0.05,
        color: "constellation_line",
        note: "The 16.8 M-point sky. Timed once the star pass in lib.rs is wired.",
    ),
    (
        id: "post_process",
        display: "God rays + SSAO + bloom",
        category: "gpu",
        sources: ["gpu.godrays", "gpu.ssao", "gpu.bloom"],
        locked: false,
        base_frac: 0.10,
        color: "success",
        note: "Screen-space effects, timed on the graphics card. Bloom reads 0 until the bloom pass is switched on.",
    ),

    // ── CPU pie: where the frame's milliseconds go on the processor ──
    (
        id: "cpu_render_submit",
        display: "Render submission",
        category: "cpu",
        // cpu.stars: the live star pass's submission twin (added 2026-09-18
        // so the Star field GPU row is measurable in the no-timestamp
        // fallback; it read 0 there before).
        sources: [
            "cpu.stars", "cpu.celestial", "cpu.scene", "cpu.transparent",
            "cpu.overlay", "cpu.lines", "cpu.celestial_lines", "cpu.particles",
            "cpu.gpu_particles", "cpu.particles_sim",
        ],
        locked: true,
        base_frac: 0.25,
        color: "nav_sim",
        note: "Building and submitting this frame's draw calls.",
    ),
    (
        id: "cpu_screens",
        display: "In-world screens",
        category: "cpu",
        // The CPU side of the "screens" GPU row: each framed display's egui
        // run + tessellation + submit, and the camera wall's re-render
        // submission, one stage per pass (sky, scene, transparent, overlay,
        // lines) so every gpu.screen_* id has the cpu.screen_* twin the
        // no-timestamp fallback reads.
        sources: [
            "cpu.screen_ui", "cpu.screen_sky", "cpu.screen_scene",
            "cpu.screen_transparent", "cpu.screen_overlay", "cpu.screen_lines",
        ],
        locked: false,
        base_frac: 0.05,
        color: "nav_tools",
        note: "Running the wall displays' pages and submitting the camera wall's re-render.",
    ),
    (
        id: "cpu_present_wait",
        display: "Waiting for the display",
        category: "cpu",
        // Around get_current_texture (acquiring the next swapchain image)
        // and around present(): the time the CPU spends blocked on the
        // display, which is what tells "present wait" from "CPU-bound".
        sources: ["cpu.present_wait"],
        locked: true,
        base_frac: 0.10,
        color: "nav_dev",
        note: "Blocked on the swapchain: vsync and the driver's frame queue. Not work; a frame that is mostly this is GPU- or display-bound.",
    ),
    (
        id: "cpu_fps_cap",
        display: "Frame-rate cap sleep",
        category: "cpu",
        // The deliberate sleep the Settings frame-rate cap adds at the top of
        // each frame. Recorded so it is never mistaken for work.
        sources: ["cpu.fps_cap_sleep"],
        locked: true,
        base_frac: 0.05,
        color: "badge_verified",
        note: "The Settings frame-rate cap sleeping off the rest of the budget. Zero when the cap is off or the frame is slower than the cap.",
    ),
    (
        id: "cpu_post",
        display: "Post-process submit",
        category: "cpu",
        sources: ["cpu.godrays", "cpu.ssao"],
        locked: false,
        base_frac: 0.05,
        color: "success",
        note: "God rays and ambient occlusion, CPU side.",
    ),
    (
        id: "cpu_uploads",
        display: "GPU uploads",
        category: "cpu",
        sources: [
            "cpu.patch_upload", "cpu.grass_upload", "cpu.water_upload",
            "cpu.weather_upload", "cpu.atmo_luts", "cpu.lights",
            "cpu.light_tiles",
        ],
        locked: false,
        base_frac: 0.15,
        color: "info",
        note: "Pushing terrain patches, grass, ocean and weather data to the card.",
    ),
    (
        id: "cpu_terrain_build",
        display: "Terrain build",
        category: "cpu",
        // cpu.patch_select and cpu.mesh_upload were listed here for months
        // with no recorder anywhere in the engine (2026-09-18 sweep); the
        // registry coverage test now refuses a source nothing records.
        sources: ["cpu.patch_build"],
        locked: false,
        base_frac: 0.15,
        color: "nav_reality",
        note: "Meshing the ground you are walking toward. Wired from the frame loop.",
    ),
    (
        id: "cpu_vegetation",
        display: "Trees, grass + garden plants",
        category: "cpu",
        sources: ["cpu.near_tree_harvest", "cpu.grass_harvest", "cpu.plant_rebuild"],
        locked: false,
        base_frac: 0.10,
        color: "warning",
        note: "Choosing which trees and grass tillers stand near you this frame, and rebuilding the garden plant meshes on a frame where a crop changed stage.",
    ),
    (
        id: "cpu_systems",
        display: "Game systems",
        category: "cpu",
        sources: ["cpu.systems"],
        locked: true,
        base_frac: 0.10,
        color: "accent",
        note: "Farming, weather, creatures, vitals - the whole ECS tick. Each system is measured on its own too (cpu.system.farming, cpu.system.weather, cpu.system.ai, ...); the breakdown appears when slices become drillable.",
    ),

    // ── VRAM pie: tracked graphics-memory allocations ──
    (
        id: "vram_terrain",
        display: "Terrain patches",
        category: "vram",
        sources: ["vram.patch_arena"],
        locked: true,
        base_frac: 0.45,
        color: "nav_sim",
        note: "Live geometry in the patch mega-buffers (the reserved arena is larger).",
    ),
    (
        id: "vram_meshes",
        display: "Meshes",
        category: "vram",
        sources: ["vram.meshes"],
        locked: true,
        base_frac: 0.15,
        color: "nav_reality",
        note: "Homestead, props, trees and unbatched geometry.",
    ),
    (
        id: "vram_textures",
        display: "Textures",
        category: "vram",
        sources: ["vram.textures"],
        locked: false,
        base_frac: 0.15,
        color: "info",
        note: "Planet imagery and baked bark uploaded as material textures.",
    ),
    (
        id: "vram_targets",
        display: "Render targets",
        category: "vram",
        sources: ["vram.render_targets"],
        locked: true,
        base_frac: 0.08,
        color: "success",
        note: "Scene colour, depth, shadow map, sky and ocean lookup textures.",
    ),
    (
        id: "vram_particles",
        display: "Particles",
        category: "vram",
        sources: ["vram.particles"],
        locked: false,
        base_frac: 0.03,
        color: "orbit_line",
        note: "Billboard and GPU-simulation particle pools.",
    ),
    (
        id: "vram_grass",
        display: "Grass",
        category: "vram",
        sources: ["vram.grass"],
        locked: false,
        base_frac: 0.03,
        color: "warning",
        note: "Near-field grass tiller mesh and its instance buffer.",
    ),
    (
        id: "vram_uniforms",
        display: "Uniforms + lights",
        category: "vram",
        sources: ["vram.uniforms"],
        locked: true,
        base_frac: 0.01,
        color: "accent",
        note: "Camera, object, light and tile buffers rewritten every frame.",
    ),

    // ── RAM pie: the process's own memory ──
    (
        id: "ram_resident",
        display: "In RAM now",
        category: "ram",
        sources: ["ram.resident"],
        locked: true,
        base_frac: 0.80,
        color: "nav_sim",
        note: "Working set: the part of the app actually held in physical memory.",
    ),
    (
        id: "ram_committed",
        display: "Committed, paged out",
        category: "ram",
        sources: ["ram.committed_extra"],
        locked: false,
        base_frac: 0.20,
        color: "info",
        note: "Memory the app has claimed that is not resident right now.",
    ),
]
