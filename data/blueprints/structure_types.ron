// Structural building pieces (v0.583) -- the data-driven registry the construction "Structure"
// palette renders and an AI can enumerate. Add a buildable by adding one entry; no code.
//   kind  = what it DOES (drives behaviour: Stairs/Ladder ascend, Elevator/Teleporter transport).
//   shape = the placeholder GEOMETRY builder (Box/Steps/Ramp/Ladder/Frame/Slab).
//   size  = (width X, height Y, depth Z) in metres.   color = rgb.   steps = step/rung count.
// Wall is special: selecting it enters the wall-DRAW tool (segment chains), it is never "placed".
[
    (
        id: "wall", label: "Wall", category: "Structure",
        kind: Wall, shape: Box, size: (0.15, 3.0, 1.0), color: (0.6, 0.6, 0.62), steps: 0,
        note: "Draw interior wall segments by clicking corner nodes on the floor. Right-click finishes.",
    ),
    (
        id: "stairs", label: "Stairs", category: "Structure",
        kind: Stairs, shape: Steps, size: (1.2, 3.0, 4.5), color: (0.55, 0.55, 0.58), steps: 16,
        note: "A staircase climbing one 3.0 m storey: 16 risers of 187.5 mm on 281 mm treads, 33.7 degrees, 1.2 m wide, inside the 2021 IRC and England's Approved Document K (docs/reference/findings/2026-10-20-stairs-guards-and-headroom.md). It has no handrails yet, which both codes ask for. Walk up it (the ground-height sampler lifts you step to step).",
    ),
    (
        id: "ramp", label: "Ramp", category: "Structure",
        kind: Stairs, shape: Ramp, size: (1.8, 1.2, 4.5), color: (0.5, 0.5, 0.52), steps: 0,
        note: "A smooth inclined ramp -- cart / wheelchair friendly. Walk straight up the slope.",
    ),
    (
        id: "ladder", label: "Ladder", category: "Structure",
        kind: Ladder, shape: Ladder, size: (0.6, 3.0, 0.16), color: (0.72, 0.55, 0.2), steps: 10,
        note: "A vertical ladder. Stand at it and hold Space to climb up (Shift to descend); step off at the top onto a deck. Let go of the keys part way and you hold on; step away from it there and you fall.",
    ),
    (
        id: "elevator", label: "Elevator", category: "Structure",
        kind: Elevator, shape: Frame, size: (1.8, 3.0, 1.8), color: (0.45, 0.5, 0.6), steps: 0,
        note: "An elevator: step onto the car and it rides to the other floor; wait in the shaft to recall it. Place a deck at the top to step off.",
    ),
    (
        id: "teleporter", label: "Teleporter", category: "Structure",
        kind: Teleporter, shape: Frame, size: (1.4, 2.6, 0.4), color: (0.3, 0.8, 0.9), steps: 0,
        note: "A teleport arch. Step through to jump instantly to its paired pad (set the pair in its detail).",
    ),
    (
        id: "train", label: "Train platform", category: "Structure",
        kind: Train, shape: Box, size: (3.0, 0.4, 8.0), color: (0.4, 0.42, 0.45), steps: 0,
        note: "A boarding platform. Pair it with another platform (in its detail panel) and a rail track connects the two.",
    ),
    (
        id: "road", label: "Road", category: "Structure",
        kind: Road, shape: Slab, size: (4.0, 0.12, 6.0), color: (0.22, 0.22, 0.24), steps: 0,
        note: "A paved road segment. Carries a fixed top-to-bottom material stack (asphalt / base / subgrade).",
    ),
    (
        id: "deck", label: "Floor / deck", category: "Structure",
        kind: Deck, shape: Slab, size: (4.0, 0.2, 4.0), color: (0.5, 0.52, 0.55), steps: 0,
        note: "A flat upper-level floor. Set 'Place at height' to the top of a staircase, then walk up onto it.",
    ),
    (
        id: "guard", label: "Guard (balustrade)", category: "Structure",
        kind: Guard, shape: Balustrade, size: (1.2, 1.0, 0.06), color: (0.55, 0.57, 0.62), steps: 0,
        guard: Some((post_m: 0.05, post_spacing_m: 1.2, baluster_m: 0.02, opening_m: 0.1, rail: (0.06, 0.05), shoe_m: 0.04)),
        note: "A guard where a floor edge drops: posts, upright balusters closer than the 100 mm sphere the building rules name (no rails a child can climb), and a top rail. Draw one with the wall tool as a Steel balustrade or Oak balustrade wall, as tall as the guard: at least 0.914 m (the IRC), 1.0 m in the homestead. Placed on its own it is a 1.2 m section that does not stop anyone yet. Sources: docs/reference/findings/2026-10-20-stairs-guards-and-headroom.md.",
    ),
    (
        id: "handrail", label: "Handrail", category: "Structure",
        kind: Handrail, shape: Handrail, size: (1.2, 0.93, 0.092), color: (0.52, 0.36, 0.21), steps: 0,
        handrail: Some((diameter_m: 0.042, clearance_m: 0.05, bracket_spacing_m: 1.2, min_risers: 4, both_sides_from_m: 1.0)),
        note: "A round wall rail, its top 0.93 m over the floor, 50 mm off the wall, its ends turned back to the wall. Every stair carries this rail on both sides at 0.93 m over the line of its tread edges (one side when it is under 1 m wide, none under four risers), inside both the IRC (864 to 965 mm) and England (900 to 1000 mm). Sources: docs/reference/findings/2026-10-20-stairs-guards-and-headroom.md.",
    ),
