[
    // mount (2026-09-27): OnTop rests the placed piece on top of the snap_to pieces
    // its footprint covers, at the tallest one's height (a roof on walls, a wall on a
    // foundation), or on the floor where there are none. Floor (the default) puts it on
    // the floor. Doors and windows stay Floor until they can be set INTO a wall.
    (id: "wood_foundation", name: "Wood Foundation", category: "foundation", materials: [("wood_plank_0", 8)], build_time: 5.0, size: (4.0, 0.2, 4.0), snap_to: [], health: 200.0, provides: Some("foundation")),
    (id: "stone_foundation", name: "Stone Foundation", category: "foundation", materials: [("stone_brick_0", 12)], build_time: 8.0, size: (4.0, 0.3, 4.0), snap_to: [], health: 400.0, provides: Some("foundation")),
    (id: "wood_wall", name: "Wood Wall", category: "wall", materials: [("wood_plank_0", 6)], build_time: 4.0, size: (4.0, 3.0, 0.2), snap_to: ["foundation"], mount: OnTop, health: 150.0, provides: Some("shelter")),
    (id: "stone_wall", name: "Stone Wall", category: "wall", materials: [("stone_brick_0", 10)], build_time: 6.0, size: (4.0, 3.0, 0.3), snap_to: ["foundation"], mount: OnTop, health: 350.0, provides: Some("shelter")),
    (id: "metal_wall", name: "Metal Wall", category: "wall", materials: [("iron_ingot_0", 8)], build_time: 10.0, size: (4.0, 3.0, 0.15), snap_to: ["foundation"], mount: OnTop, health: 500.0, provides: Some("shelter")),
    // A wall with a door in it (2026-09-28): the wall's six planks less the
    // one the 1 x 2.1 m opening saves, plus four for the leaf.
    (id: "wood_wall_door", name: "Wood Wall with Door", category: "wall", materials: [("wood_plank_0", 9)], build_time: 5.0, size: (4.0, 3.0, 0.2), snap_to: ["foundation"], mount: OnTop, health: 150.0, provides: Some("shelter"), doorway: Some((width: 1.0, height: 2.1))),
    // A wall with a window in it (2026-09-28): a 1 x 1 m pane of glass 0.9 m
    // up, framed with a plank more than the plain wall.
    (id: "wood_wall_window", name: "Wood Wall with Window", category: "wall", materials: [("wood_plank_0", 7), ("glass_pane_0", 1)], build_time: 5.0, size: (4.0, 3.0, 0.2), snap_to: ["foundation"], mount: OnTop, health: 140.0, provides: Some("shelter"), window: Some((width: 1.0, height: 1.0, sill: 0.9))),
    (id: "roof", name: "Wood Roof", category: "roof", materials: [("wood_plank_0", 10)], build_time: 6.0, size: (4.0, 0.2, 4.0), snap_to: ["wall"], mount: OnTop, health: 180.0, provides: Some("shelter")),
    (id: "crafting_table", name: "Crafting Table", category: "furniture", materials: [("wood_plank_0", 6)], build_time: 4.0, size: (1.0, 1.0, 1.0), snap_to: ["foundation"], mount: OnTop, health: 100.0, provides: Some("crafting_station"), stations: ["workbench"]),
    (id: "furnace", name: "Furnace", category: "machine", materials: [("stone_brick_0", 15), ("iron_ingot_0", 3)], build_time: 12.0, size: (1.0, 1.5, 1.0), snap_to: ["foundation"], mount: OnTop, health: 300.0, provides: Some("smelting"), stations: ["smelter", "kiln"]),
    // Stations you craft at the workbench, then set down here (2026-09-26): each
    // blueprint consumes the crafted station item. Before this the build_* recipes
    // made station items nothing could place, so their stations never existed and
    // about 160 recipes could not be made in the one-person home.
    (id: "forge_station", name: "Forge", category: "machine", materials: [("forge_0", 1)], build_time: 5.0, size: (1.2, 1.2, 1.0), snap_to: ["foundation"], mount: OnTop, health: 300.0, provides: Some("crafting_station"), stations: ["forge"]),
    (id: "anvil", name: "Anvil Station", category: "machine", materials: [("anvil_station_0", 1)], build_time: 5.0, size: (0.8, 0.9, 0.5), snap_to: ["foundation"], mount: OnTop, health: 400.0, provides: Some("crafting_station"), stations: ["anvil_station"]),
    (id: "electronics_bench", name: "Electronics Bench", category: "machine", materials: [("electronics_bench_0", 1)], build_time: 5.0, size: (1.4, 0.9, 0.7), snap_to: ["foundation"], mount: OnTop, health: 120.0, provides: Some("crafting_station"), stations: ["electronics_bench"], power_watts: 150.0, idle_watts: 5.0, power_priority: 3),
    (id: "sewing_machine", name: "Sewing Machine", category: "machine", materials: [("sewing_machine_0", 1)], build_time: 5.0, size: (0.9, 0.8, 0.5), snap_to: ["foundation"], mount: OnTop, health: 80.0, provides: Some("crafting_station"), stations: ["sewing_machine"], power_watts: 100.0, idle_watts: 0.0, power_priority: 3),
    (id: "loom", name: "Loom", category: "machine", materials: [("loom_0", 1)], build_time: 5.0, size: (1.5, 1.4, 1.0), snap_to: ["foundation"], mount: OnTop, health: 100.0, provides: Some("crafting_station"), stations: ["loom"]),
    (id: "stove", name: "Stove", category: "machine", materials: [("stove_0", 1)], build_time: 5.0, size: (0.8, 0.9, 0.7), snap_to: ["foundation"], mount: OnTop, health: 150.0, provides: Some("crafting_station"), stations: ["stove"], power_watts: 1200.0, idle_watts: 0.0, power_priority: 2),
    (id: "oven", name: "Oven", category: "machine", materials: [("oven_0", 1)], build_time: 5.0, size: (0.8, 0.9, 0.7), snap_to: ["foundation"], mount: OnTop, health: 150.0, provides: Some("crafting_station"), stations: ["oven"], power_watts: 2200.0, idle_watts: 2.0, power_priority: 2),
    (id: "chemistry_set", name: "Chemistry Set", category: "machine", materials: [("chemistry_set_0", 1)], build_time: 5.0, size: (1.2, 0.9, 0.6), snap_to: ["foundation"], mount: OnTop, health: 60.0, provides: Some("crafting_station"), stations: ["chemistry_set"]),
    (id: "composter", name: "Composter", category: "machine", materials: [("composter_0", 1)], build_time: 5.0, size: (1.0, 1.0, 1.0), snap_to: ["foundation"], mount: OnTop, health: 100.0, provides: Some("crafting_station"), stations: ["composter"]),
    (id: "sawmill", name: "Sawmill", category: "machine", materials: [("sawmill_0", 1)], build_time: 5.0, size: (2.0, 1.2, 1.0), snap_to: ["foundation"], mount: OnTop, health: 250.0, provides: Some("crafting_station"), stations: ["sawmill"]),
    (id: "grain_mill", name: "Grain Mill", category: "machine", materials: [("grain_mill_0", 1)], build_time: 5.0, size: (1.0, 1.2, 1.0), snap_to: ["foundation"], mount: OnTop, health: 200.0, provides: Some("crafting_station"), stations: ["grain_mill"]),
    (id: "fuel_refinery", name: "Fuel Refinery", category: "machine", materials: [("fuel_refinery_0", 1)], build_time: 5.0, size: (1.5, 2.0, 1.5), snap_to: ["foundation"], mount: OnTop, health: 300.0, provides: Some("crafting_station"), stations: ["fuel_refinery"]),
    (id: "water_purifier", name: "Water Purifier", category: "machine", materials: [("water_purifier_0", 1)], build_time: 5.0, size: (0.6, 1.0, 0.5), snap_to: ["foundation"], mount: OnTop, health: 100.0, provides: Some("crafting_station"), stations: ["water_purifier"]),
    // A SOLAR PANEL to set down (2026-09-27): the first buildable power source, so a
    // planet site can power its stove and a home can offset what it draws from the
    // ship's reactor. It consumes the Solar Panel crafted at the electronics bench
    // (recipe build_solar_panel) and makes the home catalog panel's 400 W peak with
    // the sun (data/machines/home.ron "solar_panel", whose PVWatts yield at the home's
    // site is quoted there). Ground-mounted; the 1.7 x 1.0 m footprint is a game
    // choice near a residential 400 W module's size.
    (id: "solar_panel", name: "Solar Panel", category: "machine", materials: [("solar_panel_0", 1)], build_time: 5.0, size: (1.7, 0.05, 1.0), snap_to: [], health: 80.0, provides: Some("power"), generates: Some(Solar(peak_watts: 400.0, average_watts: Some(45.3)))),
    (id: "storage_chest", name: "Storage Chest", category: "furniture", materials: [("wood_plank_0", 8)], build_time: 3.0, size: (1.0, 0.8, 0.6), snap_to: ["foundation"], mount: OnTop, health: 80.0, provides: Some("storage")),
    (id: "bed", name: "Bed", category: "furniture", materials: [("wood_plank_0", 6), ("fiber_bundle_0", 4)], build_time: 4.0, size: (1.0, 0.6, 2.0), snap_to: ["foundation"], mount: OnTop, health: 60.0, provides: Some("rest")),
    // A CAMPFIRE (BUG-153, 2026-10-05): a ring of stones with logs in it, as
    // data/structures.csv always listed it (stone:6|log:3, 1.0 x 0.6 x 1.0 m, 30 hp,
    // outdoor_only). The Campfire ability builds it in front of the player; the
    // Crafting page places it by hand. outdoors_only: never aboard the ship, under a
    // roof (built or still going up), or where there is no air to burn
    // (construction::outdoors_refusal), and no roof is ever built over it
    // (construction::roofs_over_outdoors_piece): it stays in the open all its life.
    // burns: it is a fire (src/systems/construction/fires.rs, whose doc has every source):
    // - seconds_per_fuel 2400: the US Forest Service's campground fire ring burned 11 kg
    //   of split firewood in 55 minutes of typical recreational use (Urbanski 2021, for
    //   the Minnesota Pollution Control Agency), so an 8 kg Wood Log lasts 40 minutes.
    // - radiant_watts 16000: that fire's 10.4 kg of dry wood an hour (at 15 percent
    //   moisture) x NIST's 17.5 MJ/kg effective heat of combustion is 51 kW, and NIST's
    //   average radiative fraction for wood and plant fuels, 0.32, is 16 kW of it
    //   radiated (NIST TN 2314, April 2025).
    // - holds 4: A GAME CHOICE, about what a ring a metre across takes stacked.
    // The build's own three logs are its first load. Taken down, it gives back its
    // stones and only the logs it has not burned.
    (id: "campfire", name: "Campfire", category: "fire", materials: [("stone_raw_0", 6), ("wood_log_0", 3)], build_time: 5.0, size: (1.0, 0.6, 1.0), snap_to: [], health: 30.0, provides: Some("heat"), outdoors_only: true, burns: Some((fuel: "wood_log_0", seconds_per_fuel: 2400.0, holds: 4, radiant_watts: 16000.0))),
]
