// Planet-surface tree species (v0.1066).
//
// Replaces the hardcoded `species_fir = ((r5 >> 9) & 1) == 0` bool in
// src/terrain/planet_chunks.rs, which allowed exactly two species (fir 22 m,
// pine 16 m) everywhere on Earth. Adding a species is now a row here.
//
// TWO KINDS OF SPECIES:
//   model: "fir_sapling"  -> loads assets/models/plants/<model>/<model>_v<N>.gltf
//                            (photoscan path; dev checkout only, the release
//                            bundle does not ship assets/models/)
//   model: ""             -> PROCEDURAL, built by renderer::tree_mesh from the
//                            `form` numbers below. Costs no art and DOES ship.
//
// GATES, all evaluated at the spawn cell so a species only grows where it
// belongs. Latitude is degrees (+N), elevation is metres above sea level.
// A `region_radius_km` of 0 means "no region restriction, use the lat/elev
// gates alone". A non-zero radius makes the species LOCAL to that point, which
// is how sakura ends up around Fuji instead of smeared over the whole planet.
//
// `weight` is the relative pick chance among all species whose gates pass.
// Colours are linear RGB 0..1 and feed the packed-per-face colour that
// material type 20 decodes.
//
// ── LEAF SILHOUETTE (v0.1100) ────────────────────────────────────────────
// The `leaf_*` fields on a species row describe the OUTLINE OF ONE LEAF, in
// the botanical terms a field guide uses. They are read at BAKE TIME by
// `renderer::billboard_bake::leaf_shape`, which is what stamps a species'
// real silhouette into its cluster sprite; the runtime blade layer keeps its
// cheap deltoid proxy, because a 12-triangle maple leaf is exactly the kind
// of detail you bake once into a texture and never draw per frame.
//
//   leaf_shape        outline family. One of:
//                       "deltoid"      the plain isoceles blade (the default,
//                                      and what every species drew before)
//                       "ovate"        one simple blade, widest below middle
//                       "serrate-ovate" ditto with a doubly-toothed margin
//                       "pinnate-lobed" one blade cut into lobe PAIRS either
//                                      side of the midrib (oak)
//                       "palmate"      several lobes radiating from the
//                                      petiole (maple)
//                       "bipinnate"    a frond: pinna pairs along a rachis,
//                                      each carrying leaflet pairs (acacia)
//                       "needle-flat-rank"  a CONIFER SHOOT with its needles
//                                      set in two ranks either side of one
//                                      twig, all in one plane, so the spray
//                                      reads flat and comb-like (fir, Abies)
//                       "needle-fascicle"   a CONIFER SHOOT carrying FASCICLES
//                                      of 2-5 needles spiralled all round the
//                                      twig, so it reads tufted and radial
//                                      rather than flat (pine, Pinus)
//   leaf_aspect       leaf WIDTH divided by petiole-to-tip LENGTH. This is a
//                     measurable fact about the plant and it overrides the
//                     generic 0.70 width the mesh builder hands every
//                     broadleaf. 0 (the default) keeps the incoming width.
//                     For the two NEEDLE families this is not a free choice:
//                     the spray's width is DERIVED from its needle length and
//                     the angle the needles leave the shoot at, so the stated
//                     aspect must equal `2 * needle_len_frac * sin(angle)` (to
//                     within a few percent, once the tip taper and the shoot
//                     overhang are counted). State the wrong number and every
//                     needle on the shoot is silently stretched or squashed;
//                     `conifer_sprays_are_drawn_undistorted` gates it.
//   leaf_widest_frac  where along the midrib the blade is widest, 0 at the
//                     petiole and 1 at the tip. Below 0.5 = ovate, above =
//                     obovate. This is the single number that separates a
//                     birch (0.28) from an oak (0.60) at silhouette level.
//   leaf_tip_frac     how drawn out the tip is. 0 = blunt/rounded, 1 = a long
//                     acuminate drip tip.
//   leaf_lobes        palmate: lobe COUNT (odd, the middle lobe is on the
//                     midrib). pinnate-lobed: lobe PAIRS. bipinnate: pinna
//                     PAIRS along the rachis. needle-flat-rank: needle PAIRS
//                     along the shoot. needle-fascicle: FASCICLES along it.
//   leaf_sinus_frac   how deep the cuts between lobes go, as a fraction of
//                     the way to the midrib (or, palmate, to the petiole).
//   leaf_teeth        marginal teeth per side. 0 = an entire (smooth) margin.
//   leaf_leaflets     bipinnate: leaflet PAIRS on one pinna. needle-fascicle:
//                     needles bundled in ONE fascicle (2 on a Scots pine, 3 on
//                     a ponderosa, 5 on a white pine).
//
// ── NEEDLE SPRAYS (v0.1101) ──────────────────────────────────────────────
// A conifer is NOT a broadleaf with smaller leaves. The unit a conifer canopy
// is built from is a NEEDLE SPRAY - a whole twig carrying a hundred or more
// needles - and the engine's conifer form has always drawn its foliage at that
// scale (`Foliage::leaf` is 0.30-0.50 m of "narrow strap" against a
// broadleaf's 0.09-0.22 m blade). What it lacked was the needles: each spray
// was ONE triangle, which is why the operator's forest capture shows the two
// big conifers wearing scattered dark darts on bare branches.
//
// These four fields describe the needles on that shoot. They are read only by
// the two "needle-*" families and ignored by every other row.
//
//   leaf_needle_len_frac    ONE needle's length as a fraction of the whole
//                           shoot's length. This single ratio is most of what
//                           separates the two conifers on sight: a fir needle
//                           is a fiftieth of its shoot, a pine needle a fifth.
//   leaf_needle_width_frac  a needle's WIDTH as a fraction of its own length.
//                           Fir needles are flat straps; pine needles are round
//                           in section and far finer.
//   leaf_needle_angle_deg   the angle a needle (flat-rank) or a whole fascicle
//                           (fascicle) leaves the shoot at, DEGREES OFF THE
//                           SHOOT AXIS. 90 is square to the shoot; smaller
//                           rakes forward toward its tip.
//   leaf_fascicle_spread_deg  needle-fascicle only: the total angular splay of
//                           the needles inside one bundle - the shaving-brush
//                           spread that separates a fascicle from one thick
//                           needle.
//
// Anything omitted defaults, and a species with no `leaf_shape` at all bakes
// exactly the deltoid it always did - this is additive, never a migration.
(
    trees: [
        // ── Conifers: the two shipped photoscans, now just rows ──────────
        (
            id: "fir",
            display: "Fir",
            // EMPTY = procedural, and this is a DELETION of dead code rather
            // than a change of technique. The `fir_sapling` scans are rejected
            // at EVERY variant by the v0.1101 scan-stretch guard (measured
            // 13.7-35.5x: they are scans of ~1 m saplings standing in for a
            // 22 m tree), so the glTF path has not drawn a single frame since.
            //
            // Naming a model we never load was not merely useless, it was
            // ACTIVELY HARMFUL: `is_procedural()` is `model.is_empty()`, and
            // the ONE site that registers near-field cluster-card meshes and
            // calls `bark_material` filters on it (src/lib.rs:9473). So fir and
            // pine were locked out of baked bark AND of the canopy-card layer
            // permanently - which is why the tallest species in a Fuji frame
            // renders as a see-through skeleton with an untextured grey trunk,
            // measured at 37.9% and 48.4% sky-through against a 30% bar and a
            // carded broadleaf's 10.3%.
            model: "",
            variants: 3,
            height_m: 22.0,
            height_jitter: 0.12,
            weight: 1.0,
            lat_min_deg: -70.0, lat_max_deg: 70.0,
            elev_min_m: 6.0, elev_max_m: 3000.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "conifer",
            trunk_color: (0.075, 0.055, 0.038),
            leaf_color: (0.10, 0.26, 0.12),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Abies, the silver/grand fir group. PECTINATE: the needles are
            // spirally inserted and then twisted into ONE PLANE, two ranks
            // either side of the shoot, so a spray is flat and comb-like and
            // you can lay it on a table. Needles 2-3 cm, flat in section, ~2 mm
            // wide, parallel-sided with a BLUNT (usually notched) tip - that
            // bluntness is the field mark that separates a fir from a spruce
            // in the hand, and it is why this family tapers its needle to 0.80
            // of its base width rather than to a point.
            //
            // The shoot this is stamped into is the 0.48 m element the conifer
            // form already grows (`Foliage::leaf` = h * 0.022, clamped
            // 0.30-0.50), so a 25 mm needle is 0.052 of it.
            leaf_shape: "needle-flat-rank",
            // DERIVED, not chosen: 2 * 0.052 * sin(80 deg), less what the tip
            // needles overhang the shoot's end by. MEASURED off the built
            // outline by `leaf_shape::natural_aspect` (0.1026) rather than
            // taken from the closed form. See the leaf_aspect note in the
            // header - stating this wrong squashes every needle on the shoot.
            leaf_aspect: 0.1026,
            leaf_needle_len_frac: 0.052,
            leaf_needle_width_frac: 0.088,
            // 80 rather than a square 90: Abies needles stand almost
            // perpendicular but rake perceptibly toward the shoot's tip, which
            // is what stops the spray reading as a ladder.
            leaf_needle_angle_deg: 80.0,
            // 48 needle PAIRS, and this is SPARSER THAN LIFE on purpose. A real
            // Abies rank sets its needles 3-5 mm apart, which on a 0.48 m shoot
            // is ~110 pairs and ~450 triangles per spray - more than any leaf in
            // this registry and three times the pine's. 48 pairs is 9.5 mm
            // within a rank, and because the two ranks are offset by half a
            // station the shoot carries a needle every 4.7 mm counting both
            // sides, which IS the real spacing at silhouette level. The
            // shortfall is in one rank's own rhythm, not in the density of the
            // spray, and it is invisible at every range the sprite is sampled
            // at (a 512 px sprite on a metre-class card is ~2 mm per texel, so
            // a 3 mm rank spacing could not be resolved anyway).
            leaf_lobes: 48,
        ),
        (
            id: "pine",
            display: "Pine",
            // Empty = procedural. Same reasoning as fir above: the
            // `pine_sapling_small` scans are rejected at every variant, and
            // naming them locked this species out of baked bark and of the
            // canopy-card layer.
            model: "",
            variants: 3,
            height_m: 16.0,
            height_jitter: 0.12,
            weight: 1.0,
            lat_min_deg: -70.0, lat_max_deg: 70.0,
            elev_min_m: 6.0, elev_max_m: 3200.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "conifer",
            trunk_color: (0.085, 0.062, 0.042),
            leaf_color: (0.12, 0.28, 0.13),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // Scots pine carries a more slender bole than fir.
            slenderness: 48.0,
            // Pinus, the two-needle group (sylvestris / densiflora / nigra),
            // which is what a 16 m unspecified "Pine" on a global lat band is.
            // NOTHING about this is the fir with different numbers:
            //   - the needles come in FASCICLES, sheathed in pairs at the base;
            //   - the fascicles are borne in a SPIRAL all round the shoot, not
            //     in two ranks in one plane, so the shoot reads as a radial
            //     bottle-brush and each bundle is seen at its own azimuth;
            //   - a pine needle is 6 cm where a fir needle is 2.5, round in
            //     section rather than flat, and drawn to a fine point rather
            //     than blunt.
            // The generator hands this species a 0.352 m shoot (h * 0.022), so
            // a 60 mm needle is 0.170 of it - more than three times the fir's
            // ratio, which is the whole difference at silhouette level.
            leaf_shape: "needle-fascicle",
            // DERIVED from the needle length, the 45 deg fascicle angle and the
            // splay, exactly as the fir's is, and MEASURED off the built
            // outline by `leaf_shape::natural_aspect` (0.2588). Two and a half
            // times the fir's 0.1026 because a pine shoot really is a fat brush
            // where a fir spray really is a thin comb.
            leaf_aspect: 0.2588,
            leaf_needle_len_frac: 0.170,
            // 2.0 mm on a 60 mm needle. Pinus sylvestris and nigra run
            // 1.5-2 mm, so this is the resolvable end of the real range rather
            // than a fattened one - a needle is still around one texel wide in
            // the finished sprite, and the 4x supersample the cluster bake runs
            // at is what keeps it from aliasing away entirely.
            leaf_needle_width_frac: 0.033,
            // 45: pine fascicles ASCEND steeply, unlike the fir's near-square
            // needles. That single angle is why a pine shoot reads as a brush
            // swept toward its tip and a fir spray reads as a flat comb.
            leaf_needle_angle_deg: 45.0,
            // 48 fascicles over the needled part of a 0.352 m shoot is 6.9 mm
            // apart, squarely inside the 4-8 mm a real Scots pine sets them at
            // on the current season's growth. Unlike the fir's rank spacing
            // this needed no compromise: a fascicle is 2 needles and a shoot
            // this long carries far fewer of them than a fir shoot carries
            // single needles, so the honest count and the affordable count are
            // the same number.
            leaf_lobes: 48,
            // Two. Every pine on earth carries 2, 3 or 5.
            leaf_leaflets: 2,
            // 22 deg of splay: a two-needle fascicle is a split cylinder whose
            // halves bow apart along their length, reaching about this much
            // between the tips.
            leaf_fascicle_spread_deg: 22.0,
        ),

        // ── Procedural broadleaves: no art, generated by tree_mesh ────────
        // Sakura. Region-locked to the Fuji / Kanto area so a cherry grove is
        // somewhere you TRAVEL to, not wallpaper. Radius is deliberately
        // generous (280 km reaches Tokyo and the Izu peninsula) because the
        // spawn grid is coarse and a tight radius yields empty forests.
        (
            id: "sakura",
            display: "Cherry blossom",
            model: "",
            variants: 3,
            height_m: 8.0,
            height_jitter: 0.18,
            weight: 3.0,
            lat_min_deg: 24.0, lat_max_deg: 46.0,
            elev_min_m: 6.0, elev_max_m: 1400.0,
            region_lat_deg: 35.36, region_lon_deg: 138.73, region_radius_km: 280.0,
            form: "broadleaf",
            trunk_color: (0.062, 0.047, 0.046),
            leaf_color: (0.22, 0.40, 0.18),
            blossom_color: (0.97, 0.72, 0.80),
            blossom_frac: 0.82,
            // Height/diameter ratio, overriding the growth form default.
            // Yoshino cherry is stout for its height - short and wide-crowned.
            slenderness: 32.0,
            // Prunus x yedoensis: ovate-lanceolate, 8-12 cm long by 4-5 cm
            // wide (aspect ~0.45, NOT the 0.70 the generic broadleaf width
            // gave it), widest just below the middle, sharply serrate margin,
            // acuminate tip. A cherry's leaf is a plain simple blade - the
            // interesting silhouette on this species is its blossom, which
            // has had real notched petals since v0.1088.
            leaf_shape: "serrate-ovate",
            leaf_aspect: 0.45,
            leaf_widest_frac: 0.42,
            leaf_tip_frac: 0.45,
            leaf_teeth: 11,
            // ── Cluster cards (v0.1088) ──────────────────────────────
            // The measured problem: the geometric blade layer reaches leaf
            // area index 0.31-0.50 on this species, so the crown transmits
            // 78-86% of the sky where a real cherry at LAI 3 transmits 22%
            // (Beer-Lambert, K = 0.5). Reaching LAI 3 with blades would cost
            // ~60,000 triangles; with cluster cards it costs ~2,400 and the
            // tree comes out CHEAPER than it was.
            //
            // Sakura is the ONLY species carrying this block today - the arc
            // ships one species at a time so each set of numbers is measured
            // rather than guessed. Omitting the block leaves a species on the
            // pure blade layer, exactly as before.
            clusters: Some((
                // 2.6 rather than a textbook 3-5: this is a FLOWERING cherry,
                // and a blossom sleeve is optically thinner than a leaf tuft.
                target_lai: 2.6,
                leaf: (
                    size_m: 0.50,
                    // MEASURED at the bake (2026-08-01, [Cluster] log), not
                    // assumed: 84 sprigs of real 9 cm blades cover 0.36 of
                    // their card. Coverage saturates hard with density (24
                    // sprigs measured 0.20, 3.5x as many only reached 0.36),
                    // so chasing a rounder number would mean an unphysically
                    // dense tuft. The planner spends the truth instead.
                    // 0.36 -> 0.38 (v0.1100): the same 84 sprigs now carry
                    // ovate serrate blades instead of triangles, and the CPU
                    // bake twin measures 0.378. Barely moved, which is the
                    // expected result - a cherry leaf is a simple blade, so
                    // giving it its real outline changes its MARGIN, not its
                    // mass. The species this arc was really for are the maple,
                    // the oak and the birch.
                    coverage: 0.38,
                    cards_per_sleeve: 4,
                    sleeve_spacing_m: 0.22,
                    // MEASURED, not guessed: at 24 sprigs the bake reported
                    // 0.20 coverage against the 0.55 this planner spends, and
                    // [Cluster] logs that mismatch every world entry. Coverage
                    // saturates like 1 - exp(-density), so 0.20 -> 0.55 is
                    // ~3.5x the sprigs. Denser is also CHEAPER: for a fixed
                    // leaf area index, overdraw is LAI / coverage.
                    sprite_elements: 84,
                    sprite_runs: 1,
                ),
                blossom: (
                    // Bigger than one umbel on purpose: the sprite carries
                    // SEVERAL umbels at their real along-twig spacing, which
                    // is what reproduces the reference photo (a branch
                    // wrapped in white-pink) at a third of the card count.
                    // 0.45 -> 0.62 (v0.1088.2 tuning): at range the pink read
                    // as flecks among green; a full-bloom yoshino is pink
                    // MASSES first, leaves second (operator reference photos).
                    size_m: 0.62,
                    coverage: 0.45,
                    cards_per_sleeve: 4,
                    sleeve_spacing_m: 0.20,
                    // Umbels ALONG one twiglet. Not raised to chase coverage:
                    // this count times `umbel_spacing_m` has to keep spanning
                    // the card, or the sprite is taller than the card that
                    // samples it and the flowers bake at the wrong scale.
                    sprite_elements: 9,
                    // Twiglets side by side - THIS is the coverage knob. A
                    // half-metre patch of blooming crown really does hold
                    // several last-generation twigs, and 4 of them measured
                    // 0.26 coverage against the 0.45 this planner spends.
                    // 9 -> 14 (v0.1088.2): denser twiglet pack = higher real
                    // coverage = more pink per card at the same overdraw.
                    sprite_runs: 14,
                ),
                // Prunus x yedoensis: 3.5 cm flowers, 3-6 per umbel, umbels a
                // few centimetres apart on two-year-and-older wood.
                flower_size_m: 0.035,
                flowers_per_umbel: 5,
                umbel_spacing_m: 0.045,
                // A cherry flowers BEFORE it leafs out, so at 0.82 blossom
                // this species counts as in bloom and the leaf layer drops to
                // a sparse scatter of young leaves.
                leaf_off_above_blossom_frac: 0.50,
                bloom_leaf_area_share: 0.09,
                near_blade_tri_frac: 0.45,
            )),
        ),
        // Japanese maple, the same region, as the non-pink half of the grove
        // so Fuji does not read as a single-species pink monoculture.
        (
            id: "momiji",
            display: "Japanese maple",
            model: "",
            variants: 3,
            height_m: 7.0,
            height_jitter: 0.16,
            weight: 1.2,
            lat_min_deg: 24.0, lat_max_deg: 46.0,
            elev_min_m: 6.0, elev_max_m: 1600.0,
            region_lat_deg: 35.36, region_lon_deg: 138.73, region_radius_km: 320.0,
            form: "broadleaf",
            trunk_color: (0.070, 0.052, 0.040),
            leaf_color: (0.30, 0.34, 0.12),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // Acer palmatum is fine-stemmed.
            slenderness: 38.0,
            // Acer palmatum. THE most recognisable leaf outline of any tree in
            // this registry, and the reason "palmate" exists as a shape: 5-7
            // lobes radiating from the petiole, each lanceolate and drawn to a
            // long point, the cuts between them running half to two thirds of
            // the way back to the petiole. The blade is roughly as wide as it
            // is long (a little wider on a mature leaf, hence 1.12) and every
            // lobe margin is finely toothed.
            leaf_shape: "palmate",
            leaf_aspect: 1.12,
            leaf_lobes: 7,
            leaf_sinus_frac: 0.62,
            leaf_widest_frac: 0.34,
            leaf_tip_frac: 0.62,
            leaf_teeth: 7,
            // ── Cluster cards ────────────────────────────────────────
            // Momiji is the SECOND species to carry cards (sakura was first,
            // v0.1088). Nothing here is copied from the cherry: a maple is a
            // denser, finer-textured, smaller tree, and every number moves.
            clusters: Some((
                // 3.6, against sakura's 2.6. The cherry number is low BECAUSE
                // it is a flowering sleeve; a leafed-out maple is the ordinary
                // broadleaf case, and Acer stands measure LAI 3.5-5. 3.6 sits
                // at the low end of that because our crown envelope is a
                // single dome rather than the layered tiers a real momiji
                // grows, and a dome over-counts its own projected area.
                target_lai: 3.6,
                leaf: (
                    // 0.40 m, against sakura's 0.50. A momiji is 7 m to the
                    // cherry's 8, and its foliage is carried in FLAT LAYERED
                    // SPRAYS rather than round tufts, so the patch of crown one
                    // card stands in for is smaller in every direction.
                    size_m: 0.40,
                    // MEASURED by the CPU twin of the cluster bake
                    // (`billboard_bake::dump_cluster_sprites_cpu`, 2048 px
                    // supersample down to 512), not guessed: 0.49. Higher than
                    // the cherry's 0.38 at FEWER sprite elements (60 against
                    // 84), because a palmate maple leaf is nearly as wide as
                    // it is long and so sweeps far more card per leaf than a
                    // narrow cherry blade does.
                    coverage: 0.49,
                    cards_per_sleeve: 4,
                    // Scaled off the card, as sakura's is: a sleeve step of
                    // ~0.45 card sides keeps the sleeves overlapping along a
                    // twig instead of beading.
                    sleeve_spacing_m: 0.18,
                    sprite_elements: 60,
                    sprite_runs: 1,
                ),
                // Momiji never blooms in this registry (`blossom_frac: 0.0`),
                // so no blossom CARD is ever emitted - but the sprite geometry
                // is still built and size-checked, so these describe the real
                // flower rather than being filler: Acer palmatum carries small
                // reddish-purple flowers, ~6 mm, in corymbs of 10-15 hanging
                // under the new shoots.
                blossom: (
                    size_m: 0.14,
                    coverage: 0.18,
                    cards_per_sleeve: 3,
                    sleeve_spacing_m: 0.10,
                    sprite_elements: 5,
                    sprite_runs: 6,
                ),
                flower_size_m: 0.006,
                flowers_per_umbel: 12,
                umbel_spacing_m: 0.022,
                leaf_off_above_blossom_frac: 0.50,
                bloom_leaf_area_share: 0.09,
                near_blade_tri_frac: 0.45,
            )),
        ),
        // Temperate broadleaves, global in the mid latitudes. These are what
        // break up the endless conifer wall in the operator's forest shots.
        (
            id: "oak",
            display: "Oak",
            model: "",
            variants: 3,
            height_m: 18.0,
            height_jitter: 0.15,
            weight: 2.0,
            lat_min_deg: -55.0, lat_max_deg: 58.0,
            elev_min_m: 6.0, elev_max_m: 1500.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "broadleaf",
            trunk_color: (0.080, 0.058, 0.038),
            leaf_color: (0.16, 0.34, 0.13),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // The canonical stout, open-grown, spreading oak.
            slenderness: 32.0,
            // Quercus robur. Pinnately lobed: one blade cut into 4-6 pairs of
            // ROUNDED lobes with deep sinuses, widest well ABOVE the middle
            // (obovate - this is the cue that reads as "oak" even in
            // silhouette), a blunt tip, an entire margin between the lobes,
            // and a very short petiole. 7-14 cm long by 4-8 cm wide, so an
            // aspect near 0.58 rather than the generic 0.70.
            leaf_shape: "pinnate-lobed",
            leaf_aspect: 0.58,
            leaf_lobes: 5,
            // Cut half way to the midrib. A real English oak runs anywhere
            // from a third to two thirds; half is the honest middle and it is
            // what makes the lobes read as lobes rather than as a wavy edge.
            leaf_sinus_frac: 0.50,
            leaf_widest_frac: 0.60,
            leaf_tip_frac: 0.10,
            // Entire between the lobes: an oak has no teeth, and adding any
            // would blur the one margin feature that distinguishes it.
            leaf_teeth: 0,
            // ── Cluster cards ────────────────────────────────────────
            clusters: Some((
                // The densest crown in the registry, and correctly so: a
                // mature open-grown oak measures LAI 4-6 and is the canonical
                // "you cannot see sky through it" tree. 3.8 transmits
                // exp(-0.5 * 3.8) = 15% of the sky by Beer-Lambert, against
                // the cherry's 27%.
                //
                // Held at 3.8 rather than the 4.2 first tried, for a reason
                // that is arithmetic and not taste: the card layer may spend
                // 3400 triangles = 850 cards, and an 18 m oak's crown projects
                // 232 m2, so the fit has to buy `lai * 232` m2 of leaf out of
                // 850 cards no matter what. At 4.2 that solved to a 1.78 m
                // card - a tarpaulin - and pushed the whole tree to 8925
                // triangles, 325 over the 8600 ceiling.
                target_lai: 3.8,
                leaf: (
                    // 1.4 m, and this is the honest number rather than a
                    // modest-looking one. An 18 m oak is the biggest broadleaf
                    // here, its twigs are metres apart, and the LAI fit solves
                    // the card SIDE - so understating this does not produce
                    // smaller cards, it only bakes the sprite at a size the
                    // cards are not drawn at, which is the one thing
                    // `mean_card_side` exists to prevent. The fit settles
                    // around 1.4-1.9 m across the three variants, ~20% of the
                    // crown spread, the same ratio sakura's 0.85 m card is to
                    // its 5 m crown.
                    size_m: 1.40,
                    // MEASURED by the CPU twin of the cluster bake, after two
                    // rounds: 44 elements measured 0.267, 115 measured 0.413,
                    // 175 lands here. Coverage saturates like
                    // 1 - exp(-density) AND the card side shrinks as coverage
                    // rises (the LAI fit solves side for area), so the two
                    // fight each other and the number has to be converged on
                    // rather than solved.
                    //
                    // Worth converging on, because coverage is the divisor in
                    // the crown's OVERDRAW (alpha-test layers per canopy pixel
                    // = LAI / coverage) and this is the tallest, heaviest and
                    // most common broadleaf in the registry. At the first
                    // pass's 0.267 the oak paid 14 layers; here it pays 7.8.
                    coverage: 0.49,
                    cards_per_sleeve: 4,
                    // ~0.24 card sides, tighter than the others relative to
                    // the card: an oak's foliage is carried in dense masses
                    // right along the shoot, not in tufts at the tips.
                    sleeve_spacing_m: 0.34,
                    // 175, and the biggest element count in the registry by
                    // far (the cherry spends 84, the maple 60). An oak card
                    // settles at 1.4-1.9 m and has to be FILLED at that size,
                    // and a 20 cm leaf covers very little of a 2 m square, so
                    // the count has to go where the arithmetic says rather
                    // than where the other species sit. Denser is also
                    // CHEAPER: a canopy pixel pays LAI / coverage alpha-test
                    // layers, so buying coverage buys frame time back.
                    sprite_elements: 175,
                    sprite_runs: 1,
                ),
                // Inert (`blossom_frac: 0.0`), but real: an oak flowers as
                // pendulous yellow-green catkins 2-4 cm long, a dense string
                // of 2-3 mm florets rather than a bouquet.
                blossom: (
                    size_m: 0.13,
                    coverage: 0.16,
                    cards_per_sleeve: 3,
                    sleeve_spacing_m: 0.09,
                    sprite_elements: 9,
                    sprite_runs: 5,
                ),
                flower_size_m: 0.003,
                flowers_per_umbel: 10,
                umbel_spacing_m: 0.006,
                leaf_off_above_blossom_frac: 0.50,
                bloom_leaf_area_share: 0.09,
                // 0.20, against 0.45 everywhere else, and this is where the
                // oak's triangle overrun was actually paid for. An 18 m tree
                // spends most of MAX_TRIS on WOOD; the near-field blade layer
                // is a sub-metre parallax detail that a card already covers,
                // so it is the cheapest 700 triangles in the budget to give
                // back. Nothing about the crown's silhouette changes - the
                // blades were never the silhouette on a clustered species.
                near_blade_tri_frac: 0.20,
            )),
        ),
        (
            id: "birch",
            display: "Birch",
            model: "",
            variants: 3,
            height_m: 14.0,
            height_jitter: 0.16,
            weight: 1.4,
            lat_min_deg: 40.0, lat_max_deg: 70.0,
            elev_min_m: 6.0, elev_max_m: 1800.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "broadleaf",
            // Birch bark is the one trunk anybody can name on sight.
            trunk_color: (0.52, 0.50, 0.46),
            leaf_color: (0.26, 0.45, 0.16),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // Betula pendula is the slenderest bole in the registry (real
            // 0.20-0.28 m DBH at 14 m). The broadleaf default of 35 gives 0.40 m
            // - an oak wearing birch bark.
            slenderness: 58.0,
            // Betula pendula. Ovate-TRIANGULAR: broad and almost straight
            // across near the base, then two nearly straight sides converging
            // to a long drawn-out point, with a doubly serrate margin (big
            // teeth carrying smaller teeth). 3-7 cm long by 3-5 cm wide, so it
            // is a wide little leaf - aspect 0.85, widest a quarter of the way
            // up, which is what gives it the triangle read.
            leaf_shape: "serrate-ovate",
            leaf_aspect: 0.85,
            // 0.22, very low, and low is the point: the widest part of a birch
            // leaf is right down at its nearly-straight base, which is what
            // makes the outline a TRIANGLE rather than the spade every other
            // simple blade here is. The first dump used 0.26 with a longer
            // tip and came out visibly teardrop-shaped.
            leaf_widest_frac: 0.22,
            // Still the longest tip in the registry (a birch's acuminate point
            // is the species' margin signature at any range you can resolve a
            // leaf at), but 0.55 rather than 0.72: the tip exponent also
            // controls how much the SIDES bow out on the way to it, and at
            // 0.72 they bowed enough to round the triangle off.
            leaf_tip_frac: 0.55,
            leaf_teeth: 13,
            // ── Cluster cards ────────────────────────────────────────
            clusters: Some((
                // 2.8 - deliberately the THINNEST leafy crown here, and lower
                // than the flowering cherry's 2.6 is high. Birch stands
                // measure LAI 2-4 and an airy crown you can see sky and moving
                // branch through is the whole character of the species; a
                // birch built at oak density would just be a pale oak.
                target_lai: 2.8,
                leaf: (
                    // 0.52 m. Between the maple and the oak, as the tree is
                    // (14 m), but pulled DOWN relative to its height because a
                    // birch carries its foliage on long, fine, pendulous
                    // shoots - the tufts are small and there are many.
                    size_m: 0.52,
                    // MEASURED by the CPU bake twin: 0.56, the highest in the
                    // registry, and it looks like a contradiction of the airy
                    // crown above until you separate the two numbers.
                    // COVERAGE is how solid one card is; LAI is how many
                    // card-loads of leaf the whole crown carries. A birch is
                    // dense in the small and sparse in the large - little
                    // solid rosettes of leaf hung on long bare pendulous
                    // shoots. High coverage at low LAI is exactly that, and it
                    // is also the cheapest combination there is: overdraw is
                    // LAI / coverage, so birch pays 4.8 alpha-test layers
                    // against the oak's 7.8.
                    coverage: 0.58,
                    cards_per_sleeve: 4,
                    sleeve_spacing_m: 0.24,
                    sprite_elements: 66,
                    sprite_runs: 1,
                ),
                // Inert (`blossom_frac: 0.0`), but real: birch catkins, 2-4 cm
                // pendulous strings of ~2 mm florets.
                blossom: (
                    size_m: 0.12,
                    coverage: 0.15,
                    cards_per_sleeve: 3,
                    sleeve_spacing_m: 0.09,
                    sprite_elements: 9,
                    sprite_runs: 5,
                ),
                flower_size_m: 0.0025,
                flowers_per_umbel: 12,
                umbel_spacing_m: 0.005,
                leaf_off_above_blossom_frac: 0.50,
                bloom_leaf_area_share: 0.09,
                near_blade_tri_frac: 0.45,
            )),
        ),
        // Dry-tropics umbrella form, so savanna edges stop growing firs.
        (
            id: "acacia",
            display: "Acacia",
            model: "",
            variants: 3,
            height_m: 9.0,
            height_jitter: 0.18,
            weight: 1.6,
            lat_min_deg: -30.0, lat_max_deg: 30.0,
            elev_min_m: 6.0, elev_max_m: 2000.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "umbrella",
            trunk_color: (0.10, 0.078, 0.050),
            leaf_color: (0.20, 0.32, 0.12),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // Vachellia tortilis: a short stout bole under a flat crown.
            slenderness: 26.0,
            // Vachellia (Acacia) tortilis. NOT one blade at all: the whole
            // leaf is a BIPINNATE FROND - a central rachis carrying pinna
            // pairs, and every pinna carrying its own row of leaflet pairs a
            // few millimetres long. What reads at any distance is feathery
            // texture, and what reads close up is that the "leaf" is made of
            // dozens of separate specks with sky between them. That is why
            // this species looked worst of all as a solid triangle.
            leaf_shape: "bipinnate",
            leaf_aspect: 0.72,
            // 4 pinna pairs of 5 leaflet pairs = 40 leaflets on one frond.
            // A real tortilis carries 4-10 pinna pairs of 10-20 leaflet pairs,
            // so this is below the low end on both counts, and deliberately.
            // At 5x7 the sprite bake measured 1.75 MILLION triangles against
            // sakura's 76,884 - and at the sprite's ~1.2 mm per texel a
            // 20-leaflet frond is indistinguishable from a 40-leaflet one, so
            // the extra 100 leaflets were paying for detail no pixel resolves.
            // Feathery-with-sky-between is a silhouette property, not a count.
            leaf_lobes: 4,
            leaf_leaflets: 5,
            // NO `clusters` BLOCK YET - but the reason CHANGED in v0.1103 and
            // the new one is worth more than the old one.
            //
            // The two FORM blockers are closed: `umbrella` now records a Twig
            // per foliage-bearing fan, and a carded umbrella draws 4 elements
            // per sprig instead of 14 so its sprite fits its card. Measured
            // with a block lent: 15 twigs, crown spread 5.51 m, card at
            // 1.11 m, sprite 1.16x, 0% of blades outside the card mass. All
            // good.
            //
            // What stops it now is TAPER, and it is a real defect rather than
            // a gate being fussy: `cluster_cards_envelop_every_twig_tip` fails
            // with "terminal twigs end at 11.3 mm radius (23 mm across) - a
            // real last-year shoot is ~5 mm across". Our twigs are ~4.5x too
            // fat. The same measurement on fir finds whorl-branch tips at
            // 55 mm against a 10 mm rule, and a 22 m fir built with a 0.484 m
            // trunk RADIUS where a real one is 0.25-0.30 m.
            //
            // That is the "branches look like plumbing" report, and it is
            // upstream of everything here: a card is sized to sleeve a twig,
            // so a twig 4.5x too fat demands a card too big for its own
            // foliage. Fixing the radius/taper model is its own increment.
            //
            // THAT INCREMENT LANDED (v0.1103, real allometry): acacia terminal
            // twigs now measure 4.0 mm radius / 8 mm across, against the
            // gate's 10 mm ceiling and the ~5 mm of a real last-year shoot.
            // So the block below is live, exactly the values measured during
            // the deferral.
            clusters: Some((
                // 2.0, the sparsest crown in the registry, and it should be.
                // A savanna acacia is an open parasol - the whole silhouette
                // is sky seen through a thin horizontal plate of feathery
                // leaf. Tortilis stands measure LAI 1-3 against a temperate
                // broadleaf's 3-5. This also drops the card to ~0.90 m, which
                // is what keeps the flat-topped crown from reading as a solid
                // green disc.
                target_lai: 2.0,
                leaf: (
                    // Nominal - the LAI fit solves the real card side. A
                    // tortilis frond is 3-8 cm, but the CARD samples a
                    // clump of them, which is what this number describes.
                    size_m: 0.42,
                    // MEASURED by the CPU bake twin at 0.523 - already
                    // broadleaf-class, and higher than it looks like it
                    // should be for such an airy tree. Same reading as the
                    // birch above: coverage is how solid ONE card is, LAI is
                    // how many card-loads the crown carries. Bipinnate fronds
                    // pack densely within a clump and the clumps are far
                    // apart. High coverage at the lowest LAI here is the
                    // cheapest combination in the file - overdraw is
                    // LAI/coverage, so acacia pays 3.8 alpha-test layers
                    // against birch's 4.8 and oak's 7.8.
                    coverage: 0.52,
                    cards_per_sleeve: 4,
                    // 0.30 m against a broadleaf's 0.24: an acacia's foliage
                    // rides long horizontal fans, so its sleeves are strung
                    // out along the plate rather than bunched at twig tips.
                    sleeve_spacing_m: 0.30,
                    sprite_elements: 84,
                    sprite_runs: 1,
                ),
                // Inert (`blossom_frac: 0.0`), but real: acacia flowers as
                // small cream-white spherical puffs of stamens, ~1 cm.
                blossom: (
                    // 0.18, not 0.10. The bake measured the sprite at 0.166 m
                    // against a 0.100 m card - 1.66x, over the 1.5x fit gate.
                    // A puff cluster is simply bigger than one puff.
                    size_m: 0.18,
                    coverage: 0.18,
                    cards_per_sleeve: 3,
                    sleeve_spacing_m: 0.08,
                    sprite_elements: 6,
                    sprite_runs: 4,
                ),
                flower_size_m: 0.010,
                // 14, not 30. A real tortilis puff carries far more stamens
                // than that, but the bake measured 34,560 triangles for a
                // layer that never renders (blossom_frac 0.0) and whose
                // stamens are sub-texel at any card size. Count is not the
                // silhouette here; the round puff is.
                flowers_per_umbel: 14,
                umbel_spacing_m: 0.012,
                leaf_off_above_blossom_frac: 0.50,
                bloom_leaf_area_share: 0.06,
                // 0.35 - a little under the broadleaves' 0.45. The near-field
                // blade layer is parallax detail INSIDE the card mass, and an
                // acacia's card mass is a thin plate, so there is less depth
                // for it to be hidden in.
                near_blade_tri_frac: 0.35,
            )),
        ),
        // Wet-tropics palm.
        (
            id: "palm",
            display: "Palm",
            model: "",
            variants: 3,
            height_m: 12.0,
            height_jitter: 0.20,
            weight: 1.5,
            lat_min_deg: -24.0, lat_max_deg: 24.0,
            elev_min_m: 6.0, elev_max_m: 700.0,
            region_lat_deg: 0.0, region_lon_deg: 0.0, region_radius_km: 0.0,
            form: "palm",
            trunk_color: (0.13, 0.10, 0.068),
            leaf_color: (0.16, 0.36, 0.14),
            blossom_color: (0.0, 0.0, 0.0),
            blossom_frac: 0.0,
            // Height/diameter ratio, overriding the growth form default.
            // Coconut-class stem.
            slenderness: 34.0,
        ),
    ],
)
